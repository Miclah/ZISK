<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <config>
    <!--
      Refit 10.1.6's author signing certificate was revoked after the package was
      published. The package contents are unaffected and its hash still matches, but
      a restore against a clean cache fails with NU3012 on the revoked chain. This
      setting keeps `docker compose build` working on a machine that has never
      restored the package before. The CI workflow addresses the same problem with
      NUGET_CERT_REVOCATION_MODE=offline instead.

      Worth removing once Refit ships a release with a valid signature.
    -->
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
