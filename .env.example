# Copy this file to .env and fill in real values. .env itself is gitignored.

# SQL Server 'sa' password for the docker-compose 'db' service.
# Must satisfy SQL Server's complexity policy: 8+ chars, at least 3 of
# upper/lower/digit/symbol.
MSSQL_SA_PASSWORD=Your_password123!

# local | demo | production — see README.md "Demo accounts" section.
ZISK_SEED_MODE=local
