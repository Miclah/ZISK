# Copy this file to .env and fill in real values. .env itself is gitignored.

# Password for the SQL Server 'sa' account in the docker-compose 'db' service.
# SQL Server enforces its own complexity policy: 8+ characters, using at least 3
# of upper case, lower case, digits and symbols. A password that fails it makes
# the database container exit during startup.
MSSQL_SA_PASSWORD=

# local | demo | production. See DOCKER.md for what each mode changes.
ZISK_SEED_MODE=local

# Passwords for the four seeded role accounts. Only read when ZISK_SEED_MODE=demo;
# local mode uses the built-in development passwords instead. Leave blank to take
# the defaults from docker-compose.yml. They have to satisfy the app's Identity
# policy (8+ characters, a digit, a lower case and an upper case letter) or the
# app refuses to start.
SEED_ADMIN_PASSWORD=
SEED_COACH_PASSWORD=
SEED_PARENT_PASSWORD=
SEED_CHILD_PASSWORD=
