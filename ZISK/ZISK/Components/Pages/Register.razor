@page "/registracia"
@page "/Account/Register"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout ZISK.Components.Layout.LoginLayout

@using System.ComponentModel.DataAnnotations
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using ZISK.Data
@using ZISK.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject UsernameGenerator UsernameGenerator
@inject IParentInvitationService InvitationService
@* docasne zablokovanie emailu
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@inject RegistrationDraftService Drafts
*@

<PageTitle>Registrácia - ZISK</PageTitle>

<div class="register-page">
    <div class="register-card">
        <div class="register-brand">
            <h1>ZISK</h1>
            <p>Vytvorenie nového účtu</p>
        </div>

        @if (!string.IsNullOrEmpty(_globalError))
        {
            <div class="register-alert">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <span>@_globalError</span>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register" novalidate>
            <DataAnnotationsValidator />

            <div class="form-section-title">Osobné údaje</div>

            <div class="form-row">
                <div class="form-field">
                    <label for="firstName">Meno</label>
                    <InputText @bind-Value="Input.FirstName" id="firstName" autocomplete="given-name" placeholder="Janko" />
                    <ValidationMessage For="() => Input.FirstName" />
                </div>
                <div class="form-field">
                    <label for="lastName">Priezvisko</label>
                    <InputText @bind-Value="Input.LastName" id="lastName" autocomplete="family-name" placeholder="Hraško" />
                    <ValidationMessage For="() => Input.LastName" />
                </div>
            </div>

            <div class="form-field">
                <label for="email">E-mail</label>
                <InputText @bind-Value="Input.Email" id="email" type="email" autocomplete="email" placeholder="janko.hrasko@email.sk" />
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-field">
                <label for="phone">Telefón <span class="form-optional">(voliteľný)</span></label>
                <InputText @bind-Value="Input.PhoneNumber" id="phone" autocomplete="tel" placeholder="+421 9XX XXX XXX" />
                <ValidationMessage For="() => Input.PhoneNumber" />
            </div>

            <div class="form-field">
                <label>Dátum narodenia</label>
                <div class="dob-grid">
                    <InputNumber @bind-Value="Input.BirthDay" placeholder="Deň" aria-label="Deň" inputmode="numeric" />
                    <InputNumber @bind-Value="Input.BirthMonth" placeholder="Mesiac" aria-label="Mesiac" inputmode="numeric" />
                    <InputNumber @bind-Value="Input.BirthYear" placeholder="Rok" aria-label="Rok" inputmode="numeric" />
                </div>
                <small class="form-help">Formát: D / M / RRRR — napr. 15 / 6 / 1990.</small>
                @if (!string.IsNullOrEmpty(_dateError))
                {
                    <span class="validation-message">@_dateError</span>
                }
            </div>

            <div class="form-field">
                <label for="rodneCislo">Rodné číslo</label>
                <InputText @bind-Value="Input.RodneCislo" id="rodneCislo" placeholder="XXXXXX/XXXX" />
                <small class="form-help">Vyžadujeme ho pre fakturáciu a členskú evidenciu.</small>
                <ValidationMessage For="() => Input.RodneCislo" />
            </div>

            <div class="form-field">
                <label for="bydlisko">Bydlisko</label>
                <InputText @bind-Value="Input.Bydlisko" id="bydlisko" autocomplete="street-address" placeholder="Ulica, číslo, mesto, PSČ" />
                <ValidationMessage For="() => Input.Bydlisko" />
            </div>

            <div class="form-field">
                <label for="username">Používateľské meno</label>
                <InputText @bind-Value="Input.Username" id="username" autocomplete="username" placeholder="napr. jan.novak" />
                <small class="form-help">Ak ho nevyplníte, vygenerujeme ho z mena a priezviska.</small>
                <ValidationMessage For="() => Input.Username" />
            </div>

            <div class="form-section-title">Heslo</div>

            <div class="form-row">
                <div class="form-field">
                    <label for="password">Heslo</label>
                    <InputText type="password" @bind-Value="Input.Password" id="password" autocomplete="new-password" />
                    <small class="form-help">Min. 8 znakov, veľké aj malé písmeno, číslica.</small>
                    <ValidationMessage For="() => Input.Password" />
                </div>
                <div class="form-field">
                    <label for="confirmPassword">Potvrdenie hesla</label>
                    <InputText type="password" @bind-Value="Input.ConfirmPassword" id="confirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
            </div>

            <div class="form-section-title">Súhlasy</div>

            <div class="form-checkbox">
                <InputCheckbox @bind-Value="Input.GdprAccepted" id="gdpr" />
                <label for="gdpr">
                    Súhlasím so spracovaním osobných údajov
                    (<a href="/dokumenty/gdpr" target="_blank">GDPR</a>).
                </label>
            </div>
            <ValidationMessage For="() => Input.GdprAccepted" />

            <div class="form-checkbox">
                <InputCheckbox @bind-Value="Input.RulesAccepted" id="rules" />
                <label for="rules">
                    Súhlasím s <a href="/dokumenty/pravidla" target="_blank">pravidlami klubu</a>.
                </label>
            </div>
            <ValidationMessage For="() => Input.RulesAccepted" />

            <button type="submit" class="btn-register">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                Registrovať sa
            </button>
        </EditForm>

        <div class="register-footer">
            <a href="/login" class="footer-link">Späť na prihlásenie</a>
        </div>
    </div>

    <p class="register-copyright">© @DateTime.UtcNow.Year ZISK</p>
</div>

@code {
    private string? _globalError;
    private string? _dateError;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Invite { get; set; }

    private async Task RegisterUser()
    {
        _globalError = null;
        _dateError = null;

        if (Input.BirthDay is not { } day || Input.BirthMonth is not { } month || Input.BirthYear is not { } year)
        {
            _dateError = "Vyberte úplný dátum narodenia.";
            return;
        }

        var currentYear = DateTime.Today.Year;
        if (year < currentYear - 100 || year > currentYear)
        {
            _dateError = $"Rok narodenia musí byť medzi {currentYear - 100} a {currentYear}.";
            return;
        }
        if (month < 1 || month > 12)
        {
            _dateError = "Mesiac musí byť medzi 1 a 12.";
            return;
        }

        var maxDay = DateTime.DaysInMonth(year, month);
        if (day < 1 || day > maxDay)
        {
            _dateError = $"V tomto mesiaci ({month}/{year}) je maximálne {maxDay} dní.";
            return;
        }

        var dob = new DateTime(year, month, day);
        var maxDob = DateTime.Today.AddYears(-18);
        if (dob > maxDob)
        {
            _dateError = "Musíte mať aspoň 18 rokov.";
            return;
        }

        var email = Input.Email!.Trim();
        if (await UserManager.FindByEmailAsync(email) is not null)
        {
            _globalError = "Tento e-mail je už registrovaný.";
            return;
        }

        var phone = string.IsNullOrWhiteSpace(Input.PhoneNumber) ? null : Input.PhoneNumber.Trim();
        if (phone is not null && await UserManager.Users.AnyAsync(u => u.PhoneNumber == phone))
        {
            _globalError = "Toto telefónne číslo už používa iný účet.";
            return;
        }

        var rodneCislo = Input.RodneCislo!.Trim();
        if (await UserManager.Users.AnyAsync(u => u.RodneCislo == rodneCislo))
        {
            _globalError = "Toto rodné číslo už používa iný účet.";
            return;
        }

        var username = string.IsNullOrWhiteSpace(Input.Username)
            ? await UsernameGenerator.GenerateAsync(Input.FirstName!, Input.LastName!)
            : Input.Username.Trim();

        if (await UserManager.FindByNameAsync(username) is not null)
        {
            _globalError = "Toto používateľské meno je obsadené. Zvoľte iné.";
            return;
        }

        var user = new ApplicationUser
        {
            UserName = username,
            Email = email,
            FirstName = Input.FirstName!.Trim(),
            LastName = Input.LastName!.Trim(),
            PhoneNumber = phone,
            RodneCislo = rodneCislo,
            Bydlisko = Input.Bydlisko!.Trim(),
            DateOfBirth = DateOnly.FromDateTime(dob),
            EmailConfirmed = true,
            IsActive = true
        };

        var result = await UserManager.CreateAsync(user, Input.Password!);
        if (!result.Succeeded)
        {
            _globalError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        await UserManager.AddToRoleAsync(user, "Parent");
        Logger.LogInformation("Registered new user {UserId} ({Email})", user.Id, user.Email);

        // A parent invitation link for a not-yet-registered email carries its token as ?invite=...
        // (see InvitationsController.SendEmailInvitation) so the new account gets linked to the
        // child right away instead of leaving the invitation permanently unredeemable.
        if (!string.IsNullOrWhiteSpace(Invite))
        {
            var redeemResult = await InvitationService.RedeemEmailLinkAsync(Invite, user.Id);
            if (redeemResult.Status != InvitationRedeemStatus.Success)
                Logger.LogWarning("Post-registration invitation redemption failed for user {UserId}: {Status}", user.Id, redeemResult.Status);
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
        NavigationManager.NavigateTo(target, forceLoad: true);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Meno je povinné.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Meno musí mať 2 až 50 znakov.")]
        public string? FirstName { get; set; }

        [Required(ErrorMessage = "Priezvisko je povinné.")]
        [StringLength(50, MinimumLength = 2, ErrorMessage = "Priezvisko musí mať 2 až 50 znakov.")]
        public string? LastName { get; set; }

        [Required(ErrorMessage = "E-mail je povinný.")]
        [EmailAddress(ErrorMessage = "Neplatný formát e-mailu.")]
        public string? Email { get; set; }

        [Phone(ErrorMessage = "Neplatné telefónne číslo.")]
        public string? PhoneNumber { get; set; }

        public int? BirthDay { get; set; }
        public int? BirthMonth { get; set; }
        public int? BirthYear { get; set; }

        [Required(ErrorMessage = "Rodné číslo je povinné.")]
        [StringLength(11, MinimumLength = 9, ErrorMessage = "Rodné číslo musí mať 9 až 11 znakov.")]
        public string? RodneCislo { get; set; }

        [Required(ErrorMessage = "Bydlisko je povinné.")]
        [StringLength(200, MinimumLength = 5, ErrorMessage = "Zadajte úplnú adresu.")]
        public string? Bydlisko { get; set; }

        [StringLength(24, ErrorMessage = "Používateľské meno môže mať najviac 24 znakov.")]
        [RegularExpression(@"^$|^.{3,}$", ErrorMessage = "Používateľské meno musí mať aspoň 3 znaky.")]
        public string? Username { get; set; }

        [Required(ErrorMessage = "Heslo je povinné.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Heslo musí mať aspoň 8 znakov.")]
        [DataType(DataType.Password)]
        public string? Password { get; set; }

        [Required(ErrorMessage = "Potvrdenie hesla je povinné.")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Heslá sa nezhodujú.")]
        public string? ConfirmPassword { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "Musíte súhlasiť so spracovaním osobných údajov.")]
        public bool GdprAccepted { get; set; }

        [Range(typeof(bool), "true", "true", ErrorMessage = "Musíte súhlasiť s pravidlami klubu.")]
        public bool RulesAccepted { get; set; }
    }
}
