@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout ZISK.Components.Layout.LoginLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ZISK.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager

<PageTitle>Prihlásenie - ZISK</PageTitle>
<HeadContent>
    <meta name="description" content="ZISK - systém na správu športového klubu. Dochádzka, rozvrhy tréningov a komunikácia trénera s rodičmi." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@NavigationManager.Uri" />
    <meta property="og:title" content="ZISK - systém na správu športového klubu" />
    <meta property="og:description" content="Dochádzka, rozvrhy tréningov a komunikácia trénera s rodičmi." />
    <meta property="og:image" content="@($"{NavigationManager.BaseUri}og-image.png")" />
</HeadContent>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <h1>ZISK</h1>
            <p>Žiarský Informačný Systém pre Kluby</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="login-alert">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <span>@errorMessage</span>
            </div>
        }

        @if (_showResendLink)
        {
            <div class="login-alert login-alert-info">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                <span>
                    Neprišiel vám email?
                    <a href="@($"/overenie/znovu?Email={Uri.EscapeDataString(_unconfirmedEmail ?? "")}")"
                       style="color: #1565c0; font-weight: 600;">Odoslať znovu</a>
                </span>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="email">E-mail alebo používateľské meno</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    <InputText @bind-Value="Input.EmailOrUsername"
                               id="email"
                               placeholder="Váš email alebo prihlasovacie meno"
                               autocomplete="username" />
                </div>
                <ValidationMessage For="() => Input.EmailOrUsername" />
            </div>

            <div class="form-field">
                <label for="password">Heslo</label>
                <div class="input-wrapper has-toggle">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    <InputText type="password"
                               @bind-Value="Input.Password"
                               id="password"
                               placeholder="Vaše heslo"
                               autocomplete="current-password" />
                    <button type="button" class="pwd-toggle" aria-label="Zobraziť/skryť heslo"
                            onclick="(function(b){var i=document.getElementById('password');var s=i.type==='password';i.type=s?'text':'password';b.querySelector('.eye-on').style.display=s?'none':'block';b.querySelector('.eye-off').style.display=s?'block':'none';})(this)">
                        <svg class="eye-on" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                        <svg class="eye-off" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" style="display:none;"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46A11.804 11.804 0 001 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
                    </button>
                </div>
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="form-checkbox">
                <InputCheckbox @bind-Value="Input.RememberMe" id="remember" />
                <label for="remember">Zapamätať prihlásenie</label>
            </div>

            <button type="submit" class="btn-login">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/></svg>
                Prihlásiť sa
            </button>
        </EditForm>

        <div class="login-footer">
            <a href="/registracia" class="register-link">
                Vytvoriť nový účet
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </a>
        </div>
    </div>

    <p class="login-copyright">© 2026 ZISK</p>
</div>

@code {
    private string? errorMessage;
    private bool _showResendLink;
    private string? _unconfirmedEmail;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (HttpContext.User.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo(GetSafeRedirectUrl(), forceLoad: true);
                return;
            }
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        _showResendLink = false;
        _unconfirmedEmail = null;

        var identifier = Input.EmailOrUsername?.Trim() ?? string.Empty;

        var user = await UserManager.FindByNameAsync(identifier)
                ?? await UserManager.FindByEmailAsync(identifier);

        if (user is null)
        {
            errorMessage = "Nesprávne prihlasovacie údaje.";
            return;
        }

        if (!user.IsActive)
        {
            Logger.LogWarning("Inactive user {UserId} attempted to log in.", user.Id);
            errorMessage = "Váš účet bol deaktivovaný. Kontaktujte administrátora.";
            return;
        }

        var passwordOk = await UserManager.CheckPasswordAsync(user, Input.Password);
        if (!passwordOk)
        {
            errorMessage = "Nesprávne prihlasovacie údaje.";
            return;
        }

        if (!user.EmailConfirmed)
        {
            Logger.LogInformation("Login blocked for unconfirmed user {UserId}.", user.Id);
            _showResendLink = true;
            _unconfirmedEmail = user.Email;
            errorMessage = "Váš e-mail ešte nie je overený.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(user.UserName!, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {UserId} logged in successfully.", user.Id);
            NavigationManager.NavigateTo(GetSafeRedirectUrl(), forceLoad: true);
            return;
        }

        if (result.IsLockedOut)
        {
            Logger.LogWarning("User account {UserId} locked out.", user.Id);
            errorMessage = "Váš účet je dočasne uzamknutý.";
            return;
        }

        errorMessage = "Nesprávne prihlasovacie údaje.";
    }

    private string GetSafeRedirectUrl()
    {
        if (string.IsNullOrEmpty(ReturnUrl)) return "/";
        var decodedUrl = Uri.UnescapeDataString(ReturnUrl);
        if (Uri.IsWellFormedUriString(decodedUrl, UriKind.Absolute))
        {
            try
            {
                var uri = new Uri(decodedUrl);
                var currentUri = new Uri(NavigationManager.BaseUri);
                if (uri.Host != currentUri.Host) return "/";
            }
            catch { return "/"; }
        }
        return decodedUrl;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Zadajte e-mail alebo používateľské meno.")]
        public string EmailOrUsername { get; set; } = "";

        [Required(ErrorMessage = "Heslo je povinné")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}