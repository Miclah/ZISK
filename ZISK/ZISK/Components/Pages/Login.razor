@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout ZISK.Components.Layout.LoginLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ZISK.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager

<PageTitle>Prihlásenie - ZISK</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <h1>ZISK</h1>
            <p>Žiarský Informačný Systém pre Kluby</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="login-alert">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <span>@errorMessage</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="login-alert login-alert-success">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                <span>@successMessage</span>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="email">Email</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                    <InputText @bind-Value="Input.Email"
                               id="email"
                               placeholder="vas@email.sk"
                               autocomplete="username" />
                </div>
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-field">
                <label for="password">Heslo</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    <InputText type="password"
                               @bind-Value="Input.Password"
                               id="password"
                               placeholder="Vaše heslo"
                               autocomplete="current-password" />
                </div>
                <ValidationMessage For="() => Input.Password" />
            </div>

            <div class="form-checkbox">
                <InputCheckbox @bind-Value="Input.RememberMe" id="remember" />
                <label for="remember">Zapamätať prihlásenie</label>
            </div>

            <button type="submit" class="btn-login">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M11 7L9.6 8.4l2.6 2.6H2v2h10.2l-2.6 2.6L11 17l5-5-5-5zm9 12h-8v2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-8v2h8v14z"/></svg>
                Prihlásiť sa
            </button>
        </EditForm>

        <div class="login-footer">
            <a href="/registracia" class="register-link">
                Vytvoriť nový účet
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </a>
        </div>
    </div>

    <p class="login-copyright">© 2026 ZISK</p>
</div>

@code {
    private string? errorMessage;
    private string? successMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            if (HttpContext.User.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo(GetSafeRedirectUrl(), forceLoad: true);
                return;
            }
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {

        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user == null)
        {
            errorMessage = "Neplatný email alebo heslo.";
            return;
        }

        if (!user.IsActive)
        {
            Logger.LogWarning("Inactive user {Email} attempted to log in.", Input.Email);
            errorMessage = "Váš účet bol deaktivovaný. Kontaktujte administrátora.";
            return;
        }

        if (!user.EmailConfirmed)
        {
            errorMessage = "Váš email ešte nebol potvrdený. Skontrolujte svoju emailovú schránku.";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Logger.LogInformation("User {Email} logged in successfully.", Input.Email);
            NavigationManager.NavigateTo(GetSafeRedirectUrl(), forceLoad: true);
            return;
        }

        if (result.IsLockedOut)
        {
            Logger.LogWarning("User account {Email} locked out.", Input.Email);
            errorMessage = "Váš účet je dočasne uzamknutý.";
            return;
        }

        errorMessage = "Neplatný email alebo heslo.";
    }

    private string GetSafeRedirectUrl()
    {
        if (string.IsNullOrEmpty(ReturnUrl)) return "/";
        var decodedUrl = Uri.UnescapeDataString(ReturnUrl);
        if (Uri.IsWellFormedUriString(decodedUrl, UriKind.Absolute))
        {
            try
            {
                var uri = new Uri(decodedUrl);
                var currentUri = new Uri(NavigationManager.BaseUri);
                if (uri.Host != currentUri.Host) return "/";
            }
            catch { return "/"; }
        }
        return decodedUrl;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email je povinný")]
        [EmailAddress(ErrorMessage = "Neplatný formát emailu")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Heslo je povinné")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}