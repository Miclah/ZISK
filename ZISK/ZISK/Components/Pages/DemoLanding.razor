@page "/demo"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout ZISK.Components.Layout.LoginLayout
@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using ZISK.Data
@using ZISK.Services
@using ZISK.Services.Demo
@using ZISK.Shared.Localization

@inject IConfiguration Configuration
@inject SignInManager<ApplicationUser> SignInManager
@inject IDemoSessionService DemoSessions
@inject NavigationManager NavigationManager
@inject ILogger<DemoLanding> Logger

<PageTitle>@T("demo.title")</PageTitle>

<div class="demo-page">
    <main class="demo-panel">
        @* The top strip is the app's own app bar, reproduced: same navy gradient, same wordmark
           treatment, the same orange DEMO chip, and the language switch in the same corner. It is
           the one element a visitor sees on both sides of the sign-in, so it carries the "this is
           the same product" signal that a shared colour palette alone doesn't. *@
        <div class="demo-bar">
            <span class="demo-wordmark">ZISK</span>
            <span class="demo-badge">DEMO</span>

            @* data-enhance-nav="false" is required: blazor.webassembly.js is loaded for every
               page in App.razor, so its enhanced navigation intercepts these links even though
               this page is static SSR ([ExcludeFromInteractiveRouting]). The intercepted click
               never reaches the server, so ?lang= is never read and the switch appears dead.
               Opting out forces a real navigation. *@
            <nav class="demo-lang" aria-label="Language">
                <a href="/demo?lang=sk" data-enhance-nav="false"
                   class="@(_lang == Lang.Sk ? "is-active" : "")"
                   aria-current="@(_lang == Lang.Sk ? "true" : null)">SK</a>
                <a href="/demo?lang=en" data-enhance-nav="false"
                   class="@(_lang == Lang.En ? "is-active" : "")"
                   aria-current="@(_lang == Lang.En ? "true" : null)">EN</a>
            </nav>
        </div>

        <div class="demo-body">
        <header class="demo-head">
            <h1 class="demo-tagline">@T("demo.tagline")</h1>
            <p class="demo-lead">@T("demo.intro")</p>
        </header>

        @if (_errorMessage is not null)
        {
            <p class="demo-alert" role="alert">@_errorMessage</p>
        }

        @* No <AntiforgeryToken /> here on purpose. EditForm already renders one during static
           SSR; adding a second emits two identical __RequestVerificationToken inputs, the browser
           posts the field twice, and ASP.NET Core reads that multi-value field as a single
           malformed token - the request then fails with "A valid antiforgery token was not
           provided with the request." *@
        @* Real submit buttons, not clickable divs: they are reachable by Tab, activate on Enter
           and Space, and a screen reader announces the aria-label as the action. The trailing
           arrow is decorative only - it exists so the card looks like it leads somewhere. *@
        <EditForm Model="_input" FormName="demo-try" OnSubmit="HandleSubmitAsync" class="demo-roles">
            <button type="submit" name="Role" value="Admin" class="demo-role"
                    aria-label="@T("demo.role.admin.button")">
                <span class="demo-role-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.AdminPanelSettings" Size="Size.Medium" Color="Color.Inherit" />
                </span>
                <span class="demo-role-text">
                    <span class="demo-role-name">@T("demo.role.admin.title")</span>
                    <span class="demo-role-desc">@T("demo.role.admin.desc")</span>
                </span>
                <span class="demo-role-go" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Color="Color.Inherit" />
                </span>
            </button>

            <button type="submit" name="Role" value="Coach" class="demo-role"
                    aria-label="@T("demo.role.coach.button")">
                <span class="demo-role-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.Groups" Size="Size.Medium" Color="Color.Inherit" />
                </span>
                <span class="demo-role-text">
                    <span class="demo-role-name">@T("demo.role.coach.title")</span>
                    <span class="demo-role-desc">@T("demo.role.coach.desc")</span>
                </span>
                <span class="demo-role-go" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Color="Color.Inherit" />
                </span>
            </button>

            <button type="submit" name="Role" value="Parent" class="demo-role"
                    aria-label="@T("demo.role.parent.button")">
                <span class="demo-role-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.FamilyRestroom" Size="Size.Medium" Color="Color.Inherit" />
                </span>
                <span class="demo-role-text">
                    <span class="demo-role-name">@T("demo.role.parent.title")</span>
                    <span class="demo-role-desc">@T("demo.role.parent.desc")</span>
                </span>
                <span class="demo-role-go" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Color="Color.Inherit" />
                </span>
            </button>

            <button type="submit" name="Role" value="Child" class="demo-role"
                    aria-label="@T("demo.role.child.button")">
                <span class="demo-role-icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.DirectionsRun" Size="Size.Medium" Color="Color.Inherit" />
                </span>
                <span class="demo-role-text">
                    <span class="demo-role-name">@T("demo.role.child.title")</span>
                    <span class="demo-role-desc">@T("demo.role.child.desc")</span>
                </span>
                <span class="demo-role-go" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" Color="Color.Inherit" />
                </span>
            </button>
        </EditForm>

        <footer class="demo-footer">
            <p class="demo-note">@T("demo.footerNote")</p>
            <div class="demo-meta">
                <span class="demo-author">@T("demo.builtBy")</span>
                <span class="demo-dot" aria-hidden="true"></span>
                <a href="@SourceUrl" target="_blank" rel="noopener noreferrer">@T("demo.sourceLink")</a>
                @* The stack list is what a reviewing developer scans for first, so it is spelled
                   out rather than hidden behind the GitHub link, and it gets its own line. Not
                   localized: these are product names, identical in both languages. *@
                <span class="demo-stack">.NET 10 · Blazor WASM · EF Core · Azure</span>
            </div>
        </footer>
        </div>
    </main>
</div>

@code {
    private const string SourceUrl = "https://github.com/Miclah/ZISK";

    private readonly object _input = new();
    private string? _errorMessage;
    private Lang _lang = Lang.En;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(Name = "Role")]
    private string? SelectedRole { get; set; }

    [SupplyParameterFromQuery(Name = "lang")]
    private string? LangQuery { get; set; }

    private bool IsDemoMode => SeedModeResolver.Resolve(Configuration) == SeedMode.Demo;

    private string T(string key) => Translations.Get(_lang, key);

    protected override async Task OnInitializedAsync()
    {
        if (!IsDemoMode)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
            return;
        }

        ResolveLanguage();

        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/", forceLoad: true);
        }

        // POST handling happens via the EditForm's OnSubmit binding below, not here - same
        // division of responsibility as Login.razor's OnInitializedAsync/LoginUser split.
    }

    /// <summary>
    /// This is a Static SSR page (no WASM, no JS interop), so it can't use the client-side
    /// ILanguageService - it reads/writes the same zisk_lang cookie directly instead, which
    /// keeps a visitor's language choice consistent whether they're on this page or in the
    /// interactive app (see LanguageService.cs on the client side for the other end of this).
    /// </summary>
    private void ResolveLanguage()
    {
        if (LangQuery is "en" or "sk")
        {
            _lang = LangQuery == "en" ? Lang.En : Lang.Sk;
            HttpContext.Response.Cookies.Append("zisk_lang", LangQuery, new CookieOptions
            {
                Secure = HttpContext.Request.IsHttps,
                SameSite = SameSiteMode.Lax,
                Expires = DateTimeOffset.UtcNow.AddDays(30)
            });
            return;
        }

        if (HttpContext.Request.Cookies.TryGetValue("zisk_lang", out var cookieLang) && cookieLang == "sk")
            _lang = Lang.Sk;
    }

    private async Task HandleSubmitAsync()
    {
        var role = SelectedRole;
        if (string.IsNullOrEmpty(role))
            return;

        ApplicationUser? user;
        Guid sessionId;
        try
        {
            var cookieSessionId = ReadSessionCookie();
            sessionId = await DemoSessions.EnsureSessionAsync(cookieSessionId, role);
            WriteSessionCookie(sessionId);

            user = await DemoSessions.GetUserForRoleAsync(sessionId, role);
        }
        catch (Exception ex)
        {
            // NavigateTo below throws NavigationException by design (it's how server-rendered
            // Blazor unwinds to perform the redirect) - that must propagate, not be swallowed
            // here as if it were a real failure. Keeping the try/catch scoped to just the
            // session/DB work (and calling NavigateTo outside it entirely) avoids the trap.
            Logger.LogError(ex, "Failed to start demo session for role {Role}", role);
            _errorMessage = T("demo.error.prepareFailed");
            return;
        }

        if (user is null)
        {
            Logger.LogWarning("Demo session {SessionId} has no cloned user for role {Role}", sessionId, role);
            _errorMessage = T("demo.error.roleNotFound");
            return;
        }

        await SignInManager.SignInWithClaimsAsync(user, isPersistent: true,
            additionalClaims: [new Claim(DemoSessionContext.ClaimType, sessionId.ToString())]);

        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private Guid? ReadSessionCookie() =>
        HttpContext.Request.Cookies.TryGetValue(DemoSessionContext.CookieName, out var raw) && Guid.TryParse(raw, out var id)
            ? id
            : null;

    private void WriteSessionCookie(Guid sessionId) =>
        HttpContext.Response.Cookies.Append(DemoSessionContext.CookieName, sessionId.ToString(), new CookieOptions
        {
            HttpOnly = true,
            Secure = HttpContext.Request.IsHttps,
            SameSite = SameSiteMode.Lax,
            Expires = DateTimeOffset.UtcNow.AddDays(30)
        });
}
