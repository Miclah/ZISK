@page "/Account/ResetPassword"

@attribute [AllowAnonymous]

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ZISK.Data

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Obnovenie hesla – ZISK</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-brand">
            <h1>ZISK</h1>
            <p>Nastavenie nového hesla</p>
        </div>

        @if (identityErrors is not null)
        {
            <div class="login-alert">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <span>@string.Join(", ", identityErrors.Select(e => e.Description))</span>
            </div>
        }

        <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <input type="hidden" name="Input.Code" value="@Input.Code" />

            <div class="form-field">
                <label for="Input.Password">Nové heslo</label>
                <div class="input-wrapper" style="position: relative;">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    <InputText id="Input.Password" @bind-Value="Input.Password" type="password" autocomplete="new-password" aria-required="true" placeholder="Nové heslo (min. 8 znakov)" />
                    <button type="button" class="pwd-toggle" onclick="togglePwd('Input.Password', this)" aria-label="Zobraziť heslo" tabindex="-1">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    </button>
                </div>
                <ValidationMessage For="() => Input.Password" />
                <div id="pwd-strength" class="pwd-strength-bar mt-1" aria-hidden="true">
                    <div class="pwd-strength-track"><div class="pwd-strength-fill" id="pwd-strength-fill"></div></div>
                    <span class="pwd-strength-label" id="pwd-strength-label"></span>
                </div>
            </div>

            <div class="form-field">
                <label for="Input.ConfirmPassword">Potvrdenie hesla</label>
                <div class="input-wrapper" style="position: relative;">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    <InputText id="Input.ConfirmPassword" @bind-Value="Input.ConfirmPassword" type="password" autocomplete="new-password" aria-required="true" placeholder="Zopakujte heslo" />
                    <button type="button" class="pwd-toggle" onclick="togglePwd('Input.ConfirmPassword', this)" aria-label="Zobraziť heslo" tabindex="-1">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    </button>
                </div>
                <ValidationMessage For="() => Input.ConfirmPassword" />
            </div>

            <button type="submit" class="btn-login">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Nastaviť heslo
            </button>
        </EditForm>

        <div class="login-footer">
            <a href="Account/Login" class="footer-link">Späť na prihlásenie</a>
        </div>
    </div>

    <p class="login-copyright">© 2026 ZISK</p>
</div>

<style>
    .pwd-toggle {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        background: none; border: none; cursor: pointer; color: #64748b; padding: 4px;
        display: flex; align-items: center;
    }
    .pwd-toggle:hover { color: #1e293b; }
    .pwd-strength-bar { display: flex; align-items: center; gap: 8px; }
    .pwd-strength-track { flex: 1; height: 5px; background: #e2e8f0; border-radius: 3px; overflow: hidden; }
    .pwd-strength-fill { height: 100%; width: 0; border-radius: 3px; transition: width .3s, background .3s; }
    .pwd-strength-label { font-size: 12px; min-width: 60px; }
</style>

<script>
    function togglePwd(id, btn) {
        var inp = document.getElementById(id);
        if (!inp) return;
        var show = inp.type === 'password';
        inp.type = show ? 'text' : 'password';
        btn.title = show ? 'Skryť heslo' : 'Zobraziť heslo';
    }

    (function () {
        function pwdStrength(p) {
            if (!p) return { score: 0, label: '', color: '#e2e8f0' };
            var s = 0;
            if (p.length >= 8) s++;
            if (/[A-Z]/.test(p) && /[a-z]/.test(p) && /\d/.test(p)) s++;
            if (/[^A-Za-z0-9]/.test(p)) s++;
            if (p.length >= 12) s++;
            var map = [
                { label: 'Slabé',      color: '#ef4444', pct: 25 },
                { label: 'Slabé',      color: '#ef4444', pct: 25 },
                { label: 'Priemerné', color: '#D97706', pct: 50 },
                { label: 'Dobré',      color: '#eab308', pct: 75 },
                { label: 'Silné',      color: '#22c55e', pct: 100 },
            ];
            return { score: s, label: map[s].label, color: map[s].color, pct: map[s].pct };
        }

        function init() {
            var inp = document.getElementById('Input.Password');
            var fill = document.getElementById('pwd-strength-fill');
            var lbl  = document.getElementById('pwd-strength-label');
            if (!inp || !fill || !lbl) return;
            inp.addEventListener('input', function () {
                var r = pwdStrength(inp.value);
                fill.style.width = (inp.value ? r.pct : 0) + '%';
                fill.style.background = r.color;
                lbl.textContent = inp.value ? r.label : '';
                lbl.style.color = r.color;
            });
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    })();
</script>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    protected override void OnInitialized()
    {
        if (Code is null || UserId is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
            return;
        }

        Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
    }

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByIdAsync(UserId!);
        if (user is null)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        identityErrors = result.Errors;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Heslo je povinné")]
        [StringLength(100, ErrorMessage = "Heslo musí mať aspoň {2} a najviac {1} znakov.", MinimumLength = 8)]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Heslo musí obsahovať malé písmeno, veľké písmeno a číslicu.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "Heslá sa nezhodujú.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";
    }
}
