@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Osobné údaje</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4" Style="font-weight: 700;">Osobné údaje</MudText>

<StatusMessage />

<MudStack Spacing="3" Style="max-width:560px;">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        Váš účet obsahuje osobné údaje, ktoré ste nám poskytli. Tu si ich môžete stiahnuť alebo trvalo odstrániť.
        <br /><br />
        <strong>Odstránenie údajov natrvalo zruší váš účet — túto akciu nemožno vrátiť späť.</strong>
    </MudAlert>

    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
        <form action="Account/Manage/DownloadPersonalData" method="post" style="margin:0;">
            <AntiforgeryToken />
            <MudStaticButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined"
                             Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Download">
                Stiahnuť údaje
            </MudStaticButton>
        </form>

        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Rounded.DeleteForever"
                   Href="Account/Manage/DeletePersonalData">
            Odstrániť účet
        </MudButton>
    </MudStack>
</MudStack>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
