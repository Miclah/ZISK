@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Osobné údaje</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700; color: #3730A3;">Osobné údaje</MudText>

<StatusMessage />

<div class="row">
    <div class="col-md-8 col-lg-6">
        <MudAlert Severity="Severity.Warning" Class="mb-4" Style="border-radius: 8px;">
            Váš účet obsahuje osobné údaje, ktoré ste nám poskytli. Táto stránka vám umožňuje stiahnuť si tieto údaje alebo ich odstrániť.<br/><br/>
            <strong>Odstránenie týchto údajov natrvalo odstráni váš účet, čo nemožno vrátiť späť.</strong>
        </MudAlert>

        <MudStack Row="true" Spacing="3">
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken />
                <button class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium" style="color: #F97316; border-color: #F97316; font-weight: 600; text-transform: none; border-radius: 8px;" type="submit">Stiahnuť údaje</button>
            </form>

            <a href="Account/Manage/DeletePersonalData" class="mud-button-root mud-button mud-button-filled mud-button-filled-error mud-button-filled-size-medium" style="font-weight: 600; text-transform: none; border-radius: 8px;">Odstrániť účet</a>
        </MudStack>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }
}
