@page "/Account/Manage/Email"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ZISK.Data
@using ZISK.Services

@inject UserManager<ApplicationUser> UserManager
@inject SmtpEmailSender EmailSender
@inject IdentityUserAccessor UserAccessor
@inject NavigationManager NavigationManager

<PageTitle>Spravovať email</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700; color: #3730A3;">Zdrojový email</MudText>

<StatusMessage Message="@message"/>
<div class="row">
    <div class="col-md-8 col-lg-6">
        <form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form" method="post">
            <AntiforgeryToken />
        </form>
        <EditForm Model="Input" FormName="change-email" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" role="alert" />

            @if (isEmailConfirmed)
            {
                <div class="form-floating mb-4 position-relative">
                    <input type="text" value="@email" id="email" class="form-control" placeholder="Email" disabled style="background-color: #F8FAFC; border-color: #E2E8F0; padding-right: 2.5rem;" />
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Style="position: absolute; right: 1rem; top: 1.25rem;" />
                    <label for="email" class="form-label" style="color: #64748B;">Aktuálny email</label>
                </div>
            }
            else
            {
                <div class="form-floating mb-4">
                    <input type="text" value="@email" id="email" class="form-control" placeholder="Email" disabled style="background-color: #F8FAFC; border-color: #E2E8F0;" />
                    <label for="email" class="form-label" style="color: #64748B;">Aktuálny email (Neoverený)</label>
                    <button type="submit" class="mud-button-root mud-button mud-button-text mud-button-text-primary mt-2" form="send-verification-form" style="text-transform: none;">Odoslať overovací email</button>
                </div>
            }

            <div class="form-floating mb-4">
                <InputText @bind-Value="Input.NewEmail" id="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Nový email" style="border-color: #E2E8F0;" />
                <label for="Input.NewEmail" class="form-label" style="color: #64748B;">Nová e-mailová adresa</label>
                <ValidationMessage For="() => Input.NewEmail" class="text-danger" />
            </div>

            <button type="submit" class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-large mud-width-full" style="background-color: #F97316; color: white; font-weight: 600; text-transform: none; border-radius: 8px;">Zmeniť e-mail</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private string? email;
    private bool isEmailConfirmed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel? _input;

    [SupplyParameterFromForm(FormName = "change-email")]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        email = await UserManager.GetEmailAsync(user);
        isEmailConfirmed = await UserManager.IsEmailConfirmedAsync(user);

        Input.NewEmail ??= email;
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.NewEmail is null || Input.NewEmail == email)
        {
            message = "E-mail je nezmenený.";
            return;
        }

        var existing = await UserManager.FindByEmailAsync(Input.NewEmail);
        if (existing is not null && existing.Id != user.Id)
        {
            message = "Tento e-mail je už obsadený.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateChangeEmailTokenAsync(user, Input.NewEmail);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmailChange").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["email"] = Input.NewEmail, ["code"] = code });

        await EmailSender.SendEmailChangeLinkAsync(user, Input.NewEmail, HtmlEncoder.Default.Encode(callbackUrl));

        message = "Potvrdzovací odkaz na zmenu e-mailu bol odoslaný. Skontrolujte svoju schránku.";
    }

    private async Task OnSendEmailVerificationAsync()
    {
        if (email is null)
        {
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

        await EmailSender.SendConfirmationLinkAsync(user, email, HtmlEncoder.Default.Encode(callbackUrl));

        message = "Overovací email bol odoslaný. Skontrolujte svoju schránku.";
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        [Display(Name = "New email")]
        public string? NewEmail { get; set; }
    }
}
