@page "/Account/Manage/Email"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ZISK.Data
@using ZISK.Services

@inject UserManager<ApplicationUser> UserManager
@inject SmtpEmailSender EmailSender
@inject IdentityUserAccessor UserAccessor
@inject NavigationManager NavigationManager

<PageTitle>Spravovať email</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Primary" Class="mb-4" Style="font-weight: 700;">Zmena emailu</MudText>

<StatusMessage Message="@message" />

<form @onsubmit="OnSendEmailVerificationAsync" @formname="send-verification" id="send-verification-form" method="post">
    <AntiforgeryToken />
</form>

<EditForm Model="Input" FormName="change-email" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />

    <MudStack Spacing="3" Style="max-width:520px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudStaticTextField Value="@(email ?? string.Empty)"
                                Label="@(isEmailConfirmed ? "Aktuálny email" : "Aktuálny email (neoverený)")"
                                Variant="Variant.Outlined" Disabled="true" Class="flex-grow-1" />
            @if (isEmailConfirmed)
            {
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" Title="Overený" />
            }
        </MudStack>

        @if (!isEmailConfirmed)
        {
            <MudButton ButtonType="ButtonType.Submit" Form="send-verification-form"
                       Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.MarkEmailRead">
                Odoslať overovací email
            </MudButton>
        }

        <MudStaticTextField Value="@Input.NewEmail" For="@(() => Input.NewEmail)"
                            Label="Nová emailová adresa" Variant="Variant.Outlined"
                            Placeholder="novy@email.sk" InputType="InputType.Email" />

        <MudStaticButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                         Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Email">
            Zmeniť email
        </MudStaticButton>
    </MudStack>
</EditForm>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private string? email;
    private bool isEmailConfirmed;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel? _input;

    [SupplyParameterFromForm(FormName = "change-email")]
    private InputModel Input
    {
        get => _input ??= new(); // lazy init — Blazor SSR sends GET (empty form) and POST (filled form) through the same component
        set => _input = value;
    }

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        email = await UserManager.GetEmailAsync(user);
        isEmailConfirmed = await UserManager.IsEmailConfirmedAsync(user);

        Input.NewEmail ??= email;
    }

    private async Task OnValidSubmitAsync()
    {
        if (Input.NewEmail is null || Input.NewEmail == email)
        {
            message = "Email je nezmenený.";
            return;
        }

        // Identity does not check for duplicate emails during GenerateChangeEmailTokenAsync, so we do it manually here.
        var existing = await UserManager.FindByEmailAsync(Input.NewEmail);
        if (existing is not null && existing.Id != user.Id)
        {
            message = "Tento email je už obsadený.";
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateChangeEmailTokenAsync(user, Input.NewEmail);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code)); // token contains special characters; Base64Url encoding is required by the Identity email change flow
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmailChange").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["email"] = Input.NewEmail, ["code"] = code });

        await EmailSender.SendEmailChangeLinkAsync(user, Input.NewEmail, HtmlEncoder.Default.Encode(callbackUrl));

        message = "Potvrdzovací odkaz na zmenu emailu bol odoslaný. Skontrolujte svoju schránku.";
    }

    private async Task OnSendEmailVerificationAsync()
    {
        if (email is null) return;

        var userId = await UserManager.GetUserIdAsync(user);
        var code = await UserManager.GenerateEmailConfirmationTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,
            new Dictionary<string, object?> { ["userId"] = userId, ["code"] = code });

        await EmailSender.SendConfirmationLinkAsync(user, email, HtmlEncoder.Default.Encode(callbackUrl));

        message = "Overovací email bol odoslaný. Skontrolujte svoju schránku.";
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Email je povinný.")]
        [EmailAddress(ErrorMessage = "Neplatný formát emailu.")]
        [Display(Name = "Nový email")]
        public string? NewEmail { get; set; }
    }
}
