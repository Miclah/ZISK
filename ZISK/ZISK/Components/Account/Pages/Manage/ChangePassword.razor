@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ZISK.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Zmeniť heslo - ZISK</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Color="Color.Primary" Class="mb-4" Style="font-weight: 700;">Zmena hesla</MudText>

<StatusMessage Message="@message" />

<EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
    <DataAnnotationsValidator />

    <MudStack Spacing="3" Style="max-width:520px;">
        <MudTextField Value="@Input.OldPassword" For="@(() => Input.OldPassword)"
                            Label="Staré heslo" Variant="Variant.Outlined"
                            InputType="InputType.Password"
                            UserAttributes="@(new Dictionary<string, object> { ["name"] = "Input.OldPassword" })" />

        <MudTextField Value="@Input.NewPassword" For="@(() => Input.NewPassword)"
                            Label="Nové heslo" Variant="Variant.Outlined"
                            InputType="InputType.Password"
                            HelperText="Minimálne 8 znakov, malé a veľké písmeno, číslica."
                            UserAttributes="@(new Dictionary<string, object> { ["name"] = "Input.NewPassword" })" />

        <MudTextField Value="@Input.ConfirmPassword" For="@(() => Input.ConfirmPassword)"
                            Label="Potvrďte nové heslo" Variant="Variant.Outlined"
                            InputType="InputType.Password"
                            UserAttributes="@(new Dictionary<string, object> { ["name"] = "Input.ConfirmPassword" })" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                         Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Lock">
            Aktualizovať heslo
        </MudButton>
    </MudStack>
</EditForm>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            // External login users (e.g. Google) have no password — redirect them to SetPassword first.
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Chyba: {string.Join(", ", changePasswordResult.Errors.Select(e => TranslateError(e.Code)))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user); // refreshes the security stamp in the cookie; without this the old session would remain valid
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectToCurrentPageWithStatus("Heslo bolo úspešne zmenené.", HttpContext);
    }

    // Identity returns English error codes; this switch translates them to Slovak.
    // Unknown codes fall through to _ => code (returns the original English string) so nothing is silently swallowed if Identity adds new codes.
    private static string TranslateError(string code) => code switch
    {
        "PasswordMismatch" => "Nesprávne staré heslo.",
        "PasswordTooShort" => "Heslo je príliš krátke.",
        "PasswordRequiresDigit" => "Heslo musí obsahovať číslicu.",
        "PasswordRequiresUpper" => "Heslo musí obsahovať veľké písmeno.",
        "PasswordRequiresLower" => "Heslo musí obsahovať malé písmeno.",
        "PasswordRequiresNonAlphanumeric" => "Heslo musí obsahovať špeciálny znak.",
        _ => code
    };

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Staré heslo je povinné.")]
        [DataType(DataType.Password)]
        [Display(Name = "Staré heslo")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Nové heslo je povinné.")]
        [StringLength(100, ErrorMessage = "Heslo musí mať aspoň {2} a najviac {1} znakov.", MinimumLength = 8)]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Heslo musí obsahovať malé písmeno, veľké písmeno a číslicu.")]
        [DataType(DataType.Password)]
        [Display(Name = "Nové heslo")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Potvrdenie nového hesla")]
        [Compare("NewPassword", ErrorMessage = "Heslá sa nezhodujú.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
