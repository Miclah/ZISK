@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ZISK.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger

<PageTitle>Zmeniť heslo</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700; color: #3730A3;">Zmena hesla</MudText>

<StatusMessage Message="@message" />

<div class="row">
    <div class="col-md-8 col-lg-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger mb-3" role="alert" />

            <div class="form-floating mb-4" style="position: relative;">
                <InputText id="Input.OldPassword" @bind-Value="Input.OldPassword" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Staré heslo" style="border-color: #E2E8F0; padding-right: 3rem;" />
                <label for="Input.OldPassword" class="form-label" style="color: #64748B;">Staré heslo</label>
                <button type="button" class="pwd-toggle-manage" onclick="togglePwd('Input.OldPassword', this)" aria-label="Zobraziť heslo" tabindex="-1">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                </button>
                <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
            </div>

            <div class="form-floating mb-2" style="position: relative;">
                <InputText id="Input.NewPassword" @bind-Value="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nové heslo" style="border-color: #E2E8F0; padding-right: 3rem;" />
                <label for="Input.NewPassword" class="form-label" style="color: #64748B;">Nové heslo</label>
                <button type="button" class="pwd-toggle-manage" onclick="togglePwd('Input.NewPassword', this)" aria-label="Zobraziť heslo" tabindex="-1">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                </button>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="pwd-strength-bar mb-4 px-1" aria-hidden="true">
                <div class="pwd-strength-track"><div class="pwd-strength-fill" id="npwd-strength-fill"></div></div>
                <span class="pwd-strength-label" id="npwd-strength-label"></span>
            </div>

            <div class="form-floating mb-4" style="position: relative;">
                <InputText id="Input.ConfirmPassword" @bind-Value="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Potvrdenie nového hesla" style="border-color: #E2E8F0; padding-right: 3rem;" />
                <label for="Input.ConfirmPassword" class="form-label" style="color: #64748B;">Potvrďte nové heslo</label>
                <button type="button" class="pwd-toggle-manage" onclick="togglePwd('Input.ConfirmPassword', this)" aria-label="Zobraziť heslo" tabindex="-1">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                </button>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>

            <button type="submit" class="mud-button-root mud-button mud-button-filled mud-button-filled-primary mud-button-filled-size-large mud-width-full" style="background-color: #F97316; color: white; font-weight: 600; text-transform: none; border-radius: 8px;">Aktualizovať heslo</button>
        </EditForm>
    </div>
</div>

<style>
    .pwd-toggle-manage {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        background: none; border: none; cursor: pointer; color: #64748b; padding: 4px;
        display: flex; align-items: center; z-index: 5;
    }
    .pwd-toggle-manage:hover { color: #1e293b; }
    .pwd-strength-bar { display: flex; align-items: center; gap: 8px; }
    .pwd-strength-track { flex: 1; height: 5px; background: #e2e8f0; border-radius: 3px; overflow: hidden; }
    .pwd-strength-fill { height: 100%; width: 0; border-radius: 3px; transition: width .3s, background .3s; }
    .pwd-strength-label { font-size: 12px; min-width: 60px; color: #64748b; }
</style>

<script>
    function togglePwd(id, btn) {
        var inp = document.getElementById(id);
        if (!inp) return;
        var show = inp.type === 'password';
        inp.type = show ? 'text' : 'password';
        btn.title = show ? 'Skryť heslo' : 'Zobraziť heslo';
    }

    (function () {
        function pwdStrength(p) {
            if (!p) return { label: '', color: '#e2e8f0', pct: 0 };
            var s = 0;
            if (p.length >= 8) s++;
            if (/[A-Z]/.test(p) && /[a-z]/.test(p) && /\d/.test(p)) s++;
            if (/[^A-Za-z0-9]/.test(p)) s++;
            if (p.length >= 12) s++;
            var map = [
                { label: 'Slabé',      color: '#ef4444', pct: 25 },
                { label: 'Slabé',      color: '#ef4444', pct: 25 },
                { label: 'Priemerné', color: '#f97316', pct: 50 },
                { label: 'Dobré',      color: '#eab308', pct: 75 },
                { label: 'Silné',      color: '#22c55e', pct: 100 },
            ];
            return map[s];
        }

        function init() {
            var inp  = document.getElementById('Input.NewPassword');
            var fill = document.getElementById('npwd-strength-fill');
            var lbl  = document.getElementById('npwd-strength-label');
            if (!inp || !fill || !lbl) return;
            inp.addEventListener('input', function () {
                var r = pwdStrength(inp.value);
                fill.style.width = r.pct + '%';
                fill.style.background = r.color;
                lbl.textContent = r.label;
                lbl.style.color = r.color;
            });
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    })();
</script>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Chyba: {string.Join(", ", changePasswordResult.Errors.Select(e => TranslateError(e.Code)))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectToCurrentPageWithStatus("Heslo bolo úspešne zmenené.", HttpContext);
    }

    private static string TranslateError(string code) => code switch
    {
        "PasswordMismatch"        => "Nesprávne staré heslo.",
        "PasswordTooShort"        => "Heslo je príliš krátke.",
        "PasswordRequiresDigit"   => "Heslo musí obsahovať číslicu.",
        "PasswordRequiresUpper"   => "Heslo musí obsahovať veľké písmeno.",
        "PasswordRequiresLower"   => "Heslo musí obsahovať malé písmeno.",
        "PasswordRequiresNonAlphanumeric" => "Heslo musí obsahovať špeciálny znak.",
        _                         => code
    };

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Staré heslo je povinné")]
        [DataType(DataType.Password)]
        [Display(Name = "Staré heslo")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Nové heslo je povinné")]
        [StringLength(100, ErrorMessage = "Heslo musí mať aspoň {2} a najviac {1} znakov.", MinimumLength = 8)]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Heslo musí obsahovať malé písmeno, veľké písmeno a číslicu.")]
        [DataType(DataType.Password)]
        [Display(Name = "Nové heslo")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Potvrdenie nového hesla")]
        [Compare("NewPassword", ErrorMessage = "Heslá sa nezhodujú.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
