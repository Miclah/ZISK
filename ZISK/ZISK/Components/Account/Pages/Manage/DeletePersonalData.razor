@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ZISK.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Odstrániť osobné údaje</PageTitle>

<MudText Typo="Typo.h5" Color="Color.Error" Class="mb-4" Style="font-weight: 700;">Odstrániť osobné údaje</MudText>

<StatusMessage Message="@message" />

<MudStack Spacing="3" Style="max-width:520px;">
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        <strong>Odstránením týchto údajov natrvalo zrušíte svoj účet — túto akciu nie je možné vrátiť späť.</strong>
    </MudAlert>

    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />

        <MudStack Spacing="3">
            @if (requirePassword)
            {
                <MudStaticTextField Value="@Input.Password" For="@(() => Input.Password)"
                                    Label="Heslo" Variant="Variant.Outlined"
                                    InputType="InputType.Password"
                                    Placeholder="Zadajte svoje heslo na potvrdenie" />
            }

            <MudStaticButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                             Color="Color.Error" Size="Size.Large"
                             StartIcon="@Icons.Material.Rounded.DeleteForever">
                Odstrániť údaje a zrušiť účet
            </MudStaticButton>
        </MudStack>
    </EditForm>
</MudStack>

@code {
    private string? message;
    private ApplicationUser user = default!;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    protected override async Task OnInitializedAsync()
    {
        user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Chyba: Nesprávne heslo.";
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred deleting user.");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
