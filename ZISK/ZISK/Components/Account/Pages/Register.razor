@page "/Account/Register"
@page "/registracia"
@attribute [AllowAnonymous]
@layout ZISK.Components.Layout.LoginLayout

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using ZISK.Data
@using ZISK.Data.Entities

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ApplicationDbContext DbContext

<PageTitle>Registrácia - ZISK</PageTitle>

<div class="login-page">
    <div class="login-card register-card">
        <div class="login-brand">
            <h1>ZISK</h1>
            <p>Vytvorenie nového účtu</p>
        </div>

        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="login-alert">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                <span>@Message</span>
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />

            <div class="form-row">
                <div class="form-field">
                    <label for="firstName">Meno</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        <InputText @bind-Value="Input.FirstName" id="firstName" placeholder="Ján" />
                    </div>
                    <ValidationMessage For="() => Input.FirstName" />
                </div>
                <div class="form-field">
                    <label for="lastName">Priezvisko</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                        <InputText @bind-Value="Input.LastName" id="lastName" placeholder="Novák" />
                    </div>
                    <ValidationMessage For="() => Input.LastName" />
                </div>
            </div>

            <div class="form-field">
                <label for="email">Email</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                    <InputText @bind-Value="Input.Email" id="email" placeholder="vas@email.sk" autocomplete="username" />
                </div>
                <ValidationMessage For="() => Input.Email" />
            </div>

            <div class="form-field">
                <label for="role">Typ účtu</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.7 0 8 1.29 8 4v2H4v-2c0-2.71 5.3-4 8-4zm0-2a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"/></svg>
                    <InputSelect @bind-Value="Input.SelectedRole" id="role">
                        <option value="Parent">Rodič</option>
                        <option value="Athlete">Športovec</option>
                    </InputSelect>
                </div>
                <ValidationMessage For="() => Input.SelectedRole" />
            </div>

            <div class="form-row">
                <div class="form-field">
                    <label for="phone">Telefónne číslo</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                        <InputText @bind-Value="Input.PhoneNumber" id="phone" placeholder="+421 9XX XXX XXX" />
                    </div>
                    <ValidationMessage For="() => Input.PhoneNumber" />
                </div>
                <div class="form-field">
                    <label for="rodneCislo">Rodné číslo</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 7h-5V4c0-1.1-.9-2-2-2h-2c-1.1 0-2 .9-2 2v3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zM9 12c.83 0 1.5.67 1.5 1.5S9.83 15 9 15s-1.5-.67-1.5-1.5S8.17 12 9 12zm3 6H6v-.75c0-1 2-1.5 3-1.5s3 .5 3 1.5V18zm1-9h-2V4h2v5zm2 3.5c0 .28-.22.5-.5.5h-1c-.28 0-.5-.22-.5-.5v-1c0-.28.22-.5.5-.5h1c.28 0 .5.22.5.5v1zm3 0c0 .28-.22.5-.5.5h-1c-.28 0-.5-.22-.5-.5v-1c0-.28.22-.5.5-.5h1c.28 0 .5.22.5.5v1z"/></svg>
                        <InputText @bind-Value="Input.RodneCislo" id="rodneCislo" placeholder="XXXXXX/XXXX" />
                    </div>
                    <ValidationMessage For="() => Input.RodneCislo" />
                </div>
            </div>

            <div class="form-field">
                <label for="dob">Dátum narodenia</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg>
                    <InputText @bind-Value="Input.DateOfBirthString" id="dob" placeholder="DD.MM.RRRR" />
                </div>
                <ValidationMessage For="() => Input.DateOfBirthString" />
            </div>

            <div class="form-field">
                <label for="street">Ulica a číslo</label>
                <div class="input-wrapper">
                    <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                    <InputText @bind-Value="Input.Street" id="street" placeholder="Hlavná 123/45" autocomplete="street-address" />
                </div>
                <ValidationMessage For="() => Input.Street" />
            </div>

            <div class="form-row">
                <div class="form-field">
                    <label for="city">Mesto</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2L4 6v12h16V6l-8-4zm0 2.18L18 7v9H6V7l6-2.82zM8 9h2v2H8V9zm0 3h2v2H8v-2zm3-3h2v2h-2V9zm0 3h2v2h-2v-2zm3-3h2v2h-2V9zm0 3h2v2h-2v-2z"/></svg>
                        <InputText @bind-Value="Input.City" id="city" placeholder="Žiar nad Hronom" autocomplete="address-level2" />
                    </div>
                    <ValidationMessage For="() => Input.City" />
                </div>
                <div class="form-field">
                    <label for="postalCode">PSČ</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20 8h-3V4H7v4H4c-1.1 0-2 .9-2 2v9c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2v-9c0-1.1-.9-2-2-2zM9 6h6v2H9V6zm11 13H4v-9h16v9zm-6-7h4v2h-4v-2z"/></svg>
                        <InputText @bind-Value="Input.PostalCode" id="postalCode" placeholder="965 01" autocomplete="postal-code" />
                    </div>
                    <ValidationMessage For="() => Input.PostalCode" />
                </div>
            </div>

            <div class="form-divider"></div>

            @if (Input.SelectedRole == "Parent")
            {
                <div class="form-checkbox" style="margin-bottom: 12px;">
                    <InputCheckbox @bind-Value="Input.CreateChildProfile" id="createChild" />
                    <label for="createChild">Hneď pridať dieťa k profilu rodiča</label>
                </div>

                @if (Input.CreateChildProfile)
                {
                    <div class="form-row">
                        <div class="form-field">
                            <label for="childFirstName">Meno dieťaťa</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                <InputText @bind-Value="Input.ChildFirstName" id="childFirstName" placeholder="Meno dieťaťa" />
                            </div>
                            <ValidationMessage For="() => Input.ChildFirstName" />
                        </div>
                        <div class="form-field">
                            <label for="childLastName">Priezvisko dieťaťa</label>
                            <div class="input-wrapper">
                                <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4S14.21 4 12 4 8 5.79 8 8s1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                                <InputText @bind-Value="Input.ChildLastName" id="childLastName" placeholder="Priezvisko dieťaťa" />
                            </div>
                            <ValidationMessage For="() => Input.ChildLastName" />
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="childDob">Dátum narodenia dieťaťa</label>
                        <div class="input-wrapper">
                            <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M19 3h-1V1h-2v2H8V1H6v2H5C3.89 3 3 3.9 3 5v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/></svg>
                            <InputText @bind-Value="Input.ChildDateOfBirthString" id="childDob" placeholder="DD.MM.RRRR" />
                        </div>
                        <ValidationMessage For="() => Input.ChildDateOfBirthString" />
                    </div>
                }
            }

            <div class="form-row">
                <div class="form-field">
                    <label for="password">Heslo</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                        <InputText type="password" @bind-Value="Input.Password" id="password" placeholder="Min. 4 znaky" autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="() => Input.Password" />
                </div>
                <div class="form-field">
                    <label for="confirmPassword">Potvrdenie hesla</label>
                    <div class="input-wrapper">
                        <svg class="input-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                        <InputText type="password" @bind-Value="Input.ConfirmPassword" id="confirmPassword" placeholder="Zopakujte heslo" autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="() => Input.ConfirmPassword" />
                </div>
            </div>

            <button type="submit" class="btn-login">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                Zaregistrovať sa
            </button>
        </EditForm>

        <div class="login-footer">
            <a href="/login" class="register-link">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                Späť na prihlásenie
            </a>
        </div>
    </div>

    <p class="login-copyright">© 2026 ZISK</p>
</div>

@code {
    private IEnumerable<IdentityError>? identityErrors;

    private InputModel? _input;

    [SupplyParameterFromForm]
    private InputModel Input
    {
        get => _input ??= new();
        set => _input = value;
    }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
    }

    private string? Message => identityErrors is null
        ? null
        : string.Join(", ", identityErrors.Select(e => e.Description));

    public async Task RegisterUser(EditContext editContext)
    {
        var existingUser = await UserManager.FindByEmailAsync(Input.Email);
        if (existingUser != null)
        {
            identityErrors = [new IdentityError { Description = "Používateľ s týmto emailom už existuje." }];
            return;
        }

        var user = new ApplicationUser
        {
            UserName = Input.Email,
            Email = Input.Email,
            FirstName = Input.FirstName,
            LastName = Input.LastName,
            PhoneNumber = Input.PhoneNumber,
            RodneCislo = Input.RodneCislo,
            Bydlisko = Input.GetFormattedAddress(),
            DateOfBirth = Input.ParsedDateOfBirth,
            EmailConfirmed = true,
            IsActive = true
        };

        var result = await UserManager.CreateAsync(user, Input.Password);

        if (!result.Succeeded)
        {
            identityErrors = result.Errors;
            return;
        }

        Logger.LogInformation("User {Email} created a new account.", Input.Email);

        await UserManager.AddToRoleAsync(user, Input.SelectedRole);

        if (Input.SelectedRole == "Parent" && Input.CreateChildProfile && Input.ChildParsedDateOfBirth.HasValue)
        {
            var childProfile = new ChildProfile
            {
                Id = Guid.NewGuid(),
                FirstName = Input.ChildFirstName.Trim(),
                LastName = Input.ChildLastName.Trim(),
                DateOfBirth = Input.ChildParsedDateOfBirth.Value,
                Email = null,
                IsActive = true
            };

            DbContext.ChildProfiles.Add(childProfile);
            DbContext.ParentChildren.Add(new ParentChild
            {
                ParentId = user.Id,
                ChildId = childProfile.Id,
                IsPrimary = true
            });

            await DbContext.SaveChangesAsync();
        }

        await SignInManager.SignInAsync(user, isPersistent: false);
        RedirectManager.RedirectTo(ReturnUrl);
    }

    private sealed class InputModel : IValidatableObject
    {
        [Required(ErrorMessage = "Meno je povinné")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Meno musí mať 2–100 znakov")]
        public string FirstName { get; set; } = "";

        [Required(ErrorMessage = "Priezvisko je povinné")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Priezvisko musí mať 2–100 znakov")]
        public string LastName { get; set; } = "";

        [Required(ErrorMessage = "Email je povinný")]
        [EmailAddress(ErrorMessage = "Neplatný formát emailu")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Typ účtu je povinný")]
        [RegularExpression("^(Parent|Athlete)$", ErrorMessage = "Neplatný typ účtu")]
        public string SelectedRole { get; set; } = "Parent";

        [Required(ErrorMessage = "Telefónne číslo je povinné")]
        [RegularExpression(@"^(\+421|0)\s?9\d{2}\s?\d{3}\s?\d{3}$",
            ErrorMessage = "Zadajte slovenské číslo v tvare +421 9XX XXX XXX alebo 09XX XXX XXX")]
        public string PhoneNumber { get; set; } = "";

        [Required(ErrorMessage = "Rodné číslo je povinné")]
        [RegularExpression(@"^\d{6}/?\d{3,4}$",
            ErrorMessage = "Zadajte rodné číslo v tvare XXXXXX/XXXX")]
        public string RodneCislo { get; set; } = "";

        [Required(ErrorMessage = "Dátum narodenia je povinný")]
        [RegularExpression(@"^\d{1,2}\.\d{1,2}\.\d{4}$",
            ErrorMessage = "Zadajte dátum v tvare DD.MM.RRRR")]
        public string DateOfBirthString { get; set; } = "";

        public DateOnly? ParsedDateOfBirth =>
            DateOnly.TryParseExact(DateOfBirthString, "d.M.yyyy", out var d) ? d : null;

        [Required(ErrorMessage = "Ulica je povinná")]
        [StringLength(150, MinimumLength = 3, ErrorMessage = "Ulica musí mať 3–150 znakov")]
        public string Street { get; set; } = "";

        [Required(ErrorMessage = "Mesto je povinné")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Mesto musí mať 2–100 znakov")]
        public string City { get; set; } = "";

        [Required(ErrorMessage = "PSČ je povinné")]
        [RegularExpression(@"^\d{3}\s?\d{2}$", ErrorMessage = "PSČ zadajte v tvare 123 45")]
        public string PostalCode { get; set; } = "";

        public bool CreateChildProfile { get; set; }

        public string ChildFirstName { get; set; } = "";

        public string ChildLastName { get; set; } = "";

        public string ChildDateOfBirthString { get; set; } = "";

        public DateOnly? ChildParsedDateOfBirth =>
            DateOnly.TryParseExact(ChildDateOfBirthString, "d.M.yyyy", out var d) ? d : null;

        [Required(ErrorMessage = "Heslo je povinné")]
        [StringLength(100, MinimumLength = 4, ErrorMessage = "Heslo musí mať minimálne 4 znaky")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Potvrdenie hesla je povinné")]
        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "Heslá sa nezhodujú")]
        public string ConfirmPassword { get; set; } = "";

        public string GetFormattedAddress()
        {
            var normalizedPostalCode = Regex.Replace(PostalCode, @"\s+", string.Empty);
            if (normalizedPostalCode.Length == 5)
            {
                normalizedPostalCode = $"{normalizedPostalCode[..3]} {normalizedPostalCode[3..]}";
            }

            return $"{Street.Trim()}, {normalizedPostalCode} {City.Trim()}";
        }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!ParsedDateOfBirth.HasValue)
            {
                yield return new ValidationResult("Neplatný dátum narodenia", [nameof(DateOfBirthString)]);
            }

            if (GetFormattedAddress().Length > 300)
            {
                yield return new ValidationResult("Bydlisko je príliš dlhé", [nameof(Street), nameof(City), nameof(PostalCode)]);
            }

            if (SelectedRole == "Parent" && CreateChildProfile)
            {
                if (string.IsNullOrWhiteSpace(ChildFirstName) || ChildFirstName.Trim().Length < 2)
                {
                    yield return new ValidationResult("Meno dieťaťa musí mať aspoň 2 znaky", [nameof(ChildFirstName)]);
                }

                if (string.IsNullOrWhiteSpace(ChildLastName) || ChildLastName.Trim().Length < 2)
                {
                    yield return new ValidationResult("Priezvisko dieťaťa musí mať aspoň 2 znaky", [nameof(ChildLastName)]);
                }

                if (!ChildParsedDateOfBirth.HasValue)
                {
                    yield return new ValidationResult("Neplatný dátum narodenia dieťaťa", [nameof(ChildDateOfBirthString)]);
                }
            }
        }
    }
}
