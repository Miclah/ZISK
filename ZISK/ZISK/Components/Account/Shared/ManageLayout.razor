@inherits LayoutComponentBase
@layout ZISK.Client.Layout.MainLayout

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-16">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Rounded.ArrowBack" Href="/profil"
                       Color="Color.Default" Title="Späť na profil" />
        <MudText Typo="Typo.h6">Späť na profil</MudText>
    </MudStack>

    <MudGrid>
        <MudItem xs="12" md="3">
            <ManageNavMenu />
        </MudItem>
        <MudItem xs="12" md="9">
            <MudPaper Elevation="0" Outlined="true" Class="pa-6 rounded-lg">
                @Body
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
