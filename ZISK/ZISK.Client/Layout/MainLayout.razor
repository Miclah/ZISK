@inherits LayoutComponentBase
@using ZISK.Client.Layout
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Invitations
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITeamsApi TeamsApi
@inject IInvitationsApi InvitationsApi
@inject ISnackbar Snackbar
@inject HttpActivityTracker ActivityTracker
@inject OnlineStatusService OnlineStatus
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider Theme="AppTheme.SportClubTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<ErrorBoundary>
    <ChildContent>
<MudLayout>
    @if (ActivityTracker.IsActive)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           Style="position:fixed;top:64px;left:0;right:0;z-index:2000;height:3px;" />
    }
    @if (!OnlineStatus.IsOnline)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" NoIcon="false"
                  Style="position:fixed;top:64px;left:0;right:0;z-index:1999;border-radius:0;text-align:center;">
            Aplikácia vyžaduje pripojenie na internet. Skontrolujte prosím svoje sieťové nastavenia.
        </MudAlert>
    }

    <MudAppBar Elevation="0" Fixed="true" Style="background: var(--zisk-gradient-primary); border-bottom: 1px solid var(--zisk-border-on-dark);">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-1">
            <MudText Typo="Typo.h6" Class="zisk-logo-text">ZISK</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="appbar-version-chip">
                v1.0
            </MudChip>
            @if (_isCoach && !string.IsNullOrWhiteSpace(_coachTeamName))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="appbar-team-chip">
                    @_coachTeamName
                </MudChip>
            }
        </MudStack>

        <MudSpacer />

        <AuthorizeView>
            <Authorized Context="authContext">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="NavigateToProfile" Class="px-2 py-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Small" Class="appbar-user-avatar">
                                @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                    ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                    : "?")
                            </MudAvatar>
                            <MudStack Spacing="0" Class="ml-2 d-none d-sm-flex" Style="text-align: left;">
                                <MudText Typo="Typo.body2" Class="appbar-user-name">
                                    @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                                </MudText>
                                <MudText Typo="Typo.caption" Class="appbar-user-role">
                                    @authContext.User.FindFirst(ClaimTypes.Role)?.Value
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudButton>

                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Icon="@Icons.Material.Rounded.KeyboardArrowDown">
                    <ChildContent>
                        <div style="min-width: 280px; padding: 0;">
                            <div class="user-menu-header">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                    <MudAvatar Size="Size.Large" Class="user-menu-avatar">
                                        @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                            ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                            : "?")
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: white; line-height: 1.3;">
                                            @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.65);">
                                            @authContext.User.FindFirst(ClaimTypes.Email)?.Value
                                        </MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="appbar-team-chip" Style="margin-top: 4px;">
                                            @authContext.User.FindFirst(ClaimTypes.Role)?.Value
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                            </div>
                            <div style="padding: 0.5rem;">
                                <MudMenuItem Icon="@Icons.Material.Rounded.Person"
                                             OnClick="NavigateToProfile"
                                             Style="border-radius: 8px;">
                                    Zobraziť profil
                                </MudMenuItem>
                                <MudDivider Class="my-1" />
                                <MudMenuItem Icon="@Icons.Material.Rounded.Logout"
                                             Href="/logout"
                                             ForceLoad="true"
                                             Style="border-radius: 8px; color: var(--zisk-logout-color);">
                                    Odhlásiť sa
                                </MudMenuItem>
                            </div>
                        </div>
                    </ChildContent>
                    </MudMenu>
                </MudStack>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               Anchor="Anchor.Left"
               Style="border-right: 1px solid var(--zisk-border-default);">
        <MudDrawerContainer>
            <NavMenu />
        </MudDrawerContainer>
    </MudDrawer>

    <MudMainContent Class="pa-6" Style="@MainContentStyle">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            @if (_pendingInvitations.Any())
            {
                <MudStack Spacing="1" Class="mb-3">
                    @foreach (var inv in _pendingInvitations)
                    {
                        <MudAlert Severity="Severity.Info" ShowCloseIcon="true" CloseIconClicked="@(() => DismissInvitation(inv))">
                            Máte čakajúcu pozvánku na priradenie k dieťaťu <strong>@inv.ChildName</strong> od <strong>@inv.InitiatorName</strong>.
                            <MudButton Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Class="ml-2"
                                       OnClick="@(() => AcceptInvitation(inv))">
                                Prijať
                            </MudButton>
                        </MudAlert>
                    }
                </MudStack>
            }
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudAlert Severity="Severity.Error" Dense="true">
                            Stránka sa nepodarilo načítať. Skúste obnoviť stránku alebo sa znovu prihlásiť.
                        </MudAlert>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>


    </MudLayout>
    </ChildContent>
    <ErrorContent>
        <MudPaper Class="pa-4 ma-4" Elevation="2">
            <MudAlert Severity="Severity.Error" Dense="true">
                Nastala chyba v rozhraní. Skúste obnoviť stránku (Ctrl+F5).
            </MudAlert>
        </MudPaper>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool _drawerOpen = true;
    private bool _isCoach;
    private bool _isParentAthlete;
    private string? _coachTeamName;
    private List<PendingInvitationDto> _pendingInvitations = new();

    private string MainContentStyle => "background: var(--zisk-bg); min-height: 100vh;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            OnlineStatus.StatusChanged += OnOnlineStatusChanged;
            await OnlineStatus.InitializeAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        ActivityTracker.StateChanged += OnActivityChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isCoach = authState.User.IsInRole("Coach");
        _isParentAthlete = authState.User.IsInRole("Parent") || authState.User.IsInRole("Athlete");

        if (_isCoach)
        {
            try
            {
                var teams = await TeamsApi.GetTeamsAsync(true);
                _coachTeamName = teams.FirstOrDefault()?.Name;
            }
            catch
            {
                _coachTeamName = null;
            }
        }

        // Load pending email invitations for this user
        try
        {
            _pendingInvitations = await InvitationsApi.GetPendingAsync();
        }
        catch { }

    }

    private void OnOnlineStatusChanged() => InvokeAsync(StateHasChanged);

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profil");
    }

    private void DismissInvitation(PendingInvitationDto inv)
    {
        _pendingInvitations.Remove(inv);
    }

    private void OnActivityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ActivityTracker.StateChanged -= OnActivityChanged;
        OnlineStatus.StatusChanged -= OnOnlineStatusChanged;
    }

    public async ValueTask DisposeAsync()
    {
        await OnlineStatus.DisposeAsync();
    }

    private async Task AcceptInvitation(PendingInvitationDto inv)
    {
        try
        {
            await InvitationsApi.AcceptAsync(inv.Token);
            _pendingInvitations.Remove(inv);
            Snackbar.Add($"Úspešne prepojené s dieťaťom {inv.ChildName}!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }
}
