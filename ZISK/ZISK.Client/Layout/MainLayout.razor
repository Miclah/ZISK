@inherits LayoutComponentBase
@using ZISK.Client.Layout
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITeamsApi TeamsApi

<MudThemeProvider Theme="AppTheme.SportClubTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Style="border-bottom: 1px solid rgba(255,255,255,0.08);">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-1">
            <MudText Typo="Typo.h6" Style="font-weight: 700; letter-spacing: -0.5px;">ZISK</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Style="color: rgba(255,255,255,0.6); border-color: rgba(255,255,255,0.2); font-size: 0.65rem; height: 20px;">
                v1.0
            </MudChip>
            @if (_isCoach && !string.IsNullOrWhiteSpace(_coachTeamName))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.15); color: white; font-size: 0.65rem; height: 20px;">
                    @_coachTeamName
                </MudChip>
            }
        </MudStack>

        <MudSpacer />

        <AuthorizeView>
            <Authorized Context="authContext">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="NavigateToProfile" Class="px-2 py-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Small"
                                       Style="background: linear-gradient(135deg, #FF6B35, #e55a2b); width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700;">
                                @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                    ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                    : "?")
                            </MudAvatar>
                            <MudStack Spacing="0" Class="ml-2 d-none d-sm-flex" Style="text-align: left;">
                                <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.2; color: white;">
                                    @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                                </MudText>
                                <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.55); line-height: 1.2; font-size: 0.7rem;">
                                    @authContext.User.FindFirst(ClaimTypes.Role)?.Value
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudButton>

                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Icon="@Icons.Material.Rounded.KeyboardArrowDown">
                    <ChildContent>
                        <div style="min-width: 280px; padding: 0;">
                            <div style="background: linear-gradient(135deg, #1E3A5F, #2d5a8e); padding: 1.25rem; border-radius: 4px 4px 0 0;">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                    <MudAvatar Size="Size.Large"
                                               Style="background: linear-gradient(135deg, #FF6B35, #e55a2b); font-size: 1.1rem; font-weight: 700; border: 2px solid rgba(255,255,255,0.2);">
                                        @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                            ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                            : "?")
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: white; line-height: 1.3;">
                                            @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.65);">
                                            @authContext.User.FindFirst(ClaimTypes.Email)?.Value
                                        </MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                 Style="background: rgba(255,255,255,0.15); color: white; font-size: 0.65rem; height: 20px; margin-top: 4px; padding: 0 8px;">
                                            @authContext.User.FindFirst(ClaimTypes.Role)?.Value
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                            </div>
                            <div style="padding: 0.5rem;">
                                <MudMenuItem Icon="@Icons.Material.Rounded.Person"
                                             OnClick="NavigateToProfile"
                                             Style="border-radius: 8px;">
                                    Zobraziť profil
                                </MudMenuItem>
                                <MudDivider Class="my-1" />
                                <MudMenuItem Icon="@Icons.Material.Rounded.Logout"
                                             Href="/logout"
                                             ForceLoad="true"
                                             Style="border-radius: 8px; color: #E74C3C;">
                                    Odhlásiť sa
                                </MudMenuItem>
                            </div>
                        </div>
                    </ChildContent>
                    </MudMenu>
                </MudStack>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               Anchor="Anchor.Left"
               Style="border-right: 1px solid #E2E8F0;">
        <MudDrawerContainer>
            <NavMenu />
        </MudDrawerContainer>
    </MudDrawer>

    <MudMainContent Class="pa-6" Style="@MainContentStyle">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>

    @if (_isCoach)
    {
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudPaper Elevation="6" Class="pa-2 d-flex justify-space-around" Style="position: fixed; left: 0; right: 0; bottom: 0; z-index: 1200; border-top: 1px solid var(--mud-palette-lines-default);">
                <MudIconButton Icon="@Icons.Material.Rounded.Home" Color="Color.Primary" Href="/coach" />
                <MudIconButton Icon="@Icons.Material.Rounded.Event" Color="Color.Primary" Href="/coach/treningy" />
                <MudIconButton Icon="@Icons.Material.Rounded.Groups" Color="Color.Primary" Href="/coach/tim" />
                <MudIconButton Icon="@Icons.Material.Rounded.Announcement" Color="Color.Primary" Href="/coach/oznamy" />
            </MudPaper>
        </MudHidden>
    }
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isCoach;
    private string? _coachTeamName;

    private string MainContentStyle => _isCoach
        ? "background: #F8FAFC; min-height: 100vh; padding-bottom: 90px;"
        : "background: #F8FAFC; min-height: 100vh;";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isCoach = authState.User.IsInRole("Coach");

        if (_isCoach)
        {
            try
            {
                var teams = await TeamsApi.GetTeamsAsync(true);
                _coachTeamName = teams.FirstOrDefault()?.Name;
            }
            catch
            {
                _coachTeamName = null;
            }
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profil");
    }
}