@inherits LayoutComponentBase
@using ZISK.Client.Layout
@using System.Security.Claims

<MudThemeProvider Theme="AppTheme.SportClubTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Fixed="false">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />

        <MudText Typo="Typo.h6" Class="ml-2">ZISK</MudText>

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Rounded.AccountCircle"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <ChildContent>
                        <MudStack Class="pa-4" Style="min-width: 220px;" Spacing="1">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                @context.User.FindFirst(ClaimTypes.GivenName)?.Value @context.User.FindFirst(ClaimTypes.Surname)?.Value
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @context.User.FindFirst(ClaimTypes.Email)?.Value
                            </MudText>
                            <MudDivider Class="my-2" />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Rounded.Person"
                                       Href="/profil"
                                       Size="Size.Small">
                                Zobraziť profil
                            </MudButton>
                        </MudStack>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Docked"
               Elevation="1"
               Breakpoint="Breakpoint.Sm"
               Variant="DrawerVariant.Responsive"
               Anchor="Anchor.Left"
               >
        <MudDrawerContainer>
            <NavMenu />
        </MudDrawerContainer>
    </MudDrawer>

    <MudMainContent Class="pa-6">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;
}