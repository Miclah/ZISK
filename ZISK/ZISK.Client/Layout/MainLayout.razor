@inherits LayoutComponentBase
@using ZISK.Client.Layout
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using System.Security.Claims
@using Refit
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITeamsApi TeamsApi
@inject IChildrenApi ChildrenApi
@inject UserContextService UserContextService

<MudThemeProvider Theme="AppTheme.SportClubTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<ErrorBoundary>
    <ChildContent>
<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Style="border-bottom: 1px solid var(--zisk-appbar-border);">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-1">
            <MudText Typo="Typo.h6" Class="zisk-logo-text">ZISK</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="appbar-version-chip">
                v1.0
            </MudChip>
            @if (_isCoach && !string.IsNullOrWhiteSpace(_coachTeamName))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="appbar-team-chip">
                    @_coachTeamName
                </MudChip>
            }
        </MudStack>

        @if (_showContextSwitcher)
        {
            <MudSelect T="string"
                       Value="@_selectedContextKey"
                       ValueChanged="OnContextChanged"
                       Label="Kontext"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Class="ml-2 appbar-context-select">
                @foreach (var option in UserContextService.Options)
                {
                    <MudSelectItem Value="@option.Key">@option.Label</MudSelectItem>
                }
            </MudSelect>
        }

        <MudSpacer />

        <AuthorizeView>
            <Authorized Context="authContext">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="NavigateToProfile" Class="px-2 py-1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudAvatar Size="Size.Small" Class="appbar-user-avatar">
                                @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                    ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                    : "?")
                            </MudAvatar>
                            <MudStack Spacing="0" Class="ml-2 d-none d-sm-flex" Style="text-align: left;">
                                <MudText Typo="Typo.body2" Class="appbar-user-name">
                                    @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                                </MudText>
                                <MudText Typo="Typo.caption" Class="appbar-user-role">
                                    @authContext.User.FindFirst(ClaimTypes.Role)?.Value
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudButton>

                    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Icon="@Icons.Material.Rounded.KeyboardArrowDown">
                    <ChildContent>
                        <div style="min-width: 280px; padding: 0;">
                            <div class="user-menu-header">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                    <MudAvatar Size="Size.Large" Class="user-menu-avatar">
                                        @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                            ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                            : "?")
                                    </MudAvatar>
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: white; line-height: 1.3;">
                                            @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                                        </MudText>
                                        <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.65);">
                                            @authContext.User.FindFirst(ClaimTypes.Email)?.Value
                                        </MudText>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="appbar-team-chip" Style="margin-top: 4px;">
                                            @authContext.User.FindFirst(ClaimTypes.Role)?.Value
                                        </MudChip>
                                    </MudStack>
                                </MudStack>
                            </div>
                            <div style="padding: 0.5rem;">
                                <MudMenuItem Icon="@Icons.Material.Rounded.Person"
                                             OnClick="NavigateToProfile"
                                             Style="border-radius: 8px;">
                                    Zobraziť profil
                                </MudMenuItem>
                                <MudDivider Class="my-1" />
                                <MudMenuItem Icon="@Icons.Material.Rounded.Logout"
                                             Href="/logout"
                                             ForceLoad="true"
                                             Style="border-radius: 8px; color: var(--zisk-logout-color);">
                                    Odhlásiť sa
                                </MudMenuItem>
                            </div>
                        </div>
                    </ChildContent>
                    </MudMenu>
                </MudStack>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               Anchor="Anchor.Left"
               Style="border-right: 1px solid var(--zisk-drawer-border);">
        <MudDrawerContainer>
            <NavMenu />
        </MudDrawerContainer>
    </MudDrawer>

    <MudMainContent Class="pa-6" Style="@MainContentStyle">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudAlert Severity="Severity.Error" Dense="true">
                            Stránka sa nepodarilo načítať. Skúste obnoviť stránku alebo sa znovu prihlásiť.
                        </MudAlert>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>


    </MudLayout>
    </ChildContent>
    <ErrorContent>
        <MudPaper Class="pa-4 ma-4" Elevation="2">
            <MudAlert Severity="Severity.Error" Dense="true">
                Nastala chyba v rozhraní. Skúste obnoviť stránku (Ctrl+F5).
            </MudAlert>
        </MudPaper>
    </ErrorContent>
</ErrorBoundary>

@code {
    private bool _drawerOpen = true;
    private bool _isCoach;
    private bool _isParentAthlete;
    private string? _coachTeamName;
    private bool _showContextSwitcher;
    private string _selectedContextKey = UserContextService.AllKey;

    private string MainContentStyle => "background: var(--zisk-app-bg); min-height: 100vh;";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isCoach = authState.User.IsInRole("Coach");
        _isParentAthlete = authState.User.IsInRole("Parent") || authState.User.IsInRole("Athlete");

        if (_isCoach)
        {
            try
            {
                var teams = await TeamsApi.GetTeamsAsync(true);
                _coachTeamName = teams.FirstOrDefault()?.Name;
            }
            catch
            {
                _coachTeamName = null;
            }
        }

        if (_isParentAthlete)
        {
            try
            {
                var children = await ChildrenApi.GetMyChildrenAsync();
                var options = new List<UserContextOption>();

                if (children.Count > 1)
                {
                    options.Add(new UserContextOption(UserContextService.AllKey, "Všetci", null, null, false));
                }

                foreach (var person in children.OrderBy(c => c.LastName).ThenBy(c => c.FirstName))
                {
                    var label = person.IsOwnProfile
                        ? $"Moje tréningy ({person.FirstName})"
                        : $"{person.FirstName} {person.LastName}";
                    options.Add(new UserContextOption(person.Id.ToString(), label, person.Id, person.TeamId, person.IsOwnProfile));
                }

                if (!options.Any())
                {
                    options.Add(new UserContextOption(UserContextService.AllKey, "Všetci", null, null, false));
                }

                UserContextService.SetOptions(options);
                _selectedContextKey = UserContextService.SelectedKey;
                _showContextSwitcher = UserContextService.Options.Count > 1 && !string.IsNullOrWhiteSpace(_selectedContextKey);
            }
            catch (ApiException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _showContextSwitcher = false;
            }
            catch
            {
                _showContextSwitcher = false;
            }
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profil");
    }

    private void OnContextChanged(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        _selectedContextKey = value;
        UserContextService.SetSelected(value);
    }
}
