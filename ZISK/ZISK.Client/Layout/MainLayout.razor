@inherits LayoutComponentBase
@using ZISK.Client.Display
@using ZISK.Client.Layout
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Invitations
@using System.Security.Claims
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITeamsApi TeamsApi
@inject IInvitationsApi InvitationsApi
@inject ISnackbar Snackbar
@inject HttpActivityTracker ActivityTracker
@inject OnlineStatusService OnlineStatus
@inject IDemoApi DemoApi
@inject IDialogService DialogService
@inject ILanguageService LanguageService
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider Theme="AppTheme.SportClubTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

<ErrorBoundary>
    <ChildContent>
<MudLayout>
    @if (ActivityTracker.IsActive)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true"
                           Style="position:fixed;top:64px;left:0;right:0;z-index:2000;height:3px;" />
    }
    @if (!OnlineStatus.IsOnline)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" NoIcon="false"
                  Style="position:fixed;top:64px;left:0;right:0;z-index:1999;border-radius:0;text-align:center;">
            @T("layout.offlineWarning")
        </MudAlert>
    }
    @* The demo notice lives in the content flow further down, not up here as a fixed overlay -
       see the comment at that MudAlert for why. *@

    <MudAppBar Elevation="0" Fixed="true" Style="background: var(--zisk-gradient-primary); border-bottom: 1px solid var(--zisk-border-on-dark);">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="DrawerToggle" />

        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-1">
            <MudText Typo="Typo.h6" Class="zisk-logo-text">ZISK</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="appbar-version-chip">
                v1.0
            </MudChip>
            @if (_isDemo)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning">
                    DEMO
                </MudChip>
                @* Authorship follows the visitor into the app. The /demo footer carries it too,
                   but that screen is three seconds of a reviewer's attention - after the first
                   click the name and the repo link would otherwise be unreachable. Hidden below
                   md, where the appbar has no room to spare. *@
                <div class="appbar-credit d-none d-md-flex">
                    <span class="appbar-credit-dot" aria-hidden="true"></span>
                    <span>Michal Petrán</span>
                    <span class="appbar-credit-dot" aria-hidden="true"></span>
                    <a href="@SourceUrl" target="_blank" rel="noopener noreferrer">GitHub</a>
                </div>
            }
            @if (_isCoach && !string.IsNullOrWhiteSpace(_coachTeamName))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Class="appbar-team-chip">
                    @_coachTeamName
                </MudChip>
            }
        </MudStack>

        <MudSpacer />

        @if (_isDemo)
        {
            <MudTooltip Text="@T("layout.resetTooltip")">
                <MudIconButton Icon="@Icons.Material.Rounded.RestartAlt"
                               Color="Color.Inherit"
                               OnClick="OpenResetDialog" />
            </MudTooltip>
        }

        <LanguageSwitcher />

        <AuthorizeView>
            <Authorized Context="authContext">
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="NavigateToProfile" Class="px-2 py-1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudAvatar Size="Size.Small" Class="appbar-user-avatar">
                            @(authContext.User.FindFirst(ClaimTypes.GivenName)?.Value?.Length > 0
                                ? authContext.User.FindFirst(ClaimTypes.GivenName)!.Value[0].ToString().ToUpper()
                                : "?")
                        </MudAvatar>
                        <MudStack Spacing="0" Class="ml-2 d-none d-sm-flex" Style="text-align: left;">
                            <MudText Typo="Typo.body2" Class="appbar-user-name">
                                @authContext.User.FindFirst(ClaimTypes.GivenName)?.Value @authContext.User.FindFirst(ClaimTypes.Surname)?.Value
                            </MudText>
                            <MudText Typo="Typo.caption" Class="appbar-user-role">
                                @GetRoleName(authContext.User.FindFirst(ClaimTypes.Role)?.Value)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Variant="DrawerVariant.Responsive"
               Anchor="Anchor.Left"
               Style="border-right: 1px solid var(--zisk-border-default);">
        <MudDrawerContainer>
            <NavMenu />
        </MudDrawerContainer>
    </MudDrawer>

    <MudMainContent Class="pb-6" Style="@MainContentStyle">
        <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" DisableGutters="true">
            @* In the flow rather than position:fixed on purpose. As a fixed overlay it sat on top
               of the first ~50px of every page (the dashboard hero was rendered behind it), because
               nothing reserved height for it. Here it pushes content down instead.
               Dismissible because it only needs to be read once - the permanent "this is a demo"
               marker is the DEMO chip in the app bar, which never goes away. Dismissal is
               component state, so it survives in-app navigation (the layout is not re-created) and
               comes back on a hard reload, which is what a first-time visitor should see. *@
            @if (_isDemo && !_demoNoticeDismissed && OnlineStatus.IsOnline)
            {
                <MudAlert Severity="Severity.Info" Dense="true" ShowCloseIcon="true"
                          CloseIconClicked="@(() => _demoNoticeDismissed = true)"
                          Class="mb-3">
                    @T("layout.demoBanner")
                </MudAlert>
            }

            @if (_pendingInvitations.Any())
            {
                <MudStack Spacing="1" Class="mb-3">
                    @foreach (var inv in _pendingInvitations)
                    {
                        <MudAlert Severity="Severity.Info" ShowCloseIcon="true" CloseIconClicked="@(() => DismissInvitation(inv))">
                            @T("layout.pendingInvitationPrefix") <strong>@inv.ChildName</strong> @T("layout.pendingInvitationFrom") <strong>@inv.InitiatorName</strong>.
                            @T("layout.pendingInvitationSuffix")
                        </MudAlert>
                    }
                </MudStack>
            }
            <ErrorBoundary>
                <ChildContent>
                    @* The fade is restarted by swapping between two identical animations rather
                       than by @key-ing this div on the URL. The key looked equivalent but was not:
                       the Router renders the new page synchronously from its own LocationChanged
                       handler, before this layout's handler updates the key, so the page was built
                       once under the old key and then thrown away and built a second time when the
                       new key arrived. Every page therefore ran OnInitializedAsync twice - which
                       double-loaded its data, and on the pages that open a create dialog from a
                       ?action=create deep link, opened that dialog twice. *@
                    <div class="@RouteTransitionClass">
                        @Body
                    </div>
                </ChildContent>
                <ErrorContent>
                    <MudPaper Class="pa-4" Elevation="2">
                        <MudAlert Severity="Severity.Error" Dense="true">
                            @T("layout.pageLoadError")
                        </MudAlert>
                    </MudPaper>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>


    </MudLayout>
    </ChildContent>
    <ErrorContent>
        <MudPaper Class="pa-4 ma-4" Elevation="2">
            <MudAlert Severity="Severity.Error" Dense="true">
                Nastala chyba v rozhraní. Skúste obnoviť stránku (Ctrl+F5).
            </MudAlert>
        </MudPaper>
    </ErrorContent>
</ErrorBoundary>

@code {
    private const string SourceUrl = "https://github.com/Miclah/ZISK";

    private bool _drawerOpen = true;
    private bool _isCoach;
    private bool _isParentAthlete;
    private bool _isDemo;
    private bool _demoNoticeDismissed;
    private string? _coachTeamName;
    private List<PendingInvitationDto> _pendingInvitations = new();
    private bool _routeTransitionFlipped;

    /// <summary>
    /// Alternates between two classes carrying identical fade keyframes. Changing the animation name
    /// is what makes the browser replay it; the element itself stays put, so the page inside is not
    /// torn down and rebuilt.
    /// </summary>
    private string RouteTransitionClass =>
        _routeTransitionFlipped ? "route-transition route-transition--b" : "route-transition route-transition--a";

    private string MainContentStyle => "background: var(--zisk-bg); min-height: 100vh;";

    private string T(string key) => LanguageService[key];

    protected override void OnInitialized()
    {
        ActivityTracker.StateChanged += OnActivityChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        LanguageService.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            OnlineStatus.StatusChanged += OnOnlineStatusChanged;
            await OnlineStatus.InitializeAsync();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _isCoach = authState.User.IsInRole("Coach");
        _isParentAthlete = authState.User.IsInRole("Parent") || authState.User.IsInRole("Athlete");

        if (_isCoach)
        {
            try
            {
                var teams = await TeamsApi.GetTeamsAsync(true);
                _coachTeamName = teams.FirstOrDefault()?.Name;
            }
            catch
            {
                _coachTeamName = null;
            }
        }

        try
        {
            _pendingInvitations = await InvitationsApi.GetPendingAsync();
        }
        catch { }

        try
        {
            var status = await DemoApi.GetStatusAsync();
            _isDemo = status.IsDemo;
        }
        catch
        {
            _isDemo = false;
        }
    }

    private async Task OpenResetDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        await DialogService.ShowAsync<DemoResetDialog>(T("layout.resetTooltip"), options);
    }

    private void OnOnlineStatusChanged() => InvokeAsync(StateHasChanged);

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void NavigateToProfile()
    {
        NavigationManager.NavigateTo("/profil");
    }

    private void DismissInvitation(PendingInvitationDto inv)
    {
        _pendingInvitations.Remove(inv);
    }

    private void OnActivityChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _routeTransitionFlipped = !_routeTransitionFlipped;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ActivityTracker.StateChanged -= OnActivityChanged;
        OnlineStatus.StatusChanged -= OnOnlineStatusChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        LanguageService.Changed -= OnLanguageChanged;
    }

    public async ValueTask DisposeAsync()
    {
        await OnlineStatus.DisposeAsync();
    }

    // DomainLabels.Role covers the same mapping and is already reactive to language switches
    // (see DomainLabels.Current) - no need for a separate local copy that could drift.
    private static string GetRoleName(string? role) => DomainLabels.Role(role ?? "");

}
