@inherits LocalizedComponentBase

<MudStack Class="pa-3" Style="height: 100%;" Justify="Justify.SpaceBetween">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary">

        <AuthorizeView Roles="Parent">
            <MudText Typo="Typo.caption" Class="px-3 pt-2 pb-1 nav-section-header">
                @T("nav.section.main")
            </MudText>

            <MudNavLink Href="/domov"
                        Icon="@Icons.Material.Rounded.Dashboard"
                        Match="NavLinkMatch.Prefix">
                @T("nav.dashboard")
            </MudNavLink>

            <MudNavLink Href="/kalendar"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                @T("nav.calendar")
            </MudNavLink>

            <MudNavLink Href="/oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                @T("nav.announcements")
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Parent">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                @T("nav.section.athleteParent")
            </MudText>

            <MudNavLink Href="/dochadzka"
                        Icon="@Icons.Material.Rounded.EventNote"
                        Match="NavLinkMatch.Prefix">
                @T("nav.attendance")
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Child,Athlete">
            <MudText Typo="Typo.caption" Class="px-3 pt-2 pb-1 nav-section-header">
                @T("nav.section.child")
            </MudText>

            <MudNavLink Href="/dieta"
                        Icon="@Icons.Material.Rounded.Dashboard"
                        Match="NavLinkMatch.Prefix">
                @T("nav.myOverview")
            </MudNavLink>

            <MudNavLink Href="/kalendar"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                @T("nav.calendar")
            </MudNavLink>

            <MudNavLink Href="/oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                @T("nav.announcements")
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Coach">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                @T("nav.section.coach")
            </MudText>

            <MudNavLink Href="/coach"
                        Icon="@Icons.Material.Rounded.Home"
                        Match="NavLinkMatch.All">
                @T("nav.dashboard")
            </MudNavLink>

            <MudNavLink Href="/kalendar"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                @T("nav.calendar")
            </MudNavLink>

            <MudNavLink Href="/coach/tim"
                        Icon="@Icons.Material.Rounded.Groups"
                        Match="NavLinkMatch.Prefix">
                @T("nav.myTeam")
            </MudNavLink>

            @* /admin/treningy is already [Authorize(Roles = "Admin,Coach")], so a coach had access
               before this link existed, they just had no way to click through to it. /admin/ospravedlnenky
               is also Admin,Coach, but the link is deliberately left out - a coach already sees their
               team's excuses in /coach/tim, and a second entry point to the same data would only confuse. *@
            <MudNavLink Href="/admin/treningy"
                        Icon="@Icons.Material.Rounded.FitnessCenter"
                        Match="NavLinkMatch.Prefix">
                @T("nav.trainings")
            </MudNavLink>

            <MudNavLink Href="/coach/oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                @T("nav.announcements")
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                @T("nav.section.overview")
            </MudText>

            <MudNavLink Href="/admin"
                        Icon="@Icons.Material.Rounded.Dashboard"
                        Match="NavLinkMatch.All">
                @T("nav.dashboard")
            </MudNavLink>
            <MudNavLink Href="/admin/statistiky"
                        Icon="@Icons.Material.Rounded.BarChart"
                        Match="NavLinkMatch.Prefix">
                @T("nav.stats")
            </MudNavLink>

            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                @T("nav.section.users")
            </MudText>

            <MudNavLink Href="/admin/pouzivatelia"
                        Icon="@Icons.Material.Rounded.People"
                        Match="NavLinkMatch.Prefix">
                @T("nav.users")
            </MudNavLink>
            <MudNavLink Href="/admin/timy"
                        Icon="@Icons.Material.Rounded.Groups"
                        Match="NavLinkMatch.Prefix">
                @T("nav.teams")
            </MudNavLink>

            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                @T("nav.section.trainings")
            </MudText>

            <MudNavLink Href="/admin/treningy"
                        Icon="@Icons.Material.Rounded.FitnessCenter"
                        Match="NavLinkMatch.Prefix">
                @T("nav.trainings")
            </MudNavLink>
            <MudNavLink Href="/admin/sezony"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                @T("nav.seasons")
            </MudNavLink>
            <MudNavLink Href="/admin/ospravedlnenky"
                        Icon="@Icons.Material.Rounded.Description"
                        Match="NavLinkMatch.Prefix">
                @T("nav.excuses")
            </MudNavLink>

            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                @T("nav.section.communication")
            </MudText>

            <MudNavLink Href="/admin/systemove-oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                @T("nav.systemAnnouncements")
            </MudNavLink>
        </AuthorizeView>
    </MudNavMenu>

    <div>
        <MudDivider Class="mb-2" Light="true" />
        <MudNavMenu Rounded="true" Margin="Margin.Dense">
            <MudNavLink Href="/logout"
                        Icon="@Icons.Material.Rounded.Logout"
                        Match="NavLinkMatch.All"
                        ForceLoad="true"
                        Style="color: var(--zisk-logout-color);">
                @T("nav.logout")
            </MudNavLink>
        </MudNavMenu>
        <MudText Typo="Typo.caption" Align="Align.Center" Class="pa-2 nav-copyright">
            © @DateTime.UtcNow.Year ZISK
        </MudText>
    </div>
</MudStack>
