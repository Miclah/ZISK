<MudStack Class="pa-3" Style="height: 100%;" Justify="Justify.SpaceBetween">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary">

        <AuthorizeView Roles="Parent,Athlete">
            <MudText Typo="Typo.caption" Class="px-3 pt-2 pb-1 nav-section-header">
                Hlavné
            </MudText>

            <MudNavLink Href="/domov"
                        Icon="@Icons.Material.Rounded.Dashboard"
                        Match="NavLinkMatch.Prefix">
                Nástenka
            </MudNavLink>

            <MudNavLink Href="/kalendar"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                Kalendár tréningov
            </MudNavLink>

            <MudNavLink Href="/oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                Oznamy
            </MudNavLink>

            <MudNavLink Href="/profil"
                        Icon="@Icons.Material.Rounded.Person"
                        Match="NavLinkMatch.Prefix">
                Môj profil
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Parent,Athlete">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                Športovec / Rodič
            </MudText>

            <MudNavLink Href="/dochadzka/prehlad"
                        Icon="@Icons.Material.Rounded.EventNote"
                        Match="NavLinkMatch.Prefix">
                Prehľad dochádzky
            </MudNavLink>

            <MudNavLink Href="/ospravedlnenky"
                        Icon="@Icons.Material.Rounded.Description"
                        Match="NavLinkMatch.Prefix">
                Ospravedlnenky
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Child">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                Dieťa
            </MudText>

            <MudNavLink Href="/dieta"
                        Icon="@Icons.Material.Rounded.Dashboard"
                        Match="NavLinkMatch.Prefix">
                Môj prehľad
            </MudNavLink>

            <MudNavLink Href="/kalendar"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                Kalendár tréningov
            </MudNavLink>

            <MudNavLink Href="/oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                Oznamy
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Coach">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                Tréner
            </MudText>

            <MudNavLink Href="/coach"
                        Icon="@Icons.Material.Rounded.Home"
                        Match="NavLinkMatch.All">
                Nástenka
            </MudNavLink>

            <MudNavLink Href="/kalendar"
                        Icon="@Icons.Material.Rounded.CalendarMonth"
                        Match="NavLinkMatch.Prefix">
                Kalendár tréningov
            </MudNavLink>

            <MudNavLink Href="/coach/tim"
                        Icon="@Icons.Material.Rounded.Groups"
                        Match="NavLinkMatch.Prefix">
                Môj tím
            </MudNavLink>

            <MudNavLink Href="/coach/oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                Oznamy
            </MudNavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <MudDivider Class="my-2 mx-2" Light="true" />
            <MudText Typo="Typo.caption" Class="px-3 pt-1 pb-1 nav-section-header">
                Administrácia
            </MudText>

            <MudNavLink Href="/admin"
                        Icon="@Icons.Material.Rounded.Dashboard"
                        Match="NavLinkMatch.All">
                Nástenka
            </MudNavLink>
            <MudNavLink Href="/admin/pouzivatelia"
                        Icon="@Icons.Material.Rounded.People"
                        Match="NavLinkMatch.Prefix">
                Používatelia
            </MudNavLink>
            <MudNavLink Href="/admin/timy"
                        Icon="@Icons.Material.Rounded.Groups"
                        Match="NavLinkMatch.Prefix">
                Tímy
            </MudNavLink>
            <MudNavLink Href="/admin/systemove-oznamy"
                        Icon="@Icons.Material.Rounded.Announcement"
                        Match="NavLinkMatch.Prefix">
                Systémové oznamy
            </MudNavLink>
        </AuthorizeView>
    </MudNavMenu>

    <div>
        <MudDivider Class="mb-2" Light="true" />
        <MudNavMenu Rounded="true" Margin="Margin.Dense">
            <MudNavLink Href="/logout"
                        Icon="@Icons.Material.Rounded.Logout"
                        Match="NavLinkMatch.All"
                        ForceLoad="true"
                        Style="color: var(--zisk-logout-color);">
                Odhlásiť sa
            </MudNavLink>
        </MudNavMenu>
        <MudText Typo="Typo.caption" Align="Align.Center" Class="pa-2 nav-copyright">
            © 2026 ZISK
        </MudText>
    </div>
</MudStack>
