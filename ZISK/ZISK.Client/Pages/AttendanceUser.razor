@page "/dochadzka/prehlad"
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.Enums
@inject IAttendanceApi AttendanceApi
@inject IExcusesApi ExcusesApi
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]

<PageTitle>Moja dochádzka</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Rozvrh a dochádzka</MudText>

    @if (_childFilterOptions.Count > 1)
    {
        <MudPaper Elevation="0" Class="pa-2 mb-3">
            <MudToggleGroup T="string" @bind-Value="_selectedChildId" Color="Color.Primary" SelectionMode="SelectionMode.SingleSelection" CheckMark="true">
                @foreach (var opt in _childFilterOptions)
                {
                    <MudToggleItem Value="@opt.Key" Text="@opt.Label" />
                }
            </MudToggleGroup>
        </MudPaper>
    }

    <MudTabs Rounded="true" Elevation="1" Class="mb-4">
        <MudTabPanel Text="Nadchádzajúce">
            @if (_isLoading)
            {
                <MudStack Spacing="2">
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
                    }
                </MudStack>
            }
            else if (!FilteredUpcoming.Any())
            {
                <MudAlert Severity="Severity.Info">Žiadne nadchádzajúce tréningy.</MudAlert>
            }
            else
            {
                <MudStack Spacing="2" Class="pa-2">
                    @foreach (var item in FilteredUpcoming)
                    {
                        <MudPaper Class="pa-3" Elevation="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body1">@item.Training.Title</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Training.StartTime.ToString("dd.MM.yyyy HH:mm") - @item.Training.EndTime.ToString("HH:mm")</MudText>
                                    @if (!string.IsNullOrWhiteSpace(item.Training.Location))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Training.Location</MudText>
                                    }
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">Pre: @item.ForName</MudChip>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </MudTabPanel>

        <MudTabPanel Text="História">
            <MudPaper Class="pa-4 mb-4" Elevation="2">
                <MudGrid>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker @bind-Date="_dateFrom" Label="Od dátumu" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker @bind-Date="_dateTo" Label="Do dátumu" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAttendance">
                            Zobraziť
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudGrid Class="mb-4">
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="1" Class="pa-3 text-center">
                        <MudText Typo="Typo.h5" Color="Color.Success">@GetCount(AttendanceStatus.Present)</MudText>
                        <MudText Typo="Typo.body2">Prítomný</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="1" Class="pa-3 text-center">
                        <MudText Typo="Typo.h5" Color="Color.Error">@GetCount(AttendanceStatus.Absent)</MudText>
                        <MudText Typo="Typo.body2">Neospravedlnený</MudText>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="1" Class="pa-3 text-center">
                        <MudText Typo="Typo.h5" Color="Color.Warning">@GetCount(AttendanceStatus.Excused)</MudText>
                        <MudText Typo="Typo.body2">Ospravedlnený</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @if (_isLoading)
            {
                <MudStack Spacing="2">
                    @for (int i = 0; i < 4; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
                    }
                </MudStack>
            }
            else if (!FilteredAttendance.Any())
            {
                <MudPaper Class="pa-6" Elevation="1">
                    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                        Žiadne záznamy o dochádzke za vybrané obdobie
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudTable Items="@FilteredAttendance" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Dátum</MudTh>
                                <MudTh>Dieťa</MudTh>
                                <MudTh>Tréning</MudTh>
                                <MudTh>Stav</MudTh>
                                <MudTh>Poznámka trénera</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Dátum">
                                    <MudText Typo="Typo.body2">@context.Date.ToString("dd.MM.yyyy")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.Date.ToString("dddd", new System.Globalization.CultureInfo("sk-SK"))
                                    </MudText>
                                </MudTd>
                                <MudTd DataLabel="Dieťa">@context.ChildName</MudTd>
                                <MudTd DataLabel="Tréning">@context.TrainingName</MudTd>
                                <MudTd DataLabel="Stav">
                                    <MudChip T="string" Size="Size.Small" Class="@GetStatusChipClass(context.Status)">
                                        @GetStatusText(context.Status)
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Poznámka">
                                    @if (!string.IsNullOrEmpty(context.Note))
                                    {
                                        <MudText Typo="Typo.body2">@context.Note</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                </MudHidden>

                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudStack Spacing="2">
                        @foreach (var item in FilteredAttendance)
                        {
                            <MudPaper Class="pa-3" Elevation="1">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.subtitle2">@item.TrainingName</MudText>
                                        <MudChip T="string" Size="Size.Small" Class="@GetStatusChipClass(item.Status)">
                                            @GetStatusText(item.Status)
                                        </MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @item.ChildName • @item.Date.ToString("dd.MM.yyyy") • @item.Date.ToString("dddd", new System.Globalization.CultureInfo("sk-SK"))
                                    </MudText>
                                    <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(item.Note) ? "Bez poznámky trénera" : item.Note)</MudText>
                                    @if (item.Status == AttendanceStatus.Absent)
                                    {
                                        <MudStack Row="true" Justify="Justify.FlexEnd">
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                       OnClick="@(() => NavigateToExcuse())">
                                                Podať ospravedlnenku
                                            </MudButton>
                                        </MudStack>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudHidden>
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private record UpcomingItem(TrainingEventDto Training, string ForName, string TeamName, string ChildId);
    private record FilterOption(string Key, string Label);

    private const string AllChildrenKey = "all";

    private bool _isLoading = true;
    private List<UserAttendanceDto> _attendance = new();
    private List<UpcomingItem> _upcoming = new();
    private List<ChildDto> _children = new();
    private List<FilterOption> _childFilterOptions = new();
    private string _selectedChildId = AllChildrenKey;
    private DateTime? _dateFrom = DateTime.Now.AddDays(-30);
    private DateTime? _dateTo = DateTime.Now;

    private IEnumerable<UpcomingItem> FilteredUpcoming =>
        _selectedChildId == AllChildrenKey
            ? _upcoming
            : _upcoming.Where(u => u.ChildId == _selectedChildId);

    private IEnumerable<UserAttendanceDto> FilteredAttendance =>
        _selectedChildId == AllChildrenKey
            ? _attendance
            : _attendance.Where(a => a.ChildId == _selectedChildId);

    protected override async Task OnInitializedAsync()
    {
        _children = await ChildrenApi.GetMyChildrenAsync();
        BuildFilterOptions();
        await LoadUpcoming();
        await LoadAttendance();
    }

    private void BuildFilterOptions()
    {
        var realChildren = _children.Where(c => !c.IsOwnProfile).ToList();
        if (realChildren.Count <= 1)
        {
            _childFilterOptions = new();
            return;
        }

        var options = new List<FilterOption> { new(AllChildrenKey, "Všetky deti") };
        options.AddRange(realChildren
            .OrderBy(c => c.LastName).ThenBy(c => c.FirstName)
            .Select(c => new FilterOption(c.Id, c.FirstName)));
        _childFilterOptions = options;
    }

    private async Task LoadUpcoming()
    {
        try
        {
            var tasks = _children
                .Where(p => p.TeamId.HasValue)
                .Select(async p => new
                {
                    Person = p,
                    Trainings = await TrainingsApi.GetTrainingsAsync(p.TeamId, DateTime.Now, DateTime.Now.AddMonths(1))
                });

            var results = await Task.WhenAll(tasks);
            _upcoming = results
                .SelectMany(r => r.Trainings.Select(t => new UpcomingItem(t,
                    r.Person.IsOwnProfile ? "Seba" : $"{r.Person.FirstName} {r.Person.LastName}",
                    r.Person.TeamName ?? "Bez tímu",
                    r.Person.Id)))
                .OrderBy(x => x.Training.StartTime)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní rozvrhu: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadAttendance()
    {
        try
        {
            _isLoading = true;
            _attendance = await AttendanceApi.GetMyAttendanceAsync(_dateFrom, _dateTo);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private int GetCount(AttendanceStatus status) => FilteredAttendance.Count(a => a.Status == status);

    private async Task NavigateToExcuse()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>("Nová ospravedlnenka", options);
        await dialog.Result;
    }

    private Color GetStatusColor(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => Color.Success,
        AttendanceStatus.Absent => Color.Error,
        AttendanceStatus.Excused => Color.Warning,
        _ => Color.Default
    };

    private string GetStatusChipClass(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "attendance-chip-present",
        AttendanceStatus.Absent => "attendance-chip-absent",
        AttendanceStatus.Excused => "attendance-chip-excused",
        _ => string.Empty
    };

    private string GetStatusText(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "Prítomný",
        AttendanceStatus.Absent => "Neprítomný",
        AttendanceStatus.Excused => "Ospravedlnený",
        _ => "Neznámy"
    };
}
