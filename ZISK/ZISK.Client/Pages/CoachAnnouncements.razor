@page "/coach/oznamy"
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Layout
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.Enums
@inject ITeamsApi TeamsApi
@inject IAnnouncementsApi AnnouncementsApi
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Coach")]

<PageTitle>Oznamy tímu</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Large" Color="Color.Primary" />
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">Oznamy pre tím</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Informácie pre rodičov a hráčov</MudText>
        </MudStack>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenCreateDialog">Pridať oznam</MudButton>
</MudStack>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 5; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" />
        }
    </MudStack>
}
else if (!_announcements.Any())
{
    <MudAlert Severity="Severity.Info">Zatiaľ nebol vytvorený žiadny oznam.</MudAlert>
}
else
{
    <MudStack Spacing="2">
        @foreach (var ann in _announcements)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4"
                      Style="@($"border-left:3px solid {_cPrimary};")">
                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="3">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@Icons.Material.Filled.Campaign" />
                    </MudAvatar>
                    <MudStack Spacing="1" Style="flex:1; min-width:0;">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@ann.Title</MudText>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ann.PublishDate.ToString("dd.MM.yyyy HH:mm")</MudText>
                            </MudStack>
                        </MudStack>
                        <MudText Typo="Typo.body2">@ann.ContentPreview</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}
</MudContainer>

<MudDialog @bind-Visible="_createDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Nový oznam</MudText></TitleContent>
    <DialogContent>
        <EditForm Model="@_announcementModel" OnValidSubmit="CreateAnnouncement">
            <DataAnnotationsValidator />
            <MudStack Spacing="2">
                <MudTextField @bind-Value="_announcementModel.Title"
                              For="@(() => _announcementModel.Title)"
                              Label="Nadpis" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_announcementModel.Content"
                              For="@(() => _announcementModel.Content)"
                              Label="Text oznamu" Variant="Variant.Outlined" Lines="5" />
                <MudButton ButtonType="ButtonType.Submit"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           FullWidth="true">Uložiť</MudButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    private static readonly string _cPrimary = (string)AppTheme.SportClubTheme.PaletteLight.Primary;

    private bool _isLoading = true;
    private Guid? _teamId;
    private List<AnnouncementListDto> _announcements = [];

    private bool _createDialogVisible;
    private CoachAnnouncementFormModel _announcementModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var team = (await TeamsApi.GetTeamsAsync(true)).FirstOrDefault();
            if (team is null)
                return;

            _teamId = team.Id;
            _announcements = (await AnnouncementsApi.GetAnnouncementsAsync(_teamId, null))
                .OrderByDescending(a => a.PublishDate)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní oznamov: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _announcementModel = new CoachAnnouncementFormModel();
        _createDialogVisible = true;
    }

    private async Task CreateAnnouncement()
    {
        if (_teamId is null)
            return;

        try
        {
            await AnnouncementsApi.CreateAnnouncementAsync(new CreateAnnouncementRequest(
                _announcementModel.Title,
                _announcementModel.Content,
                _teamId,
                TargetAudience.All,
                AnnouncementPriority.Medium,
                false,
                null));

            _createDialogVisible = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri ukladaní oznamu: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    public class CoachAnnouncementFormModel
    {
        [Required(ErrorMessage = "Nadpis je povinný.")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Nadpis musí mať 2 – 200 znakov.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Text oznamu je povinný.")]
        [StringLength(5000, ErrorMessage = "Text môže mať max 5000 znakov.")]
        public string Content { get; set; } = string.Empty;
    }
}
