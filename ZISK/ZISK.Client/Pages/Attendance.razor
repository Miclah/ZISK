@page "/dochadzka"
@using ZISK.Client.Components
@using ZISK.Client.Components.Attendance
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.DTOs.Trainings
@inject IAttendanceApi AttendanceApi
@inject IExcusesApi ExcusesApi
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Parent,Athlete")]

<PageTitle>Dochádzka</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
    <PageHeader Icon="@Icons.Material.Rounded.EventNote" Title="Dochádzka" Class="mb-3">
        <Actions>
            @if (_canCreateExcuse)
            {
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Rounded.Add"
                               OnClick="OpenCreateExcuseDialog">
                        Nová ospravedlnenka
                    </MudButton>
                </MudHidden>
            }
        </Actions>
    </PageHeader>

    @if (_childFilterOptions.Count > 1)
    {
        <MudPaper Elevation="0" Class="pa-2 mb-3">
            <MudToggleGroup T="string" Value="_selectedChildId" ValueChanged="OnSelectedChildChanged"
                            Color="Color.Primary"
                            SelectionMode="SelectionMode.SingleSelection" CheckMark="true">
                @foreach (var opt in _childFilterOptions)
                {
                    <MudToggleItem @key="opt.Key" Value="@opt.Key" Text="@opt.Label" />
                }
            </MudToggleGroup>
        </MudPaper>
    }

    <MudTabs @bind-ActivePanelIndex="_activeTab" Rounded="true" Elevation="0" PanelClass="pt-4"
             ApplyEffectsToContainer="true" Class="card-standard">
        <MudTabPanel Text="Prehľad" Icon="@Icons.Material.Rounded.Dashboard">
            <AttendanceOverviewTab IsLoading="_isLoading"
                                   Upcoming="_filteredUpcoming"
                                   Attendance="_filteredAttendance" />
        </MudTabPanel>

        <MudTabPanel Text="História" Icon="@Icons.Material.Rounded.History">
            <AttendanceHistoryTab IsLoading="_isLoading"
                                  CanCreateExcuse="_canCreateExcuse"
                                  Records="_filteredAttendance"
                                  @bind-DateFrom="_dateFrom"
                                  @bind-DateTo="_dateTo"
                                  OnFilter="LoadAttendance"
                                  OnCreateExcuse="OpenCreateExcuseDialog" />
        </MudTabPanel>

        <MudTabPanel Text="Ospravedlnenky" Icon="@Icons.Material.Rounded.Description">
            <AttendanceExcusesTab IsLoading="_isLoadingExcuses"
                                  CanManage="_canCreateExcuse"
                                  Error="_excusesError"
                                  Excuses="_filteredExcuses"
                                  OnCreate="OpenCreateExcuseDialog"
                                  OnEdit="OpenEditExcuseDialog"
                                  OnDelete="DeleteExcuse" />
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@if (_canCreateExcuse)
{
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudFab StartIcon="@Icons.Material.Rounded.Add" Color="Color.Primary"
                OnClick="OpenCreateExcuseDialog" Class="dochadzka-fab" />
    </MudHidden>
}

<style>
    .dochadzka-fab {
        position: fixed;
        right: 20px;
        bottom: 90px;
        z-index: 1201;
    }
</style>

@code {
    private record FilterOption(string Key, string Label);

    private const string AllChildrenKey = "all";

    private bool _isLoading = true;
    private bool _isLoadingExcuses = true;
    private string? _excusesError;
    private bool _canCreateExcuse = true;
    private int _activeTab;

    private List<UserAttendanceDto> _attendance = new();
    private List<AttendanceOverviewTab.UpcomingItem> _upcoming = new();
    private List<ExcuseListDto> _excuses = new();
    private List<ChildDto> _children = new();
    private List<FilterOption> _childFilterOptions = new();
    private string _selectedChildId = AllChildrenKey;
    private DateTime? _dateFrom = DateTime.Now.AddDays(-30);
    private DateTime? _dateTo = DateTime.Now;
    private bool _openCreateOnLoad;

    // Materialized whenever the source data or the selected child changes. These feed three tabs and the
    // overview counters, so as lazy IEnumerables they were re-filtered several times on every render.
    private List<AttendanceOverviewTab.UpcomingItem> _filteredUpcoming = new();
    private List<UserAttendanceDto> _filteredAttendance = new();
    private List<ExcuseListDto> _filteredExcuses = new();

    private void ApplyChildFilter()
    {
        var all = _selectedChildId == AllChildrenKey;

        _filteredUpcoming = all ? _upcoming : _upcoming.Where(u => u.ChildId == _selectedChildId).ToList();
        _filteredAttendance = all ? _attendance : _attendance.Where(a => a.ChildId == _selectedChildId).ToList();
        _filteredExcuses = all ? _excuses : _excuses.Where(e => e.ChildId == _selectedChildId).ToList();
    }

    private void OnSelectedChildChanged(string value)
    {
        _selectedChildId = value;
        ApplyChildFilter();
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canCreateExcuse = !authState.User.IsInRole("Child");

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = uri.Query;
        _activeTab = ResolveInitialTab(query);
        _openCreateOnLoad = QueryHasFlag(query, "create");

        _children = await ChildrenApi.GetMyChildrenAsync();
        BuildFilterOptions();

        await LoadAttendance();
        await LoadUpcoming();
        await LoadExcuses();
    }

    // Dialog must be opened in OnAfterRenderAsync, not OnInitializedAsync —
    // MudBlazor dialogs require the component tree to be fully rendered before ShowAsync works correctly.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _openCreateOnLoad && _canCreateExcuse)
        {
            _openCreateOnLoad = false;
            await OpenCreateExcuseDialog();
            NavigationManager.NavigateTo(NavigationManager.Uri.Split('?')[0], replace: true); // strip ?create from URL after opening so a page refresh does not re-open the dialog
        }
    }

    private void BuildFilterOptions()
    {
        // IsOwnProfile=true means the user is an Athlete viewing their own profile as a "child" entry — exclude them from the parent's child filter list.
        var realChildren = _children.Where(c => !c.IsOwnProfile).ToList();
        if (realChildren.Count <= 1)
        {
            _childFilterOptions = new(); // only one child — no filter needed, skip the selector entirely
            return;
        }

        var options = new List<FilterOption> { new(AllChildrenKey, "Všetky deti") };
        options.AddRange(realChildren
            .OrderBy(c => c.LastName).ThenBy(c => c.FirstName)
            .Select(c => new FilterOption(c.Id, c.FirstName)));
        _childFilterOptions = options;
    }

    private async Task LoadUpcoming()
    {
        try
        {
            var tasks = _children
                .Where(p => p.TeamId.HasValue)
                .Select(async p => new
                {
                    Person = p,
                    Trainings = await TrainingsApi.GetTrainingsAsync(p.TeamId, DateTime.Now, DateTime.Now.AddMonths(1))
                });

            var results = await Task.WhenAll(tasks);
            _upcoming = results
                .SelectMany(r => r.Trainings.Select(t => new AttendanceOverviewTab.UpcomingItem(t,
                    r.Person.IsOwnProfile ? "Seba" : $"{r.Person.FirstName} {r.Person.LastName}",
                    r.Person.TeamName ?? "Bez tímu",
                    r.Person.Id)))
                .OrderBy(x => x.Training.StartTime)
                .ToList();

            ApplyChildFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní rozvrhu: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    private async Task LoadAttendance()
    {
        try
        {
            _isLoading = true;
            _attendance = await AttendanceApi.GetMyAttendanceAsync(_dateFrom, _dateTo);
            ApplyChildFilter();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadExcuses()
    {
        try
        {
            _isLoadingExcuses = true;
            _excusesError = null;
            _excuses = await ExcusesApi.GetMyExcusesAsync();
            ApplyChildFilter();
        }
        catch (Exception ex)
        {
            _excusesError = ApiErrorFormatter.ToUserMessage(ex);
        }
        finally
        {
            _isLoadingExcuses = false;
        }
    }

    private async Task OpenCreateExcuseDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>("Nová ospravedlnenka", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadExcuses();
            await LoadAttendance();
        }
    }

    private async Task OpenEditExcuseDialog(ExcuseListDto excuse)
    {
        ExcuseDto detail;
        try
        {
            detail = await ExcusesApi.GetExcuseAsync(excuse.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní ospravedlnenky: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
            return;
        }

        var parameters = new DialogParameters { [nameof(EditExcuseDialog.Excuse)] = detail };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditExcuseDialog>("Upraviť ospravedlnenku", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadExcuses();
        }
    }

    private async Task DeleteExcuse(Guid id)
    {
        try
        {
            await ExcusesApi.DeleteExcuseAsync(id);
            Snackbar.Add("Ospravedlnenka vymazaná", Severity.Success);
            await LoadExcuses();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    private static int ResolveInitialTab(string query)
    {
        var tab = ReadQueryValue(query, "tab");
        return tab?.ToLowerInvariant() switch
        {
            "history" or "historia" => 1,
            "excuses" or "ospravedlnenky" => 2,
            _ => 0
        };
    }

    private static bool QueryHasFlag(string query, string key)
    {
        var v = ReadQueryValue(query, key);
        return v is not null && v.Equals("true", StringComparison.OrdinalIgnoreCase);
    }

    private static string? ReadQueryValue(string query, string key)
    {
        if (string.IsNullOrWhiteSpace(query)) return null;
        var trimmed = query.TrimStart('?');
        foreach (var part in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kvp = part.Split('=', 2);
            if (kvp.Length == 2 && kvp[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return kvp[1];
        }
        return null;
    }
}
