@page "/admin/treningy"
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.Enums
@attribute [Authorize(Roles = "Admin,Coach")]

<PageTitle>Správa tréningov</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
<MudText Typo="Typo.h4" Class="mb-4">Správa tréningov</MudText>

<MudTabs Elevation="1" Rounded="true" PanelClass="pa-3">
    <MudTabPanel Text="Jednorazové tréningy">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Tréningy</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenDialog(null))">Nový tréning</MudButton>
        </MudStack>

        @if (_isLoading)
        {
            <MudStack Spacing="2">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                }
            </MudStack>
        }
        else
        {
            <MudTable Items="@_trainings" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Dátum</MudTh>
                    <MudTh>Názov</MudTh>
                    <MudTh>Tím</MudTh>
                    <MudTh>Typ</MudTh>
                    <MudTh>Akcie</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Dátum">@context.StartTime.ToString("dd.MM.yyyy HH:mm")</MudTd>
                    <MudTd DataLabel="Názov">@context.Title</MudTd>
                    <MudTd DataLabel="Tím">@context.TeamName</MudTd>
                    <MudTd DataLabel="Typ">
                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)">@GetTypeText(context.Type)</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Akcie">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenDialog(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(context.Id))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Opakované tréningy">
        <TrainingSeriesManager IsAdmin="true" />
    </MudTabPanel>
</MudTabs>
</MudContainer>

<MudDialog @bind-Visible="_dialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>@(_editingId.HasValue ? "Upraviť tréning" : "Nový tréning")</TitleContent>
    <DialogContent>
        <EditForm Model="@_trainingModel" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudSelect T="Guid?" @bind-Value="_trainingModel.TeamId"
                           For="@(() => _trainingModel.TeamId)"
                           Label="Tím" Variant="Variant.Outlined">
                    @foreach (var team in _teams)
                    {
                        <MudSelectItem Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_trainingModel.Title"
                              For="@(() => _trainingModel.Title)"
                              Label="Názov" Variant="Variant.Outlined" />
                <MudDatePicker @bind-Date="_trainingModel.StartDate"
                               For="@(() => _trainingModel.StartDate)"
                               Label="Dátum" Variant="Variant.Outlined" />
                <MudTimePicker @bind-Time="_trainingModel.StartTime"
                               For="@(() => _trainingModel.StartTime)"
                               Label="Začiatok" Variant="Variant.Outlined" />
                <MudTimePicker @bind-Time="_trainingModel.EndTime"
                               For="@(() => _trainingModel.EndTime)"
                               Label="Koniec" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_trainingModel.Location"
                              For="@(() => _trainingModel.Location)"
                              Label="Miesto" Variant="Variant.Outlined" />
                <MudSelect T="TrainingType" @bind-Value="_trainingModel.Type" Label="Typ" Variant="Variant.Outlined">
                    <MudSelectItem Value="TrainingType.Conditioning">Kondičný</MudSelectItem>
                    <MudSelectItem Value="TrainingType.Technical">Technický</MudSelectItem>
                    <MudSelectItem Value="TrainingType.Match">Herný</MudSelectItem>
                    <MudSelectItem Value="TrainingType.Recovery">Regeneračný</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_trainingModel.CoachNote"
                              For="@(() => _trainingModel.CoachNote)"
                              Label="Poznámka" Variant="Variant.Outlined" Lines="2" />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true">Uložiť</MudButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

