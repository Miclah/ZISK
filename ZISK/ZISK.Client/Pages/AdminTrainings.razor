@page "/admin/treningy"
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.Enums
@attribute [Authorize(Roles = "Admin,Coach")]

<PageTitle>Správa tréningov</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Spacing="2" Wrap="Wrap.Wrap">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">Správa tréningov</MudText>
    </MudStack>
    @if (_activeTab == 0)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            Nový tréning
        </MudButton>
    }
</MudStack>

<MudPaper Elevation="1" Class="pa-2">
    <MudTabs @bind-ActivePanelIndex="_activeTab"
             Rounded="true"
             ApplyEffectsToContainer="true"
             PanelClass="pa-3"
             AlwaysShowScrollButtons="false">
        <MudTabPanel Text="Jednorazové" Icon="@Icons.Material.Filled.Event">
            @if (_isLoading)
            {
                <MudStack Spacing="2">
                    @for (int i = 0; i < 6; i++)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                    }
                </MudStack>
            }
            else if (!_trainings.Any())
            {
                <MudPaper Class="pa-8" Elevation="0" Outlined="true">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Default" />
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Zatiaľ neexistujú žiadne tréningy.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Vytvoriť prvý tréning
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            else
            {
                @* Filtre *@
                <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.FilterList" Color="Color.Secondary" />
                        <MudSelect T="Guid?" Value="_filterTeamId"
                                   ValueChanged="@(v => { _filterTeamId = v; OnFilterChanged(); })"
                                   Label="Tím" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Style="min-width: 180px;" Clearable="true">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">Všetky tímy</MudSelectItem>
                            @foreach (var team in _teams)
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="TrainingType?" Value="_filterType"
                                   ValueChanged="@(v => { _filterType = v; OnFilterChanged(); })"
                                   Label="Typ" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Style="min-width: 160px;" Clearable="true">
                            <MudSelectItem T="TrainingType?" Value="@((TrainingType?)null)">Všetky typy</MudSelectItem>
                            <MudSelectItem T="TrainingType?" Value="@((TrainingType?)TrainingType.Conditioning)">Kondičný</MudSelectItem>
                            <MudSelectItem T="TrainingType?" Value="@((TrainingType?)TrainingType.Technical)">Technický</MudSelectItem>
                            <MudSelectItem T="TrainingType?" Value="@((TrainingType?)TrainingType.Match)">Herný</MudSelectItem>
                            <MudSelectItem T="TrainingType?" Value="@((TrainingType?)TrainingType.Recovery)">Regeneračný</MudSelectItem>
                            <MudSelectItem T="TrainingType?" Value="@((TrainingType?)TrainingType.Other)">Iný</MudSelectItem>
                        </MudSelect>
                        @if (_filterTeamId is not null || _filterType is not null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Clear"
                                       OnClick="@(() => { _filterTeamId = null; _filterType = null; OnFilterChanged(); })">
                                Vyčistiť
                            </MudButton>
                        }
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @FilteredTrainings.Count() z @_trainings.Count
                        </MudText>
                    </MudStack>
                </MudPaper>

                @* Desktop: tabulka *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTable Items="@FilteredTrainings"
                              Hover="true"
                              Elevation="0">
                        <HeaderContent>
                            <MudTh>Dátum</MudTh>
                            <MudTh>Názov</MudTh>
                            <MudTh>Tím</MudTh>
                            <MudTh>Typ</MudTh>
                            <MudTh Style="text-align: right;">Akcie</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2"><strong>@context.StartTime.ToString("dd.MM.yyyy")</strong></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @context.StartTime.ToString("HH:mm") – @context.EndTime.ToString("HH:mm")
                                    </MudText>
                                </MudStack>
                            </MudTd>
                            <MudTd>@context.Title</MudTd>
                            <MudTd>@context.TeamName</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)">
                                    @GetTypeText(context.Type)
                                </MudChip>
                            </MudTd>
                            <MudTd Style="text-align: right;">
                                <MudTooltip Text="Upraviť">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="@(() => OpenEditDialog(context))" />
                                </MudTooltip>
                                <MudTooltip Text="Vymazať">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Color="Color.Error"
                                                   OnClick="@(() => ConfirmDeleteAsync(context))" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager RowsPerPageString="Riadkov na stranu:" InfoFormat="{first_item}–{last_item} z {all_items}" PageSizeOptions="new[] { 10, 25, 50 }" />
                        </PagerContent>
                    </MudTable>
                </MudHidden>

                @* Mobile: karty *@
                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                    <MudStack Spacing="2">
                        @{
                            var mobileList = FilteredTrainings.Take(_mobileShown).ToList();
                            var totalFiltered = FilteredTrainings.Count();
                        }
                        @if (totalFiltered == 0)
                        {
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                                    Žiadne tréningy nezodpovedajú filtru.
                                </MudText>
                            </MudPaper>
                        }
                        @foreach (var training in mobileList)
                        {
                            <MudPaper Class="pa-3" Elevation="1" Style="@($"border-left: 4px solid {GetTypeBorderColor(training.Type)};")">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle2"><strong>@training.Title</strong></MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@training.TeamName</MudText>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(training.Type)">
                                            @GetTypeText(training.Type)
                                        </MudChip>
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.body2">@training.StartTime.ToString("dd.MM.yyyy")</MudText>
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Color="Color.Default" Class="ml-2" />
                                        <MudText Typo="Typo.body2">@training.StartTime.ToString("HH:mm") – @training.EndTime.ToString("HH:mm")</MudText>
                                    </MudStack>
                                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="@(() => OpenEditDialog(training))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => ConfirmDeleteAsync(training))" />
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                        @if (totalFiltered > _mobileShown)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.ExpandMore"
                                       OnClick="LoadMoreMobile">
                                Načítať ďalšie (@(totalFiltered - _mobileShown))
                            </MudButton>
                        }
                    </MudStack>
                </MudHidden>
            }
        </MudTabPanel>

        <MudTabPanel Text="Opakované" Icon="@Icons.Material.Filled.Repeat">
            <TrainingSeriesManager IsAdmin="true" />
        </MudTabPanel>
    </MudTabs>
</MudPaper>
</MudContainer>
