@page "/dieta/{ChildId}"
@using ZISK.Client.Components.Children
@using ZISK.Client.Services
@using ZISK.Client.Components
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Children
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.Enums
@inject IChildrenApi ChildrenApi
@inject IAttendanceApi AttendanceApi
@inject IExcusesApi ExcusesApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Parent,Admin,Coach")]

<PageTitle>Detail dieťaťa</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (_isLoading)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" />
            <MudStack Spacing="2">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                }
            </MudStack>
        </MudStack>
    }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Error">Dieťa nebolo nájdené.</MudAlert>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-4">
            <MudStack Spacing="0" Style="min-width:0;">
                <MudText Typo="Typo.h5">@_detail.FirstName @_detail.LastName</MudText>
                @if (!string.IsNullOrWhiteSpace(_detail.TeamName))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Tím: @_detail.TeamName</MudText>
                }
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick='() => NavigationManager.NavigateTo("/domov")'>Späť</MudButton>
        </MudStack>

        <ChildInfoCard Detail="_detail" Age="_age" OnEdit="OpenEditDialog" />

        <ChildAttendanceCard Stats="_stats"
                             Records="_attendance"
                             @bind-From="_attendanceFrom"
                             @bind-To="_attendanceTo"
                             OnReload="LoadAttendance" />

        <ChildExcusesCard Excuses="_excuses" />

        <ChildParentsCard Parents="_parents"
                          CanInvite="_canManageParents"
                          CallerId="@_callerId"
                          IsAdmin="_isAdmin"
                          OnInvite="OpenInviteDialog"
                          OnRemove="ConfirmRemoveParent" />
    }
</MudContainer>

@code {
    [Parameter]
    public string ChildId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _isLoading = true;
    private ChildDetailDto? _detail;
    private int? _age;
    private List<ParentDto> _parents = new();
    private List<UserAttendanceDto> _attendance = new();
    private List<ExcuseListDto> _excuses = new();
    private AttendanceStatsDto? _stats;
    private DateTime? _attendanceFrom = DateTime.Now.AddMonths(-3);
    private DateTime? _attendanceTo = DateTime.Now;
    private string? _callerId;
    private bool _isAdmin;
    private bool _canManageParents;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _callerId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = state.User.IsInRole("Admin");
        _canManageParents = _isAdmin || state.User.IsInRole("Parent");

        await LoadAll();
    }

    private async Task LoadAll()
    {
        _isLoading = true;
        try
        {
            _detail = await ChildrenApi.GetDetailAsync(ChildId);
            _age = CalculateAge(_detail?.DateOfBirth);
            _parents = await ChildrenApi.GetParentsAsync(ChildId);
            await LoadAttendance();
            await LoadExcuses();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAttendance()
    {
        try
        {
            _stats = await AttendanceApi.GetMemberStatsAsync(ChildId, _attendanceFrom, _attendanceTo);
            var all = await AttendanceApi.GetMyAttendanceAsync(_attendanceFrom, _attendanceTo);
            _attendance = all.Where(a => a.ChildId == ChildId).ToList();
        }
        catch { }
    }

    private async Task LoadExcuses()
    {
        try
        {
            var all = await ExcusesApi.GetMyExcusesAsync();
            _excuses = all.Where(e => e.ChildId == ChildId).ToList();
        }
        catch { }
    }

    private int? CalculateAge(DateOnly? dob)
    {
        if (!dob.HasValue)
            return null;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Value.Year;
        if (dob.Value > today.AddYears(-age))
            age--;
        return age;
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(EditChildDialog.ChildId)] = ChildId
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditChildDialog>("Upraviť dieťa", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await LoadAll();
    }

    private async Task OpenInviteDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(InviteParentDialog.ChildId)] = ChildId
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<InviteParentDialog>("Pozvať rodiča", parameters, options);
    }

    private async Task ConfirmRemoveParent(ParentDto parent)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Odstrániť väzbu",
            $"Naozaj chcete odstrániť rodiča '{parent.FirstName} {parent.LastName}' od tohto dieťaťa?",
            yesText: "Áno, odstrániť",
            cancelText: "Zrušiť",
            options: new DialogOptions { MaxWidth = MaxWidth.Small });

        if (confirmed != true)
            return;

        try
        {
            await ChildrenApi.RemoveParentAsync(ChildId, parent.UserId);
            Snackbar.Add("Väzba bola odstránená.", Severity.Success);
            await LoadAll();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }






}
