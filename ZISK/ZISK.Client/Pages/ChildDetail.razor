@page "/dieta/{ChildId}"
@using ZISK.Client.Services
@using ZISK.Client.Components
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Children
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.Enums
@inject IChildrenApi ChildrenApi
@inject IAttendanceApi AttendanceApi
@inject IExcusesApi ExcusesApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Parent,Admin,Coach")]

<PageTitle>Detail dieťaťa</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    @if (_isLoading)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" />
            <MudStack Spacing="2">
                @for (int i = 0; i < 6; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                }
            </MudStack>
        </MudStack>
    }
    else if (_detail is null)
    {
        <MudAlert Severity="Severity.Error">Dieťa nebolo nájdené.</MudAlert>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5">@_detail.FirstName @_detail.LastName</MudText>
                @if (!string.IsNullOrWhiteSpace(_detail.TeamName))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Tím: @_detail.TeamName</MudText>
                }
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick='() => NavigationManager.NavigateTo("/domov")'>Späť</MudButton>
        </MudStack>

        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">Základné informácie</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="OpenEditDialog">
                            Upraviť dieťa
                        </MudButton>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Dátum narodenia</MudText>
                        <MudText Typo="Typo.body2">@(_detail.DateOfBirth?.ToString("dd.MM.yyyy") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Vek</MudText>
                        <MudText Typo="Typo.body2">@(_age?.ToString() ?? "-") @(_age.HasValue ? "rokov" : "")</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Bydlisko</MudText>
                        <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(_detail.Bydlisko) ? "-" : _detail.Bydlisko)</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Tím</MudText>
                        <MudText Typo="Typo.body2">@(_detail.TeamName ?? "Bez tímu")</MudText>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">Dochádzka</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudDatePicker @bind-Date="_attendanceFrom" Label="Od" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudDatePicker @bind-Date="_attendanceTo" Label="Do" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudButton OnClick="LoadAttendance" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Zobraziť</MudButton>
                        </MudStack>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (_stats is not null)
                {
                    <MudGrid Class="mb-3">
                        <MudItem xs="4">
                            <MudPaper Elevation="0" Class="pa-2 text-center">
                                <MudText Typo="Typo.h6" Color="Color.Success">@_stats.Present</MudText>
                                <MudText Typo="Typo.caption">Prítomný</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">
                            <MudPaper Elevation="0" Class="pa-2 text-center">
                                <MudText Typo="Typo.h6" Color="Color.Error">@_stats.Absent</MudText>
                                <MudText Typo="Typo.caption">Neprítomný</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="4">
                            <MudPaper Elevation="0" Class="pa-2 text-center">
                                <MudText Typo="Typo.h6" Color="Color.Warning">@_stats.Excused</MudText>
                                <MudText Typo="Typo.caption">Ospravedlnený</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                }

                @if (!_attendance.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Žiadne záznamy za vybrané obdobie.</MudText>
                }
                else
                {
                    <MudTable Items="@_attendance" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Dátum</MudTh>
                            <MudTh>Tréning</MudTh>
                            <MudTh>Stav</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Date.ToString("dd.MM.yyyy")</MudTd>
                            <MudTd>@context.TrainingName</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Class="@GetStatusChipClass(context.Status)">
                                    @GetStatusText(context.Status)
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1">Ospravedlnenky</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (!_excuses.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Žiadne ospravedlnenky.</MudText>
                }
                else
                {
                    <MudTable Items="@_excuses" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Dátum</MudTh>
                            <MudTh>Dôvod</MudTh>
                            <MudTh>Stav</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@FormatDateRange(context.DateFrom, context.DateTo)</MudTd>
                            <MudTd>@(string.IsNullOrWhiteSpace(context.Reason) ? "-" : context.Reason)</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Status</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="1" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">Rodičia</MudText>
                        @if (_canManageParents)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenInviteDialog">
                                Pozvať ďalšieho rodiča
                            </MudButton>
                        }
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (!_parents.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Default">Žiadni rodičia nie sú priradení.</MudText>
                }
                else
                {
                    <MudStack Spacing="2">
                        @foreach (var parent in _parents)
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Spacing="0">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body1">@parent.FirstName @parent.LastName</MudText>
                                            @if (parent.IsPrimary)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">Primárny</MudChip>
                                            }
                                        </MudStack>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@parent.Email</MudText>
                                    </MudStack>
                                    @if (_callerId == parent.UserId || _isAdmin)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => ConfirmRemoveParent(parent))"
                                                       Title="Odstrániť väzbu" />
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    public string ChildId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool _isLoading = true;
    private ChildDetailDto? _detail;
    private int? _age;
    private List<ParentDto> _parents = new();
    private List<UserAttendanceDto> _attendance = new();
    private List<ExcuseListDto> _excuses = new();
    private AttendanceStatsDto? _stats;
    private DateTime? _attendanceFrom = DateTime.Now.AddMonths(-3);
    private DateTime? _attendanceTo = DateTime.Now;
    private string? _callerId;
    private bool _isAdmin;
    private bool _canManageParents;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        _callerId = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = state.User.IsInRole("Admin");
        _canManageParents = _isAdmin || state.User.IsInRole("Parent");

        await LoadAll();
    }

    private async Task LoadAll()
    {
        _isLoading = true;
        try
        {
            _detail = await ChildrenApi.GetDetailAsync(ChildId);
            _age = CalculateAge(_detail?.DateOfBirth);
            _parents = await ChildrenApi.GetParentsAsync(ChildId);
            await LoadAttendance();
            await LoadExcuses();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAttendance()
    {
        try
        {
            _stats = await AttendanceApi.GetMemberStatsAsync(ChildId, _attendanceFrom, _attendanceTo);
            var all = await AttendanceApi.GetMyAttendanceAsync(_attendanceFrom, _attendanceTo);
            _attendance = all.Where(a => a.ChildId == ChildId).ToList();
        }
        catch { }
    }

    private async Task LoadExcuses()
    {
        try
        {
            var all = await ExcusesApi.GetMyExcusesAsync();
            _excuses = all.Where(e => e.ChildId == ChildId).ToList();
        }
        catch { }
    }

    private int? CalculateAge(DateOnly? dob)
    {
        if (!dob.HasValue)
            return null;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Value.Year;
        if (dob.Value > today.AddYears(-age))
            age--;
        return age;
    }

    private async Task OpenEditDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(EditChildDialog.ChildId)] = ChildId
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditChildDialog>("Upraviť dieťa", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await LoadAll();
    }

    private async Task OpenInviteDialog()
    {
        var parameters = new DialogParameters
        {
            [nameof(InviteParentDialog.ChildId)] = ChildId
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<InviteParentDialog>("Pozvať rodiča", parameters, options);
    }

    private async Task ConfirmRemoveParent(ParentDto parent)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Odstrániť väzbu",
            $"Naozaj chcete odstrániť rodiča '{parent.FirstName} {parent.LastName}' od tohto dieťaťa?",
            yesText: "Áno, odstrániť",
            cancelText: "Zrušiť",
            options: new DialogOptions { MaxWidth = MaxWidth.Small });

        if (confirmed != true)
            return;

        try
        {
            await ChildrenApi.RemoveParentAsync(ChildId, parent.UserId);
            Snackbar.Add("Väzba bola odstránená.", Severity.Success);
            await LoadAll();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    private Color GetStatusColor(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => Color.Success,
        AttendanceStatus.Absent => Color.Error,
        AttendanceStatus.Excused => Color.Warning,
        _ => Color.Default
    };

    private string GetStatusChipClass(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "attendance-chip-present",
        AttendanceStatus.Absent => "attendance-chip-absent",
        AttendanceStatus.Excused => "attendance-chip-excused",
        _ => string.Empty
    };

    private string GetStatusText(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "Prítomný",
        AttendanceStatus.Absent => "Neprítomný",
        AttendanceStatus.Excused => "Ospravedlnený",
        _ => "Neznámy"
    };

    private static string FormatDateRange(DateTime? from, DateTime? to)
    {
        if (from.HasValue && to.HasValue)
            return $"{from.Value:dd.MM.yyyy} - {to.Value:dd.MM.yyyy}";
        if (from.HasValue)
            return from.Value.ToString("dd.MM.yyyy");
        return "-";
    }
}
