@page "/admin/statistiky"
@inherits LocalizedComponentBase
@using ZISK.Client.Components
@using ZISK.Client.Components.Stats
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Stats
@inject IStatsApi StatsApi
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@T("admin.stats.pageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<PageHeader Icon="@Icons.Material.Filled.Insights" Title="@T("admin.stats.title")">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAllAsync"
                   Disabled="_isLoading">
            @T("admin.stats.refresh")
        </MudButton>
    </Actions>
</PageHeader>

@if (_isLoading)
{
    <MudGrid Spacing="3" Class="mb-4">
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
            </MudItem>
        }
    </MudGrid>
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="320px" />
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("admin.stats.activeTeams")"
                      Value="@($"{_dashboardStats?.ActiveTeams} / {_dashboardStats?.TotalTeams}")"
                      Icon="@Icons.Material.Filled.Groups" IconColor="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("admin.stats.activeMembers")"
                      Value="@(_dashboardStats?.ActiveMembers.ToString() ?? "0")"
                      Caption="@string.Format(T("admin.stats.ofTotalSuffix"), _dashboardStats?.TotalMembers)"
                      Icon="@Icons.Material.Filled.EmojiPeople" IconColor="Color.Secondary" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("dashboard.admin.averageAttendance")"
                      Value="@($"{_attendanceStats?.PresentPercent ?? 0}%")"
                      Caption="@string.Format(T("admin.stats.forDaysSuffix"), _selectedDays)"
                      Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("admin.stats.pendingExcuses")"
                      Value="@(_dashboardStats?.PendingExcuses.ToString() ?? "0")"
                      Icon="@Icons.Material.Filled.EventBusy"
                      IconColor="@(_dashboardStats?.PendingExcuses > 0 ? Color.Warning : Color.Default)" />
        </MudItem>
    </MudGrid>

    <StatsPeriodSelector SelectedDays="_selectedDays" SelectedDaysChanged="SelectPeriodAsync" />

    <MudGrid>
        <MudItem xs="12" md="7">
            <TeamStatsTable Teams="_teamStats" />
        </MudItem>

        <MudItem xs="12" md="5">
            <AttendanceDistributionPanel Stats="_attendanceStats" />
        </MudItem>

        <MudItem xs="12" md="6">
            <TeamRankingPanel Teams="_teamStats"
                              Title="@T("admin.stats.topTeamsByAttendance")"
                              Icon="@Icons.Material.Filled.EmojiEvents"
                              IconColor="Color.Success"
                              BestFirst="true" />
        </MudItem>

        <MudItem xs="12" md="6">
            <TeamRankingPanel Teams="_teamStats"
                              Title="@T("admin.stats.lowestAttendanceTeams")"
                              Icon="@Icons.Material.Filled.TrendingDown"
                              IconColor="Color.Error"
                              BestFirst="false" />
        </MudItem>

        <MudItem xs="12">
            <TrainingTypeBreakdownPanel Types="_trainingTypes" />
        </MudItem>

    </MudGrid>
}
</MudContainer>

@code {
    // Cached theme hex values — avoids re-instantiating MudTheme on each render
    private static readonly string _cPrimary   = (string)AppTheme.SportClubTheme.PaletteLight.Primary;

    private bool _isLoading = true;
    private string? _error;
    private int _selectedDays = 30;

    private readonly int[] _periods = new[] { 7, 30, 90, 365 };

    private DashboardStatsDto? _dashboardStats;
    private List<TeamStatsDto> _teamStats = new();
    private AttendanceStatsDto? _attendanceStats;
    private List<TrainingTypeStatDto> _trainingTypes = new();
    private List<AttendanceTrendPointDto> _attendanceTrend = new();

    private List<ChartSeries<double>> _trendSeries = new();
    private string[] _trendLabels = Array.Empty<string>();

    private int _trendAverage;
    private int _trendMin;
    private int _trendMax;
    private int? _trendDelta;

    private LineChartOptions _trendChartOptions = default!;

    protected override async Task OnInitializedAsync()
    {
        _trendChartOptions = new LineChartOptions
        {
            ChartPalette = new[] { _cPrimary },
            LineStrokeWidth = 2,
            InterpolationOption = InterpolationOption.NaturalSpline,
            XAxisLines = false,
            YAxisLines = false,
            YAxisTicks = 50
        };
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        try
        {
            _isLoading = true;
            _error = null;

            var dashboardTask = StatsApi.GetDashboardStatsAsync();
            var teamsTask = StatsApi.GetTeamStatsAsync();
            var attendanceTask = StatsApi.GetAttendanceStatsAsync(_selectedDays);
            var typesTask = StatsApi.GetTrainingTypeStatsAsync(_selectedDays);
            var trendTask = StatsApi.GetAttendanceTrendAsync(_selectedDays);

            await Task.WhenAll(dashboardTask, teamsTask, attendanceTask, typesTask, trendTask);

            _dashboardStats = await dashboardTask;
            _teamStats = await teamsTask;
            _attendanceStats = await attendanceTask;
            _trainingTypes = await typesTask;
            _attendanceTrend = await trendTask;
            BuildTrendSeries();
        }
        catch (Exception ex)
        {
            _error = ApiErrorFormatter.ToUserMessage(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectPeriodAsync(int days)
    {
        if (_selectedDays == days) return;
        _selectedDays = days;
        try
        {
            var attendanceTask = StatsApi.GetAttendanceStatsAsync(_selectedDays);
            var typesTask = StatsApi.GetTrainingTypeStatsAsync(_selectedDays);
            var trendTask = StatsApi.GetAttendanceTrendAsync(_selectedDays);
            await Task.WhenAll(attendanceTask, typesTask, trendTask);
            _attendanceStats = await attendanceTask;
            _trainingTypes = await typesTask;
            _attendanceTrend = await trendTask;
            BuildTrendSeries();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    private void BuildTrendSeries()
    {
        if (!_attendanceTrend.Any())
        {
            _trendSeries = new();
            _trendLabels = Array.Empty<string>();
            _trendAverage = _trendMin = _trendMax = 0;
            _trendDelta = null;
            return;
        }

        var values = _attendanceTrend.Select(p => (double)p.PresentPercent).ToArray();
        _trendAverage = (int)Math.Round(values.Average());
        _trendMin = (int)Math.Round(values.Min());
        _trendMax = (int)Math.Round(values.Max());

        if (values.Length >= 4)
        {
            var half = values.Length / 2;
            var prev = values.Take(half).Average();
            var curr = values.Skip(half).Average();
            _trendDelta = (int)Math.Round(curr - prev);
        }
        else
        {
            _trendDelta = null;
        }

        _trendLabels = new string[values.Length];
        Array.Fill(_trendLabels, string.Empty);

        _trendSeries = new()
        {
            new ChartSeries<double>
            {
                Name = string.Empty,
                Data = values
            }
        };
    }






}
