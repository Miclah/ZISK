@page "/admin"
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Stats
@inject IExcusesApi ExcusesApi
@inject IStatsApi StatsApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Nástenka administrátora</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h4">Nástenka (Dashboard)</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDashboardData">
        Obnoviť dáta
    </MudButton>
</MudStack>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_dashboardStats != null)
{
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center cursor-pointer" Elevation="3" Style="border-left: 4px solid var(--mud-palette-info);" @onclick='() => NavigateTo("/admin/pouzivatelia")'>
                <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Large" Color="Color.Info" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Celkový počet členov</MudText>
                    <MudText Typo="Typo.h4">@_dashboardStats.TotalUsers</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center cursor-pointer" Elevation="3" Style="border-left: 4px solid var(--mud-palette-primary);" @onclick='() => NavigateTo("/admin/timy")'>
                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Primary" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Počet aktívnych tímov</MudText>
                    <MudText Typo="Typo.h4">@_dashboardStats.ActiveTeams</MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4 d-flex align-center cursor-pointer" Elevation="3" Style="border-left: 4px solid var(--mud-palette-success);" @onclick='() => NavigateTo("/admin/pouzivatelia")'>
                <MudIcon Icon="@Icons.Material.Filled.Sports" Size="Size.Large" Color="Color.Success" Class="mr-4" />
                <div>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">Počet trénerov</MudText>
                    <MudText Typo="Typo.h4">@_dashboardStats.TotalCoaches</MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-5" Elevation="3" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4">Posledná aktivita v systéme</MudText>
                
                @if (_dashboardStats.RecentActivities != null && _dashboardStats.RecentActivities.Any())
                {
                    <MudTable Items="@_dashboardStats.RecentActivities" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Dátum</MudTh>
                            <MudTh>Popis</MudTh>
                            <MudTh>Typ</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Dátum">@context.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                            <MudTd DataLabel="Popis">@context.Description</MudTd>
                            <MudTd DataLabel="Typ">
                                @if (context.Type == "User")
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Používateľ</MudChip>
                                }
                                else if (context.Type == "Team")
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">Tím</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Zatiaľ žiadna aktivita.</MudText>
                }
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-5" Elevation="3" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4">Rýchle akcie</MudText>
                <MudStack Spacing="3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" FullWidth="true" Href="/admin/pouzivatelia" Style="justify-content: flex-start; padding: 12px;">
                        Pridať používateľa
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.GroupAdd" FullWidth="true" Href="/admin/timy" Style="justify-content: flex-start; padding: 12px;">
                        Vytvoriť nový tím
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Announcement" FullWidth="true" Href="/oznamy" Style="justify-content: flex-start; padding: 12px;">
                        Zverejniť globálny oznam
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _isLoading = true;
    private DashboardStatsDto? _dashboardStats;
    private List<TeamStatsDto> _teamStats = new();

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Domov", href: "/"),
        new BreadcrumbItem("Administrácia", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            _isLoading = true;
            var dashboardTask = StatsApi.GetDashboardStatsAsync();
            var teamStatsTask = StatsApi.GetTeamStatsAsync();

            await Task.WhenAll(dashboardTask, teamStatsTask);

            _dashboardStats = await dashboardTask;
            _teamStats = await teamStatsTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní štatistík: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}