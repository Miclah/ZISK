@page "/admin"
@inherits LocalizedComponentBase
@using ZISK.Client.Components
@using ZISK.Client.Components.Dashboard
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Stats
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.DTOs.Users
@inject IExcusesApi ExcusesApi
@inject IStatsApi StatsApi
@inject IUsersApi UsersApi
@inject ITrainingsApi TrainingsApi
@inject IAnnouncementsApi AnnouncementsApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@T("dashboard.admin.pageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<PageHeader Icon="@Icons.Material.Filled.Dashboard" Title="@T("dashboard.admin.title")">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDashboardData">
            @T("dashboard.admin.refreshData")
        </MudButton>
    </Actions>
</PageHeader>

@if (_isLoading)
{
    <MudGrid Spacing="3" Class="mb-4">
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
            </MudItem>
        }
    </MudGrid>
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
}
else if (_dashboardStats != null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("dashboard.admin.totalMembers")"
                      Value="@_dashboardStats.TotalMembers.ToString()"
                      Icon="@Icons.Material.Filled.PeopleAlt"
                      IconColor="Color.Primary"
                      OnClick='() => NavigateTo("/admin/pouzivatelia")' />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("dashboard.admin.activeTeams")"
                      Value="@_dashboardStats.ActiveTeams.ToString()"
                      Icon="@Icons.Material.Filled.Groups"
                      IconColor="Color.Success"
                      OnClick='() => NavigateTo("/admin/timy")' />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("dashboard.admin.coachCount")"
                      Value="@_coachCount.ToString()"
                      Icon="@Icons.Material.Filled.Sports"
                      IconColor="Color.Info"
                      OnClick='() => NavigateTo("/admin/pouzivatelia")' />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="@T("dashboard.admin.userAccounts")"
                      Value="@_dashboardStats.TotalUsers.ToString()"
                      Icon="@Icons.Material.Filled.Person"
                      IconColor="Color.Secondary"
                      OnClick='() => NavigateTo("/admin/pouzivatelia")' />
        </MudItem>
    </MudGrid>

    <MudGrid Class="mb-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-5" Elevation="2" Style="height: 100%;">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.InsertChart" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@T("dashboard.admin.thisWeek")</MudText>
                </MudStack>

                <MudStack Spacing="0">
                    <MetricRow Icon="@Icons.Material.Filled.FitnessCenter"
                               Label="@T("dashboard.admin.trainingsMetric")"
                               Caption="@T("dashboard.admin.currentWeekCaption")"
                               Value="@_weeklyTrainings.ToString()"
                               IconColor="Color.Primary" />
                    <MudDivider />
                    <MetricRow Icon="@Icons.Material.Filled.HowToReg"
                               Label="@T("dashboard.admin.averageAttendance")"
                               Value="@($"{_weeklyAttendance}%")"
                               IconColor="Color.Success"
                               Progress="_weeklyAttendance" />
                    <MudDivider />
                    <MetricRow Icon="@Icons.Material.Filled.Description"
                               Label="@T("dashboard.admin.excusesMetric")"
                               Caption="@T("dashboard.admin.currentWeekCaption")"
                               Value="@_weeklyExcuses.ToString()"
                               IconColor="Color.Warning" />
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <UpcomingTrainingsPanel Trainings="_upcomingTrainings"
                                    OnShowAll='() => NavigateTo("/admin/treningy")' />
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="7">
            <LatestUsersPanel Users="_latestUsers" />
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-5" Elevation="2" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-2">@T("dashboard.admin.quickActions")</MudText>
                <MudList T="string" Dense="true" Clickable="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PersonAdd" OnClick='() => NavigateTo("/admin/pouzivatelia?action=create")'>
                        @T("dashboard.admin.addUser")
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.GroupAdd" OnClick='() => NavigateTo("/admin/timy?action=create")'>
                        @T("dashboard.admin.createTeam")
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Campaign" OnClick='() => NavigateTo("/admin/systemove-oznamy?action=create")'>
                        @T("dashboard.admin.publishAnnouncement")
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.FitnessCenter" OnClick='() => NavigateTo("/admin/treningy?action=create")'>
                        @T("dashboard.admin.createTraining")
                    </MudListItem>
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-2">
        <MudItem xs="12">
            <RecentAnnouncementsPanel Announcements="_recentAnnouncements"
                                      OnShowAll='() => NavigateTo("/admin/systemove-oznamy")' />
        </MudItem>
    </MudGrid>
}
</MudContainer>

@code {
    private bool _isLoading = true;
    private DashboardStatsDto? _dashboardStats;
    private List<TeamStatsDto> _teamStats = new();
    private List<UserListDto> _latestUsers = new();
    private int _coachCount;

    private List<TrainingEventDto> _upcomingTrainings = new();
    private List<AnnouncementListDto> _recentAnnouncements = new();
    private int _weeklyTrainings;
    private int _weeklyAttendance;
    private int _weeklyExcuses;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            _isLoading = true;
            var dashboardTask = StatsApi.GetDashboardStatsAsync();
            var teamStatsTask = StatsApi.GetTeamStatsAsync();
            var usersTask = UsersApi.GetUsersAsync();
            var coachesTask = UsersApi.GetUsersAsync("Coach");
            var now = DateTime.Now;
            // .NET DayOfWeek starts on Sunday (0). This formula shifts the week to start on Monday:
            // Sunday gets -6 offset (back to previous Monday); all other days get +1 offset.
            var weekStart = now.Date.AddDays(-(int)now.DayOfWeek + (now.DayOfWeek == DayOfWeek.Sunday ? -6 : 1));
            var weekEnd = weekStart.AddDays(7);
            var trainingsTask = TrainingsApi.GetTrainingsAsync(null, weekStart, now.AddDays(7));
            var announcementsTask = AnnouncementsApi.GetAnnouncementsAsync(null, null);
            var excusesTask = ExcusesApi.GetExcusesAsync();

            await Task.WhenAll(dashboardTask, teamStatsTask, usersTask, coachesTask, trainingsTask, announcementsTask, excusesTask);

            _dashboardStats = await dashboardTask;
            _teamStats = await teamStatsTask;
            _coachCount = (await coachesTask).Count;
            var allUsers = await usersTask;
            _latestUsers = allUsers
                .OrderByDescending(u => u.CreatedAt)
                .Take(5)
                .ToList();

            var allTrainings = await trainingsTask;
            _weeklyTrainings = allTrainings.Count(t => t.StartTime >= weekStart && t.StartTime < weekEnd);
            // Average across all teams; if no team stats exist, default to 0 to avoid DivideByZeroException from .Average() on empty sequence.
            _weeklyAttendance = _teamStats.Any()
                ? (int)Math.Round(_teamStats.Average(ts => (double)ts.AverageAttendance))
                : 0;

            var allExcuses = await excusesTask;
            _weeklyExcuses = allExcuses.Count(e => e.CreatedAt >= weekStart && e.CreatedAt < weekEnd);

            _upcomingTrainings = allTrainings
                .Where(t => t.StartTime >= now)
                .OrderBy(t => t.StartTime)
                .Take(5)
                .ToList();

            _recentAnnouncements = (await announcementsTask)
                .OrderByDescending(a => a.PublishDate)
                .Take(3)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("dashboard.admin.errorLoadingStats")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }
}
