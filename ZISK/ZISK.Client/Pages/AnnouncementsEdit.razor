@page "/oznamy/upravit/{Id:guid}"
@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.Enums
@using ZISK.Client.Display
@inject IAnnouncementsApi AnnouncementsApi
@inject ITeamsApi TeamsApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Admin,Coach")]

<PageTitle>@T("announcementForm.editTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@T("announcementForm.editTitle")</MudText>

    @if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_announcement == null)
{
    <MudAlert Severity="Severity.Error">@T("announcementForm.notFound")</MudAlert>
}
else
{
    <MudPaper Class="pa-4" Elevation="2">
        <EditForm Model="@_model" OnValidSubmit="Submit">
            <LocalizedDataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_model.Title"
                              For="@(() => _model.Title)"
                              Label="@T("coachAnnouncements.headingLabel")" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.Content"
                              For="@(() => _model.Content)"
                              Label="@T("admin.announcements.contentLabel")" Variant="Variant.Outlined" Lines="5" />

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="Guid?" @bind-Value="_model.TargetTeamId" Label="@T("dashboard.team")" Variant="Variant.Outlined" Clearable="true">
                            @foreach (var team in _teams)
                            {
                                <MudSelectItem Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="TargetAudience" @bind-Value="_model.TargetAudience" Label="@T("announcementForm.targetAudienceLabel")" Variant="Variant.Outlined">
                            <MudSelectItem Value="TargetAudience.All">@T("announcementForm.audience.all")</MudSelectItem>
                            <MudSelectItem Value="TargetAudience.Parents">@T("announcementForm.audience.parents")</MudSelectItem>
                            <MudSelectItem Value="TargetAudience.Athletes">@T("announcementForm.audience.athletes")</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="AnnouncementPriority" @bind-Value="_model.Priority" Label="@T("announcements.priorityFilterLabel")" Variant="Variant.Outlined">
                            <MudSelectItem Value="AnnouncementPriority.Low">@DomainLabels.PriorityText(AnnouncementPriority.Low)</MudSelectItem>
                            <MudSelectItem Value="AnnouncementPriority.Medium">@DomainLabels.PriorityText(AnnouncementPriority.Medium)</MudSelectItem>
                            <MudSelectItem Value="AnnouncementPriority.High">@DomainLabels.PriorityText(AnnouncementPriority.High)</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker @bind-Date="_model.ValidUntil" Label="@T("announcements.validUntil")" Variant="Variant.Outlined" Clearable="true" />
                    </MudItem>
                </MudGrid>

                <MudCheckBox @bind-Value="_model.IsPinned" Label="@T("announcementForm.pin")" Color="Color.Primary" />

                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Text" Href="/oznamy">@T("admin.users.cancel")</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@_isSubmitting">
                        @if (_isSubmitting) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                        @T("admin.users.save")
                    </MudButton>
                </MudStack>
            </MudStack>
        </EditForm>
    </MudPaper>
}
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private AnnouncementDto? _announcement;
    private List<TeamDto> _teams = new();
    private AnnouncementEditFormModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _teams = await TeamsApi.GetTeamsAsync(true);
            _announcement = await AnnouncementsApi.GetAnnouncementAsync(Id);
            if (_announcement != null)
            {
                _model = new AnnouncementEditFormModel
                {
                    Title = _announcement.Title,
                    Content = _announcement.Content,
                    TargetTeamId = _announcement.TargetTeamId,
                    TargetAudience = _announcement.TargetAudience,
                    Priority = _announcement.Priority,
                    IsPinned = _announcement.IsPinned,
                    ValidUntil = _announcement.ValidUntil
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        try
        {
            var request = new UpdateAnnouncementRequest(_model.Title, _model.Content, _model.TargetTeamId, _model.TargetAudience, _model.Priority, _model.IsPinned, _model.ValidUntil);
            await AnnouncementsApi.UpdateAnnouncementAsync(Id, request);
            Snackbar.Add(T("announcementForm.updated"), Severity.Success);
            NavigationManager.NavigateTo("/oznamy");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class AnnouncementEditFormModel
    {
        [Required(ErrorMessage = "Nadpis je povinný.")]
        [StringLength(200, MinimumLength = 2, ErrorMessage = "Nadpis musí mať 2 – 200 znakov.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Obsah je povinný.")]
        [StringLength(5000, ErrorMessage = "Obsah môže mať max 5000 znakov.")]
        public string Content { get; set; } = string.Empty;

        public Guid? TargetTeamId { get; set; }
        public TargetAudience TargetAudience { get; set; } = TargetAudience.All;
        public AnnouncementPriority Priority { get; set; } = AnnouncementPriority.Medium;
        public bool IsPinned { get; set; } = false;
        public DateTime? ValidUntil { get; set; }
    }
}
