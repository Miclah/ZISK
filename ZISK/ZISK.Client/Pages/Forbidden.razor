@page "/nepovolene"
@inherits ZISK.Client.Components.LocalizedComponentBase
@layout MainLayout
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>@T("forbidden.pageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8 text-center" Elevation="2">
        <MudIcon Icon="@Icons.Material.Rounded.Block" Color="Color.Error" Size="Size.Large" Class="mb-4" Style="font-size: 4rem;" />
        <MudText Typo="Typo.h4" Class="mb-2">@T("forbidden.pageTitle")</MudText>
        <MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
            @T("forbidden.text")
        </MudText>
        <MudStack Row="true" Justify="Justify.Center" Spacing="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo("/"))">
                @T("forbidden.home")
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true))">
                @T("admin.stats.refresh")
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
