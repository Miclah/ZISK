@page "/admin/sezony"
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Seasons
@inject ISeasonsApi SeasonsApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Správa sezón</PageTitle>

<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">Správa sezón</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        Nová sezóna
    </MudButton>
</MudStack>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_seasons.Count == 0)
{
    <MudText Color="Color.Secondary">Žiadne sezóny.</MudText>
}
else
{
    <MudTable Items="_seasons" Hover="true" Striped="true" Dense="true">
        <HeaderContent>
            <MudTh>Názov</MudTh>
            <MudTh>Od</MudTh>
            <MudTh>Do</MudTh>
            <MudTh>Stav</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.StartDate.ToString("d.M.yyyy")</MudTd>
            <MudTd>@context.EndDate.ToString("d.M.yyyy")</MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Aktívna</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Neaktívna</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudStack Row="true" Spacing="1">
                    @if (!context.IsActive)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success"
                                       Size="Size.Small" Title="Aktivovať"
                                       OnClick="() => ActivateAsync(context.Id)" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                   Size="Size.Small" Title="Upraviť"
                                   OnClick="() => OpenEditDialog(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   Size="Size.Small" Title="Odstrániť"
                                   OnClick="() => DeleteAsync(context.Id)" />
                </MudStack>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Create / Edit dialog *@
<MudDialog @bind-Visible="_dialogOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editSeason is null ? "Nová sezóna" : "Upraviť sezónu")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.Name" Label="Názov" Required="true" />
        <MudDatePicker @bind-Date="_startDateNullable" Label="Dátum od" Required="true" />
        <MudDatePicker @bind-Date="_endDateNullable" Label="Dátum do" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogOpen = false">Zrušiť</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Uložiť</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<SeasonDto> _seasons = [];
    private bool _isLoading = true;
    private bool _dialogOpen;
    private SeasonDto? _editSeason;
    private SeasonFormModel _form = new();
    private DateTime? _startDateNullable;
    private DateTime? _endDateNullable;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Domov", "/admin"),
        new("Sezóny", null, disabled: true)
    ];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try { _seasons = await SeasonsApi.GetSeasonsAsync(); }
        catch { Snackbar.Add("Nepodarilo sa načítať sezóny.", Severity.Error); }
        finally { _isLoading = false; }
    }

    private void OpenCreateDialog()
    {
        _editSeason = null;
        _form = new();
        _startDateNullable = null;
        _endDateNullable = null;
        _dialogOpen = true;
    }

    private void OpenEditDialog(SeasonDto season)
    {
        _editSeason = season;
        _form = new SeasonFormModel { Name = season.Name };
        _startDateNullable = season.StartDate.ToDateTime(TimeOnly.MinValue);
        _endDateNullable = season.EndDate.ToDateTime(TimeOnly.MinValue);
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || _startDateNullable is null || _endDateNullable is null)
        {
            Snackbar.Add("Vyplňte všetky povinné polia.", Severity.Warning);
            return;
        }

        var startDate = DateOnly.FromDateTime(_startDateNullable.Value);
        var endDate = DateOnly.FromDateTime(_endDateNullable.Value);

        try
        {
            if (_editSeason is null)
            {
                await SeasonsApi.CreateSeasonAsync(new CreateSeasonRequest(_form.Name, startDate, endDate));
                Snackbar.Add("Sezóna vytvorená.", Severity.Success);
            }
            else
            {
                await SeasonsApi.UpdateSeasonAsync(_editSeason.Id, new UpdateSeasonRequest(_form.Name, startDate, endDate));
                Snackbar.Add("Sezóna uložená.", Severity.Success);
            }
            _dialogOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ActivateAsync(Guid id)
    {
        try
        {
            await SeasonsApi.ActivateSeasonAsync(id);
            Snackbar.Add("Sezóna aktivovaná.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Odstrániť sezónu",
            "Naozaj chcete odstrániť túto sezónu?",
            yesText: "Odstrániť", cancelText: "Zrušiť");
        if (confirmed != true) return;

        try
        {
            await SeasonsApi.DeleteSeasonAsync(id);
            Snackbar.Add("Sezóna odstránená.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private class SeasonFormModel
    {
        public string Name { get; set; } = "";
    }
}
