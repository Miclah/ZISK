@page "/admin/sezony"
@inherits LocalizedComponentBase
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Seasons
@inject ISeasonsApi SeasonsApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@T("admin.seasons.pageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<PageHeader Icon="@Icons.Material.Filled.CalendarMonth" Title="@T("admin.seasons.pageTitle")">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            @T("admin.seasons.newSeason")
        </MudButton>
    </Actions>
</PageHeader>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 5; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        }
    </MudStack>
}
else
{
    @if (ActiveSeason is not null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCardContent Class="flex-grow-1">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Color="Color.Default">@T("admin.seasons.activeSeason")</MudText>
                                <MudText Typo="Typo.h5">@ActiveSeason.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @ActiveSeason.StartDate.ToString("d.M.yyyy") – @ActiveSeason.EndDate.ToString("d.M.yyyy")
                                </MudText>
                            </MudStack>
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="opacity: 0.35;" />
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudCard Elevation="2" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCardContent Class="flex-grow-1">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Default">@T("admin.seasons.duration")</MudText>
                            <MudText Typo="Typo.h5">@SeasonWeeks(ActiveSeason) @T("admin.seasons.weeksSuffix")</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudCard Elevation="2" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCardContent Class="flex-grow-1">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Default">@T("admin.seasons.remaining")</MudText>
                            <MudText Typo="Typo.h5">@DaysRemaining(ActiveSeason) @T("admin.seasons.daysSuffix")</MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="12" md="4">
                <MudCard Elevation="2" Class="d-flex flex-column" Style="height: 100%;">
                    <MudCardContent Class="flex-grow-1">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.body2" Color="Color.Default">@T("admin.seasons.progress")</MudText>
                            <MudProgressLinear Color="Color.Primary"
                                               Value="@SeasonProgress(ActiveSeason)"
                                               Class="my-2"
                                               Rounded="true"
                                               Size="Size.Large" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @SeasonProgress(ActiveSeason).ToString("F0")% @T("admin.seasons.playedSuffix")
                            </MudText>
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    @if (_seasons.Count == 0)
    {
        <MudPaper Class="pa-8" Elevation="0" Outlined="true">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.body1" Color="Color.Secondary">@T("admin.seasons.noSeasonsYet")</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateDialog">
                    @T("admin.seasons.createFirst")
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="2" Class="pa-3">
            <MudTable Items="_seasons" Hover="true" Striped="true" Dense="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>@T("admin.trainings.table.name")</MudTh>
                    <MudTh>@T("admin.seasons.table.from")</MudTh>
                    <MudTh>@T("admin.seasons.table.to")</MudTh>
                    <MudTh>@T("admin.seasons.table.length")</MudTh>
                    <MudTh>@T("dashboard.child.status")</MudTh>
                    <MudTh Style="text-align: right;">@T("attendance.excuses.actions")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@T("admin.trainings.table.name")"><strong>@context.Name</strong></MudTd>
                    <MudTd DataLabel="@T("admin.seasons.table.from")">@context.StartDate.ToString("d.M.yyyy")</MudTd>
                    <MudTd DataLabel="@T("admin.seasons.table.to")">@context.EndDate.ToString("d.M.yyyy")</MudTd>
                    <MudTd DataLabel="@T("admin.seasons.table.length")">@SeasonWeeks(context) @T("admin.seasons.weeksAbbrev")</MudTd>
                    <MudTd DataLabel="@T("dashboard.child.status")">
                        @{
                            var status = GetStatus(context);
                        }
                        <MudChip T="string" Color="@status.Color" Size="Size.Small">@status.Label</MudChip>
                    </MudTd>
                    <MudTd DataLabel="@T("attendance.excuses.actions")" Style="text-align: right;">
                        <MudStack Row="true" Spacing="0" Justify="Justify.FlexEnd">
                            @if (!context.IsActive)
                            {
                                <MudTooltip Text="@T("admin.seasons.activateTooltip")">
                                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success"
                                                   Size="Size.Small"
                                                   OnClick="() => ActivateAsync(context.Id)" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@T("admin.seasons.duplicateTooltip")">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary"
                                               Size="Size.Small"
                                               OnClick="() => OpenDuplicateDialog(context)" />
                            </MudTooltip>
                            <MudTooltip Text="@T("admin.trainings.editTooltip")">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="() => OpenEditDialog(context)" />
                            </MudTooltip>
                            <MudTooltip Text="@T("admin.seasons.removeTooltip")">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="() => DeleteAsync(context.Id)" />
                            </MudTooltip>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}
</MudContainer>

@* Create / Edit dialog *@
<MudDialog @bind-Visible="_dialogOpen" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editSeason is null ? T("admin.seasons.newSeason") : T("admin.seasons.editSeason"))</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Name" Label="@T("admin.trainings.table.name")" Required="true" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="_startDateNullable" Label="@T("admin.seasons.dateFrom")" Required="true" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="_endDateNullable" Label="@T("admin.seasons.dateTo")" Required="true" Variant="Variant.Outlined" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _dialogOpen = false)">@T("admin.users.cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@T("admin.users.save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<SeasonDto> _seasons = [];
    private bool _isLoading = true;
    private bool _dialogOpen;
    private SeasonDto? _editSeason;
    private SeasonFormModel _form = new();
    private DateTime? _startDateNullable;
    private DateTime? _endDateNullable;

    private SeasonDto? ActiveSeason => _seasons.FirstOrDefault(s => s.IsActive);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try { _seasons = await SeasonsApi.GetSeasonsAsync(); }
        catch { Snackbar.Add(T("admin.seasons.errorLoading"), Severity.Error); }
        finally { _isLoading = false; }
    }

    private void OpenCreateDialog()
    {
        _editSeason = null;
        _form = new();
        _startDateNullable = null;
        _endDateNullable = null;
        _dialogOpen = true;
    }

    private void OpenEditDialog(SeasonDto season)
    {
        _editSeason = season;
        _form = new SeasonFormModel { Name = season.Name };
        _startDateNullable = season.StartDate.ToDateTime(TimeOnly.MinValue);
        _endDateNullable = season.EndDate.ToDateTime(TimeOnly.MinValue);
        _dialogOpen = true;
    }

    private void OpenDuplicateDialog(SeasonDto source)
    {
        // Vytvori novu sezonu predvyplnenu hodnotami zo zdrojovej, posunutu na koniec povodnej
        _editSeason = null;
        _form = new SeasonFormModel { Name = $"{source.Name} {T("admin.seasons.copySuffix")}" };
        var span = source.EndDate.DayNumber - source.StartDate.DayNumber;
        var newStart = source.EndDate.AddDays(1);
        var newEnd = newStart.AddDays(span);
        _startDateNullable = newStart.ToDateTime(TimeOnly.MinValue);
        _endDateNullable = newEnd.ToDateTime(TimeOnly.MinValue);
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || _startDateNullable is null || _endDateNullable is null)
        {
            Snackbar.Add(T("admin.seasons.fillRequiredFields"), Severity.Warning);
            return;
        }

        var startDate = DateOnly.FromDateTime(_startDateNullable.Value);
        var endDate = DateOnly.FromDateTime(_endDateNullable.Value);

        try
        {
            if (_editSeason is null)
            {
                await SeasonsApi.CreateSeasonAsync(new CreateSeasonRequest(_form.Name, startDate, endDate));
                Snackbar.Add(T("admin.seasons.created"), Severity.Success);
            }
            else
            {
                await SeasonsApi.UpdateSeasonAsync(_editSeason.Id, new UpdateSeasonRequest(_form.Name, startDate, endDate));
                Snackbar.Add(T("admin.seasons.saved"), Severity.Success);
            }
            _dialogOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.ToUserMessage(ex), Severity.Error);
        }
    }

    private async Task ActivateAsync(Guid id)
    {
        try
        {
            await SeasonsApi.ActivateSeasonAsync(id);
            Snackbar.Add(T("admin.seasons.activated"), Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.ToUserMessage(ex), Severity.Error);
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            T("admin.seasons.removeSeasonTitle"),
            T("admin.seasons.removeConfirmText"),
            yesText: T("admin.seasons.removeTooltip"), cancelText: T("admin.users.cancel"));
        if (confirmed != true) return;

        try
        {
            await SeasonsApi.DeleteSeasonAsync(id);
            Snackbar.Add(T("admin.seasons.removed"), Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ApiErrorFormatter.ToUserMessage(ex), Severity.Error);
        }
    }

    private static int SeasonWeeks(SeasonDto s)
    {
        var days = s.EndDate.DayNumber - s.StartDate.DayNumber;
        return Math.Max(0, (int)Math.Round(days / 7.0));
    }

    private static int DaysRemaining(SeasonDto s)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (today >= s.EndDate) return 0;
        return s.EndDate.DayNumber - today.DayNumber;
    }

    private static double SeasonProgress(SeasonDto s)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var total = s.EndDate.DayNumber - s.StartDate.DayNumber;
        if (total <= 0) return 0;
        var elapsed = today.DayNumber - s.StartDate.DayNumber;
        return Math.Clamp(elapsed * 100.0 / total, 0, 100);
    }

    private (Color Color, string Label) GetStatus(SeasonDto s)
    {
        if (s.IsActive) return (Color.Success, T("trainingSeries.active"));
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (today < s.StartDate) return (Color.Info, T("admin.seasons.status.planned"));
        if (today > s.EndDate) return (Color.Default, T("admin.seasons.status.finished"));
        return (Color.Default, T("trainingSeries.inactive"));
    }

    private class SeasonFormModel
    {
        public string Name { get; set; } = "";
    }
}
