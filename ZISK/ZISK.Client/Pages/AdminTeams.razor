@page "/admin/timy"
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Users
@inject ITeamsApi TeamsApi
@inject IUsersApi UsersApi
@inject IChildrenApi ChildrenApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Správa tímov</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">Správa tímov</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        Vytvoriť nový tím
    </MudButton>
</MudStack>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 5; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        }
    </MudStack>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var team in _teams)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="rounded-lg hover-effect" Style="height: 100%; border-top: 4px solid var(--mud-palette-primary);">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@team.Name</MudText>
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @if (!string.IsNullOrWhiteSpace(team.ShortName))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Class="ml-auto">@team.ShortName</MudChip>
                                }
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="() => OpenEditDialog(team)">Upraviť názov</MudMenuItem>
                                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteTeam(team)">Zmazať tím</MudMenuItem>
                                </MudMenu>
                            </MudStack>
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex align-center mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.Sports" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">Tréneri: @(GetCoachNamesForTeam(team.Id))</MudText>
                        </div>
                        <div class="d-flex align-center mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">Členovia: @team.MemberCount</MudText>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(team.Description))
                        {
                            <div class="d-flex align-start mt-2">
                                <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-2 mt-1" Color="Color.Secondary" />
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@team.Description</MudText>
                            </div>
                        }
                    </MudCardContent>
                    <MudCardActions Class="justify-end">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => OpenRosterDialog(team.Id)">
                            Spravovať súpisku
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
        
        @if (!_teams.Any())
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info">Žiadne tímy. Vytvorte prvý tím kliknutím na tlačidlo vyššie.</MudAlert>
            </MudItem>
        }
    </MudGrid>
}
</MudContainer>

<MudDialog @bind-Visible="_editDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isCreating ? "Vytvoriť nový tím" : "Upraviť tím")</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_teamModel" OnValidSubmit="SaveTeam">
            <DataAnnotationsValidator />
            <MudStack Spacing="3" Class="py-2">
                <MudTextField @bind-Value="_teamModel.Name"
                              For="@(() => _teamModel.Name)"
                              Label="Názov tímu"
                              Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_teamModel.SelectedCoachId" Label="Priradený tréner" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var coach in _coaches)
                    {
                        <MudSelectItem Value="@coach.Id">@coach.FirstName @coach.LastName</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_teamModel.ShortName"
                              For="@(() => _teamModel.ShortName)"
                              Label="Skratka (voliteľné)"
                              Variant="Variant.Outlined"
                              MaxLength="50" />
                <MudTextField @bind-Value="_teamModel.Description"
                              For="@(() => _teamModel.Description)"
                              Label="Popis"
                              Variant="Variant.Outlined"
                              Lines="3" />
                <LoadingButton ButtonType="ButtonType.Submit"
                              Color="Color.Primary"
                              Variant="Variant.Filled"
                              Loading="_isSaving"
                              FullWidth="true">
                    Uložiť
                </LoadingButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

<MudDialog @bind-Visible="_rosterDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Spravovanie súpisky: @_rosterTeamName</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoadingRoster)
        {
            <MudStack Spacing="2">
                @for (int i = 0; i < 4; i++)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
                }
            </MudStack>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1" Style="height: 400px; display: grid; grid-template-rows: auto auto 1fr; overflow: hidden;">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Dostupní / v iných tímoch</MudText>
                        <MudTextField @bind-Value="_rosterSearch" Label="Hľadať" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
                        <div style="overflow-y: auto; min-height: 0;">
                            @{
                                var filtered = _availableChildren.Where(c => string.IsNullOrEmpty(_rosterSearch) || $"{c.FirstName} {c.LastName}".Contains(_rosterSearch, StringComparison.OrdinalIgnoreCase)).ToList();
                            }
                            @if (!filtered.Any())
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">Žiadni dostupní hráči</MudText>
                            }
                            @foreach (var child in filtered)
                            {
                                <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="() => AddChildToTeam(child)"
                                           Style="justify-content: space-between; text-transform: none; height: 40px; padding: 0 8px;">
                                    <MudText Typo="Typo.body2">@child.FirstName @child.LastName</MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" />
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1" Style="height: 400px; display: grid; grid-template-rows: auto 1fr; overflow: hidden;">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Aktuálna súpiska tímu (@_rosterMembers.Count)</MudText>
                        <div style="overflow-y: auto; min-height: 0;">
                            @if (!_rosterMembers.Any())
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">Tím je momentálne prázdny</MudText>
                            }
                            @foreach (var member in _rosterMembers)
                            {
                                <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Default"
                                           OnClick="() => RemoveChildFromTeam(member)"
                                           Style="justify-content: space-between; text-transform: none; height: 40px; padding: 0 8px;">
                                    <MudText Typo="Typo.body2">@member.FirstName @member.LastName</MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" Color="Color.Error" />
                                </MudButton>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
</MudDialog>

@code {
    private bool _isLoading = true;
    private string? _error;
    private List<TeamDto> _teams = new();
    private List<UserListDto> _coaches = new();

    private bool _editDialogVisible = false;
    private bool _isCreating = true;
    private bool _isSaving = false;
    private TeamDto? _selectedTeam;

    private TeamFormModel _teamModel = new();

    private bool _rosterDialogVisible = false;
    private bool _isLoadingRoster = false;
    private Guid _rosterTeamId;
    private string _rosterTeamName = "";
    private string _rosterSearch = "";
    private List<TeamMemberDto> _rosterMembers = new();
    private List<ChildDto> _availableChildren = new();
    private List<ChildDto> _allChildren = new();

protected override async Task OnInitializedAsync()
    {
        await LoadData();
        // Deep-link support: navigating to this page with ?action=create opens the create dialog automatically (same pattern as AdminTrainings).
        if (NavigationManager.Uri.Contains("action=create", StringComparison.OrdinalIgnoreCase))
            OpenCreateDialog();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _error = null;
            
            var teamsTask = TeamsApi.GetTeamsAsync(null);
            var usersTask = UsersApi.GetUsersAsync("Coach");
            
            await Task.WhenAll(teamsTask, usersTask);
            
            _teams = await teamsTask;
            _coaches = await usersTask;
        }
        catch (Exception ex)
        {
            _error = "Nepodarilo sa načítať dáta: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetCoachNamesForTeam(Guid teamId)
    {
        var coaches = _coaches
            .Where(u => u.Teams.Any(t => t.TeamId == teamId))
            .Select(u => $"{u.FirstName} {u.LastName}")
            .ToList();

        return coaches.Any() ? string.Join(", ", coaches) : "Nepriradený";
    }

    private void OpenCreateDialog()
    {
        _isCreating = true;
        _selectedTeam = null;
        _teamModel = new TeamFormModel();
        _editDialogVisible = true;
    }

    private void OpenEditDialog(TeamDto team)
    {
        _isCreating = false;
        _selectedTeam = team;
        _teamModel = new TeamFormModel
        {
            Name = team.Name,
            ShortName = team.ShortName,
            Description = team.Description,
            SelectedCoachId = _coaches.FirstOrDefault(c => c.Teams.Any(t => t.TeamId == team.Id))?.Id
        };
        _editDialogVisible = true;
    }

    private async Task SaveTeam()
    {
        _isSaving = true;
        try
        {
            if (_isCreating)
            {
                var createdTeam = await TeamsApi.CreateTeamAsync(new CreateTeamRequest(_teamModel.Name, _teamModel.ShortName, _teamModel.Description));
                await SyncTeamCoachAssignment(createdTeam.Id);
                Snackbar.Add("Tím bol vytvorený", Severity.Success);
            }
            else if (_selectedTeam != null)
            {
                await TeamsApi.UpdateTeamAsync(_selectedTeam.Id, new UpdateTeamRequest(_teamModel.Name, _teamModel.ShortName, _teamModel.Description, true));
                await SyncTeamCoachAssignment(_selectedTeam.Id);
                Snackbar.Add("Tím bol upravený", Severity.Success);
            }

            _editDialogVisible = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri ukladaní tímu: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SyncTeamCoachAssignment(Guid teamId)
    {
        var assignedCoaches = _coaches.Where(c => c.Teams.Any(t => t.TeamId == teamId)).ToList();

        foreach (var coach in assignedCoaches)
        {
            await UsersApi.RemoveTeamAsync(coach.Id, teamId);
        }

        if (!string.IsNullOrWhiteSpace(_teamModel.SelectedCoachId))
        {
            await UsersApi.AssignTeamAsync(_teamModel.SelectedCoachId, teamId, true);
        }
    }

    public class TeamFormModel
    {
        [Required(ErrorMessage = "Názov tímu je povinný.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Názov musí mať 2 – 100 znakov.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Skratka môže mať max 50 znakov.")]
        public string? ShortName { get; set; }

        [StringLength(500, ErrorMessage = "Popis môže mať max 500 znakov.")]
        public string? Description { get; set; }

        public string? SelectedCoachId { get; set; }
    }

    private async Task DeleteTeam(TeamDto team)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Potvrdenie zmazania",
            $"Naozaj chcete zmazať tím '{team.Name}'? Táto akcia je nevratná a odstráni prepojenia na tím zo všetkých profilov.",
            yesText: "Zmazať", cancelText: "Zrušiť",
            options: new DialogOptions { MaxWidth = MaxWidth.Small }
        );

        if (result == true)
        {
            try
            {
                await TeamsApi.DeleteTeamAsync(team.Id);
                Snackbar.Add($"Tím '{team.Name}' bol zmazaný", Severity.Success);
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Chyba pri mazaní tímu: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task OpenRosterDialog(Guid teamId)
    {
        _rosterTeamId = teamId;
        _rosterTeamName = _teams.FirstOrDefault(t => t.Id == teamId)?.Name ?? "";
        _rosterDialogVisible = true;
        _rosterSearch = "";
        await LoadRosterData();
    }

    private async Task LoadRosterData()
    {
        _isLoadingRoster = true;
        try
        {
            var teamDetail = await TeamsApi.GetTeamAsync(_rosterTeamId);
            _allChildren = await ChildrenApi.GetAllChildrenAsync();
            
            _rosterMembers = teamDetail.Members;
            
            var currentMemberIds = _rosterMembers.Select(m => m.Id).ToHashSet();
            _availableChildren = _allChildren.Where(c => !currentMemberIds.Contains(c.Id)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepodarilo sa načítať súpisku: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingRoster = false;
        }
    }

    private async Task AddChildToTeam(ChildDto child)
    {
        try
        {
            await TeamsApi.AddMemberAsync(_rosterTeamId, child.Id);
            Snackbar.Add($"{child.FirstName} {child.LastName} bol pridaný do tímu", Severity.Success);
            await LoadRosterData();

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveChildFromTeam(TeamMemberDto member)
    {
        try
        {
            await TeamsApi.RemoveMemberAsync(_rosterTeamId, member.Id);
            Snackbar.Add($"{member.FirstName} {member.LastName} bol odstránený z tímu", Severity.Success);
            await LoadRosterData();

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ex.Message}", Severity.Error);
        }
    }
}