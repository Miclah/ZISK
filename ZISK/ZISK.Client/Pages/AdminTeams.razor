@page "/admin/timy"
@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Components
@using ZISK.Client.Components.Teams
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Users
@inject ITeamsApi TeamsApi
@inject IUsersApi UsersApi
@inject IChildrenApi ChildrenApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@T("admin.teams.pageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<PageHeader Icon="@Icons.Material.Filled.Groups" Title="@T("admin.teams.pageTitle")">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenCreateDialog">
            @T("admin.teams.createTeam")
        </MudButton>
    </Actions>
</PageHeader>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 5; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        }
    </MudStack>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var team in _teams)
        {
            <MudItem @key="team.Id" xs="12" sm="6" md="4">
                <TeamCard Team="team"
                          CoachNames="@GetCoachNamesForTeam(team.Id)"
                          OnEdit="() => OpenEditDialog(team)"
                          OnDelete="() => DeleteTeam(team)"
                          OnManageRoster="() => OpenRosterDialog(team.Id)" />
            </MudItem>
        }

        @if (_teams.Count == 0)
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info">@T("admin.teams.noTeams")</MudAlert>
            </MudItem>
        }
    </MudGrid>
}
</MudContainer>

<MudDialog @bind-Visible="_editDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isCreating ? T("admin.teams.createTeam") : T("admin.teams.editTeam"))</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_teamModel" OnValidSubmit="SaveTeam">
            <LocalizedDataAnnotationsValidator />
            <MudStack Spacing="3" Class="py-2">
                <MudTextField @bind-Value="_teamModel.Name"
                              For="@(() => _teamModel.Name)"
                              Label="@T("admin.teams.nameLabel")"
                              Variant="Variant.Outlined" />
                <MudSelect T="string" @bind-Value="_teamModel.SelectedCoachId" Label="@T("admin.teams.assignedCoach")" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var coach in _coaches)
                    {
                        <MudSelectItem Value="@coach.Id">@coach.FirstName @coach.LastName</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_teamModel.ShortName"
                              For="@(() => _teamModel.ShortName)"
                              Label="@T("admin.teams.shortNameLabel")"
                              Variant="Variant.Outlined"
                              MaxLength="50" />
                <MudTextField @bind-Value="_teamModel.Description"
                              For="@(() => _teamModel.Description)"
                              Label="@T("admin.teams.descriptionLabel")"
                              Variant="Variant.Outlined"
                              Lines="3" />
                <LoadingButton ButtonType="ButtonType.Submit"
                              Color="Color.Primary"
                              Variant="Variant.Filled"
                              Loading="_isSaving"
                              FullWidth="true">
                    @T("admin.users.save")
                </LoadingButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

<MudDialog @bind-Visible="_rosterDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@T("admin.teams.manageRosterTitle") @_rosterTeamName</MudText>
    </TitleContent>
    <DialogContent>
        <TeamRosterPanel IsLoading="_isLoadingRoster"
                         Available="_rosterAvailableEntries"
                         Members="_rosterMemberEntries"
                         OnAdd="AddChildToTeamById"
                         OnRemove="RemoveChildFromTeamById" />
    </DialogContent>
</MudDialog>

@code {
    private bool _isLoading = true;
    private string? _error;
    private List<TeamDto> _teams = new();
    private List<UserListDto> _coaches = new();

    private bool _editDialogVisible = false;
    private bool _isCreating = true;
    private bool _isSaving = false;
    private TeamDto? _selectedTeam;

    private TeamFormModel _teamModel = new();

    private bool _rosterDialogVisible = false;
    private bool _isLoadingRoster = false;
    private Guid _rosterTeamId;
    private string _rosterTeamName = "";
    private List<TeamMemberDto> _rosterMembers = new();
    private List<ChildDto> _availableChildren = new();
    private List<ChildDto> _allChildren = new();

    // TeamRosterPanel works in terms of a neutral entry record, since the two sides come from different DTOs.
    private List<TeamRosterPanel.RosterEntry> _rosterMemberEntries = new();
    private List<TeamRosterPanel.RosterEntry> _rosterAvailableEntries = new();

protected override async Task OnInitializedAsync()
    {
        await LoadData();
        // Deep-link support: navigating to this page with ?action=create opens the create dialog automatically (same pattern as AdminTrainings).
        if (NavigationManager.Uri.Contains("action=create", StringComparison.OrdinalIgnoreCase))
            OpenCreateDialog();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _error = null;
            
            var teamsTask = TeamsApi.GetTeamsAsync(null);
            var usersTask = UsersApi.GetUsersAsync("Coach");
            
            await Task.WhenAll(teamsTask, usersTask);
            
            _teams = await teamsTask;
            _coaches = await usersTask;
        }
        catch (Exception ex)
        {
            _error = T("admin.teams.errorLoadingData") + " " + ApiErrorFormatter.ToUserMessage(ex);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetCoachNamesForTeam(Guid teamId)
    {
        var coaches = _coaches
            .Where(u => u.Teams.Any(t => t.TeamId == teamId))
            .Select(u => $"{u.FirstName} {u.LastName}")
            .ToList();

        return coaches.Any() ? string.Join(", ", coaches) : T("admin.users.unassigned");
    }

    private void OpenCreateDialog()
    {
        _isCreating = true;
        _selectedTeam = null;
        _teamModel = new TeamFormModel();
        _editDialogVisible = true;
    }

    private void OpenEditDialog(TeamDto team)
    {
        _isCreating = false;
        _selectedTeam = team;
        _teamModel = new TeamFormModel
        {
            Name = team.Name,
            ShortName = team.ShortName,
            Description = team.Description,
            SelectedCoachId = _coaches.FirstOrDefault(c => c.Teams.Any(t => t.TeamId == team.Id))?.Id
        };
        _editDialogVisible = true;
    }

    private async Task SaveTeam()
    {
        _isSaving = true;
        try
        {
            if (_isCreating)
            {
                var createdTeam = await TeamsApi.CreateTeamAsync(new CreateTeamRequest(_teamModel.Name, _teamModel.ShortName, _teamModel.Description));
                await SyncTeamCoachAssignment(createdTeam.Id);
                Snackbar.Add(T("admin.teams.created"), Severity.Success);
            }
            else if (_selectedTeam != null)
            {
                await TeamsApi.UpdateTeamAsync(_selectedTeam.Id, new UpdateTeamRequest(_teamModel.Name, _teamModel.ShortName, _teamModel.Description, true));
                await SyncTeamCoachAssignment(_selectedTeam.Id);
                Snackbar.Add(T("admin.teams.updated"), Severity.Success);
            }

            _editDialogVisible = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("admin.teams.errorSaving")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SyncTeamCoachAssignment(Guid teamId)
    {
        var assignedCoaches = _coaches.Where(c => c.Teams.Any(t => t.TeamId == teamId)).ToList();

        foreach (var coach in assignedCoaches)
        {
            await UsersApi.RemoveTeamAsync(coach.Id, teamId);
        }

        if (!string.IsNullOrWhiteSpace(_teamModel.SelectedCoachId))
        {
            await UsersApi.AssignTeamAsync(_teamModel.SelectedCoachId, teamId, true);
        }
    }

    public class TeamFormModel
    {
        [Required(ErrorMessage = "Názov tímu je povinný.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Názov musí mať 2 – 100 znakov.")]
        public string Name { get; set; } = string.Empty;

        [StringLength(50, ErrorMessage = "Skratka môže mať max 50 znakov.")]
        public string? ShortName { get; set; }

        [StringLength(500, ErrorMessage = "Popis môže mať max 500 znakov.")]
        public string? Description { get; set; }

        public string? SelectedCoachId { get; set; }
    }

    private async Task DeleteTeam(TeamDto team)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            T("admin.teams.confirmDeleteTitle"),
            string.Format(T("admin.teams.confirmDeleteText"), team.Name),
            yesText: T("admin.teams.deleteButton"), cancelText: T("admin.users.cancel"),
            options: new DialogOptions { MaxWidth = MaxWidth.Small }
        );

        if (result == true)
        {
            try
            {
                await TeamsApi.DeleteTeamAsync(team.Id);
                Snackbar.Add(string.Format(T("admin.teams.deleted"), team.Name), Severity.Success);
                await LoadData();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{T("admin.teams.errorDeleting")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
            }
        }
    }

    private async Task OpenRosterDialog(Guid teamId)
    {
        _rosterTeamId = teamId;
        _rosterTeamName = _teams.FirstOrDefault(t => t.Id == teamId)?.Name ?? "";
        _rosterDialogVisible = true;
        await LoadRosterData();
    }

    private async Task LoadRosterData()
    {
        _isLoadingRoster = true;
        try
        {
            var teamDetail = await TeamsApi.GetTeamAsync(_rosterTeamId);
            _allChildren = await ChildrenApi.GetAllChildrenAsync();
            
            _rosterMembers = teamDetail.Members;
            
            var currentMemberIds = _rosterMembers.Select(m => m.Id).ToHashSet();
            _availableChildren = _allChildren.Where(c => !currentMemberIds.Contains(c.Id)).ToList();

            _rosterMemberEntries = _rosterMembers
                .Select(m => new TeamRosterPanel.RosterEntry(m.Id, m.FirstName, m.LastName))
                .ToList();
            _rosterAvailableEntries = _availableChildren
                .Select(c => new TeamRosterPanel.RosterEntry(c.Id, c.FirstName, c.LastName))
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("admin.teams.errorLoadingRoster")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoadingRoster = false;
        }
    }

    private Task AddChildToTeamById(string childId)
    {
        var child = _availableChildren.FirstOrDefault(c => c.Id == childId);
        return child is null ? Task.CompletedTask : AddChildToTeam(child);
    }

    private Task RemoveChildFromTeamById(string memberId)
    {
        var member = _rosterMembers.FirstOrDefault(m => m.Id == memberId);
        return member is null ? Task.CompletedTask : RemoveChildFromTeam(member);
    }

    private async Task AddChildToTeam(ChildDto child)
    {
        try
        {
            await TeamsApi.AddMemberAsync(_rosterTeamId, child.Id);
            Snackbar.Add(string.Format(T("admin.teams.childAddedToTeam"), $"{child.FirstName} {child.LastName}"), Severity.Success);
            await LoadRosterData();

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    private async Task RemoveChildFromTeam(TeamMemberDto member)
    {
        try
        {
            await TeamsApi.RemoveMemberAsync(_rosterTeamId, member.Id);
            Snackbar.Add(string.Format(T("admin.teams.childRemovedFromTeam"), $"{member.FirstName} {member.LastName}"), Severity.Success);
            await LoadRosterData();

            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }
}