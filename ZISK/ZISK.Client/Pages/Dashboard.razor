@page "/domov"
@using System.Security.Claims
@using System.Globalization
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.Enums
@inject IAnnouncementsApi AnnouncementsApi
@inject IAttendanceApi AttendanceApi
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject IExcusesApi ExcusesApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Parent,Athlete")]

<PageTitle>Nástenka</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
@if (_isLoading)
{
    <MudStack Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" />
        <MudGrid Spacing="3">
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
                </MudItem>
            }
        </MudGrid>
    </MudStack>
}
else
{
    <MudPaper Elevation="0" Class="dashboard-hero mb-3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Surface" Size="Size.Medium" Style="color:var(--mud-palette-primary);">
                    @(_firstName.Length > 0 ? _firstName[0].ToString().ToUpper() : "?")
                </MudAvatar>
                <MudStack Spacing="0">
                    <h1 class="dashboard-hero__greeting">Vitajte, @_firstName</h1>
                    <div class="dashboard-hero__subtitle">@_dateText</div>
                </MudStack>
            </MudStack>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                @if (_isParent)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Rounded.PersonAdd" OnClick="OpenAddChildDialog">
                        Pridať dieťa
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                           Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                           StartIcon="@Icons.Material.Rounded.Description"
                           OnClick="OpenAddExcuseDialog">
                    Nová ospravedlnenka
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="6" sm="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Color="Color.Primary" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@_kpiTrainingsThisWeek</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tréningy tento týždeň</MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Warning" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@_kpiPendingExcuses</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Aktívne ospravedlnenky</MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Info" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@_kpiRecentAnnouncements</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Nové oznamy (7 dní)</MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="2">
                <MudCardContent Class="pa-3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(_isParent ? Icons.Material.Filled.FamilyRestroom : Icons.Material.Filled.Person)" Color="Color.Secondary" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@(_isParent ? _children.Count(c => !c.IsOwnProfile) : 1)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@(_isParent ? "Detí v rodine" : "Profil")</MudText>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_isParent)
    {
        <MudText Typo="Typo.h6" Class="mb-3">Moja rodina</MudText>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            @if (_isParent)
            {
                @if (!_childCards.Any())
                {
                    <MudPaper Class="card-standard empty-state" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Rounded.ChildCare" Class="empty-state__icon" />
                        <div class="empty-state__title">Zatiaľ žiadne dieťa</div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Pridajte prvé dieťa alebo prijmite pozvánku od iného rodiča.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                                   StartIcon="@Icons.Material.Rounded.PersonAdd"
                                   OnClick="OpenAddChildDialog">
                            Pridať dieťa
                        </MudButton>
                    </MudPaper>
                }
                else
                {
                    <MudGrid Spacing="3">
                        @foreach (var card in _childCards)
                        {
                            <MudItem xs="12" sm="6" xl="@(_childCards.Count >= 3 ? 4 : 6)">
                                <MudPaper Class="card-standard card-hover h-100 pa-4" Elevation="0">
                                    <MudStack Spacing="3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                                                @((card.Child.FirstName.Length > 0 ? card.Child.FirstName[0] : '?').ToString().ToUpper())
                                            </MudAvatar>
                                            <MudStack Spacing="0" Style="flex:1; min-width:0;">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
                                                        @card.Child.FirstName @card.Child.LastName
                                                    </MudText>
                                                    @if (!string.IsNullOrWhiteSpace(card.Child.TeamName))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Icon="@Icons.Material.Rounded.Group" Style="height:20px;">
                                                            @card.Child.TeamName
                                                        </MudChip>
                                                    }
                                                </MudStack>
                                                @if (card.Age.HasValue)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@card.Age rokov</MudText>
                                                }
                                            </MudStack>
                                        </MudStack>

                                        <MudDivider />

                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Najbližší tréning</MudText>
                                            @if (card.NextTraining is null)
                                            {
                                                <MudText Typo="Typo.body2">Žiadne plánované tréningy</MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Style="font-weight:500;">
                                                    @card.NextTraining.StartTime.ToString("dd.MM. HH:mm")
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(card.NextTraining.Location ?? "Bez miesta") — @card.NextTraining.Title
                                                </MudText>
                                            }
                                        </MudStack>

                                        <MudStack Row="true" Spacing="4">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Dochádzka tento mesiac</MudText>
                                                <MudText Typo="Typo.body2" Style="font-weight:500;">
                                                    @card.MonthlyPresent / @card.MonthlyTotal
                                                </MudText>
                                            </MudStack>
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Nové oznamy</MudText>
                                                <MudText Typo="Typo.body2" Style="font-weight:500;">@card.RecentAnnouncementCount</MudText>
                                            </MudStack>
                                        </MudStack>

                                        <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true"
                                                   EndIcon="@Icons.Material.Rounded.ChevronRight"
                                                   OnClick="@(() => NavigationManager.NavigateTo($"/dieta/{card.Child.Id}"))">
                                            Zobraziť detaily
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-3">Najbližší tréning</MudText>
                <MudPaper Class="card-standard pa-4" Elevation="0">
                    @if (_athleteNextTraining is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Žiadny nadchádzajúci tréning.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">@_athleteNextTraining.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @_athleteNextTraining.StartTime.ToString("dd.MM.yyyy HH:mm") – @_athleteNextTraining.EndTime.ToString("HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Miesto: @(_athleteNextTraining.Location ?? "Neuvedené")
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" FullWidth="false"
                                       StartIcon="@Icons.Material.Rounded.CalendarMonth"
                                       OnClick='() => NavigationManager.NavigateTo("/kalendar")'>
                                Zobraziť kalendár
                            </MudButton>
                        </MudStack>
                    }
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudStack Spacing="3">
                <MudPaper Class="card-standard pa-4" Elevation="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Najbližšie tréningy</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   EndIcon="@Icons.Material.Rounded.ChevronRight"
                                   OnClick='() => NavigationManager.NavigateTo("/kalendar")'>
                            Kalendár
                        </MudButton>
                    </MudStack>

                    @if (!_upcomingMerged.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Žiadne nadchádzajúce tréningy.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var item in _upcomingMerged.Take(5))
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2" Style="font-weight:500;">@item.Training.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @item.Training.StartTime.ToString("dd.MM. HH:mm")
                                            @if (!string.IsNullOrWhiteSpace(item.Training.Location))
                                            {
                                                <span> · @item.Training.Location</span>
                                            }
                                        </MudText>
                                    </MudStack>
                                    @if (_isParent)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@item.ChildName</MudChip>
                                    }
                                </MudStack>
                                <MudDivider />
                            }
                        </MudStack>
                    }
                </MudPaper>

                <MudPaper Class="card-standard pa-4" Elevation="0">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Aktívne oznamy</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   EndIcon="@Icons.Material.Rounded.ChevronRight"
                                   OnClick='() => NavigationManager.NavigateTo("/oznamy")'>
                            Všetky
                        </MudButton>
                    </MudStack>

                    @if (!_announcements.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Žiadne aktívne oznamy.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var announcement in _announcements.Take(5))
                            {
                                <div style="@GetAnnouncementStyle(announcement); padding: 8px 12px;">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="1">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2" Style="font-weight:600;">@announcement.Title</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @announcement.PublishDate.ToString("dd.MM.yyyy")
                                            </MudText>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(announcement.Priority)">@GetPriorityText(announcement.Priority)</MudChip>
                                    </MudStack>
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}
</MudContainer>

@code {
    private record ChildCard(ChildDto Child, int? Age, TrainingEventDto? NextTraining, int MonthlyPresent, int MonthlyTotal, int RecentAnnouncementCount);
    private record UpcomingItem(TrainingEventDto Training, string ChildName);

    private bool _isLoading = true;
    private bool _isParent;
    private string _firstName = "";
    private string _dateText = "";
    private List<ChildDto> _children = new();
    private List<ChildCard> _childCards = new();
    private List<UpcomingItem> _upcomingMerged = new();
    private List<AnnouncementListDto> _announcements = new();
    private TrainingEventDto? _athleteNextTraining;

    private int _kpiTrainingsThisWeek;
    private int _kpiPendingExcuses;
    private int _kpiRecentAnnouncements;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isParent = state.User.IsInRole("Parent");
        _firstName = state.User.FindFirst(ClaimTypes.GivenName)?.Value ?? "";

        var sk = new CultureInfo("sk-SK");
        _dateText = char.ToUpper(DateTime.Now.ToString("dddd", sk)[0]) + DateTime.Now.ToString("dddd", sk).Substring(1) + ", " + DateTime.Now.ToString("d. MMMM yyyy", sk);

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _children = await ChildrenApi.GetMyChildrenAsync();

            if (_isParent)
            {
                await LoadFamilyView();
            }
            else
            {
                await LoadAthleteView();
            }

            try
            {
                _kpiPendingExcuses = await ExcusesApi.GetPendingCountAsync();
            }
            catch { _kpiPendingExcuses = 0; }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní dát: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadFamilyView()
    {
        var now = DateTime.Now;
        var monthStart = new DateTime(now.Year, now.Month, 1);
        var horizonEnd = now.AddDays(14);
        var weekEnd = now.AddDays(7);

        var allAnnouncements = await AnnouncementsApi.GetAnnouncementsAsync(null, null);
        var childTeamNames = _children
            .Where(c => !string.IsNullOrWhiteSpace(c.TeamName))
            .Select(c => c.TeamName!)
            .ToHashSet();

        _announcements = allAnnouncements
            .Where(a => string.IsNullOrEmpty(a.TargetTeamName) || childTeamNames.Contains(a.TargetTeamName))
            .OrderByDescending(a => a.Priority)
            .ThenByDescending(a => a.PublishDate)
            .Take(8)
            .ToList();

        var recentThreshold = now.AddDays(-7);
        _kpiRecentAnnouncements = allAnnouncements.Count(a =>
            (string.IsNullOrEmpty(a.TargetTeamName) || childTeamNames.Contains(a.TargetTeamName))
            && a.PublishDate >= recentThreshold);

        var cards = new List<ChildCard>();
        var mergedUpcoming = new List<UpcomingItem>();

        foreach (var child in _children.Where(c => !c.IsOwnProfile))
        {
            TrainingEventDto? next = null;
            var monthlyPresent = 0;
            var monthlyTotal = 0;
            var childUpcoming = new List<TrainingEventDto>();

            if (child.TeamId.HasValue)
            {
                try
                {
                    var trainings = await TrainingsApi.GetTrainingsAsync(child.TeamId, now, horizonEnd);
                    childUpcoming = trainings.OrderBy(t => t.StartTime).ToList();
                    next = childUpcoming.FirstOrDefault();
                }
                catch { }
            }

            try
            {
                var stats = await AttendanceApi.GetMemberStatsAsync(child.Id, monthStart, now);
                monthlyPresent = stats.Present;
                monthlyTotal = stats.Total;
            }
            catch { }

            var recentAnnouncementCount = allAnnouncements.Count(a =>
                (string.IsNullOrEmpty(a.TargetTeamName) || a.TargetTeamName == child.TeamName) &&
                a.PublishDate >= recentThreshold);

            cards.Add(new ChildCard(child, CalculateAge(child), next, monthlyPresent, monthlyTotal, recentAnnouncementCount));

            foreach (var training in childUpcoming)
                mergedUpcoming.Add(new UpcomingItem(training, child.FirstName));
        }

        _childCards = cards;
        _upcomingMerged = mergedUpcoming
            .OrderBy(u => u.Training.StartTime)
            .Take(10)
            .ToList();

        _kpiTrainingsThisWeek = mergedUpcoming.Count(u => u.Training.StartTime <= weekEnd);
    }

    private async Task LoadAthleteView()
    {
        var now = DateTime.Now;
        var weekEnd = now.AddDays(7);
        var self = _children.FirstOrDefault();
        if (self?.TeamId is null)
        {
            _athleteNextTraining = null;
            _announcements = new();
            _kpiTrainingsThisWeek = 0;
            _kpiRecentAnnouncements = 0;
            return;
        }

        var trainingsTask = TrainingsApi.GetTrainingsAsync(self.TeamId, now, now.AddMonths(1));
        var announcementsTask = AnnouncementsApi.GetAnnouncementsAsync(self.TeamId, null);
        await Task.WhenAll(trainingsTask, announcementsTask);

        var allTrainings = (await trainingsTask).OrderBy(t => t.StartTime).ToList();
        _athleteNextTraining = allTrainings.FirstOrDefault();
        _upcomingMerged = allTrainings.Take(10).Select(t => new UpcomingItem(t, self.FirstName)).ToList();
        _kpiTrainingsThisWeek = allTrainings.Count(t => t.StartTime <= weekEnd);

        var allAnn = (await announcementsTask).OrderByDescending(a => a.PublishDate).ToList();
        _announcements = allAnn.Take(8).ToList();
        var threshold = now.AddDays(-7);
        _kpiRecentAnnouncements = allAnn.Count(a => a.PublishDate >= threshold);
    }

    private int? CalculateAge(ChildDto child)
    {
        if (!child.DateOfBirth.HasValue)
            return null;
        var dob = child.DateOfBirth.Value;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age))
            age--;
        return age;
    }

    private string GetAnnouncementStyle(AnnouncementListDto announcement)
    {
        var borderColor = announcement.Priority switch
        {
            AnnouncementPriority.High => "var(--mud-palette-error)",
            AnnouncementPriority.Medium => "var(--mud-palette-warning)",
            _ => "var(--mud-palette-info)"
        };
        return $"border-left: 3px solid {borderColor};";
    }

    private Color GetPriorityColor(AnnouncementPriority priority) => priority switch
    {
        AnnouncementPriority.High => Color.Error,
        AnnouncementPriority.Medium => Color.Warning,
        _ => Color.Info
    };

    private string GetPriorityText(AnnouncementPriority priority) => priority switch
    {
        AnnouncementPriority.High => "Dôležité",
        AnnouncementPriority.Medium => "Stredná",
        _ => "Info"
    };

    private async Task OpenAddChildDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddChildDialog>("Pridať dieťa", options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await LoadData();
    }

    private async Task OpenAddExcuseDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>("Nová ospravedlnenka", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadData();
    }
}
