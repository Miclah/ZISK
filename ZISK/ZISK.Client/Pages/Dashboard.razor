@page "/domov"
@inherits LocalizedComponentBase
@using System.Security.Claims
@using System.Globalization
@using ZISK.Client.Components
@using ZISK.Client.Components.Dashboard
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Trainings
@inject IAnnouncementsApi AnnouncementsApi
@inject IAttendanceApi AttendanceApi
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject IExcusesApi ExcusesApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Parent,Athlete,Child")]

<PageTitle>@T("dashboard.family.pageTitle") - ZISK</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
@if (_isLoading)
{
    <MudStack Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" />
        <MudGrid Spacing="3">
            @for (int i = 0; i < 3; i++)
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
                </MudItem>
            }
        </MudGrid>
    </MudStack>
}
else
{
    <DashboardHero FirstName="@_firstName" Subtitle="@_dateText">
        <Actions>
            @if (_isParent)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Rounded.PersonAdd" OnClick="OpenAddChildDialog">
                    @T("dashboard.family.addChild")
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                           Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                           StartIcon="@Icons.Material.Rounded.Numbers" OnClick="OpenJoinByCodeDialog">
                    @T("dashboard.family.addChildByCode")
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                       Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                       StartIcon="@Icons.Material.Rounded.Description"
                       OnClick="OpenAddExcuseDialog">
                @T("dashboard.family.newExcuse")
            </MudButton>
        </Actions>
    </DashboardHero>

    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.FitnessCenter" IconColor="Color.Primary"
                             Value="@_kpiTrainingsThisWeek.ToString()" Label="@T("dashboard.family.kpi.trainingsThisWeek")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.EventBusy" IconColor="Color.Warning"
                             Value="@_kpiPendingExcuses.ToString()" Label="@T("dashboard.family.kpi.activeExcuses")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.Campaign" IconColor="Color.Info"
                             Value="@_kpiRecentAnnouncements.ToString()" Label="@T("dashboard.family.kpi.newAnnouncements")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@(_isParent ? Icons.Material.Filled.FamilyRestroom : Icons.Material.Filled.Person)"
                             IconColor="Color.Secondary"
                             Value="@(_isParent ? _childCards.Count.ToString() : "1")"
                             Label="@(_isParent ? T("dashboard.family.kpi.childrenInFamily") : T("dashboard.family.kpi.profile"))" />
        </MudItem>
    </MudGrid>

    @if (_isParent)
    {
        <MudText Typo="Typo.h6" Class="mb-3">@T("dashboard.family.myFamily")</MudText>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            @if (_isParent)
            {
                @if (_childCards.Count == 0)
                {
                    <MudPaper Class="card-standard empty-state" Elevation="0">
                        <MudIcon Icon="@Icons.Material.Rounded.ChildCare" Class="empty-state__icon" />
                        <div class="empty-state__title">@T("dashboard.family.noChildrenTitle")</div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @T("dashboard.family.noChildrenText")
                        </MudText>
                        <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="mt-2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Rounded.PersonAdd"
                                       OnClick="OpenAddChildDialog">
                                @T("dashboard.family.addChild")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Rounded.Numbers"
                                       OnClick="OpenJoinByCodeDialog">
                                @T("dashboard.family.addChildByCode")
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                }
                else
                {
                    <MudGrid Spacing="3">
                        @foreach (var card in _childCards)
                        {
                            <MudItem @key="card.Child.Id" xs="12" sm="6" xl="@(_childCards.Count >= 3 ? 4 : 6)">
                                <ChildSummaryCard Child="card.Child"
                                                  Age="card.Age"
                                                  NextTraining="card.NextTraining"
                                                  MonthlyPresent="card.MonthlyPresent"
                                                  MonthlyTotal="card.MonthlyTotal"
                                                  RecentAnnouncementCount="card.RecentAnnouncementCount"
                                                  OnOpenDetail="@(() => NavigationManager.NavigateTo($"/dieta/{card.Child.Id}"))" />
                            </MudItem>
                        }
                    </MudGrid>
                }
            }
            else
            {
                <MudText Typo="Typo.h6" Class="mb-3">@T("dashboard.family.nextTraining")</MudText>
                <MudPaper Class="card-standard pa-4" Elevation="0">
                    @if (_athleteNextTraining is null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@T("dashboard.family.noUpcomingTraining")</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.h6">@_athleteNextTraining.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @_athleteNextTraining.StartTime.ToString("dd.MM.yyyy HH:mm") – @_athleteNextTraining.EndTime.ToString("HH:mm")
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @T("dashboard.family.locationPrefix") @(_athleteNextTraining.Location ?? T("dashboard.locationNotSpecified"))
                            </MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" FullWidth="false"
                                       StartIcon="@Icons.Material.Rounded.CalendarMonth"
                                       OnClick='() => NavigationManager.NavigateTo("/kalendar")'>
                                @T("dashboard.family.showCalendar")
                            </MudButton>
                        </MudStack>
                    }
                </MudPaper>
            }
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudStack Spacing="3">
                <UpcomingTrainingsMiniPanel Items="_upcomingMerged"
                                            ShowOwnerChip="_isParent"
                                            OnShowAll='() => NavigationManager.NavigateTo("/kalendar")' />

                <ActiveAnnouncementsPanel Announcements="_announcements"
                                          OnShowAll='() => NavigationManager.NavigateTo("/oznamy")' />
            </MudStack>
        </MudItem>
    </MudGrid>
}
</MudContainer>

@code {
    private record ChildCard(ChildDto Child, int? Age, TrainingEventDto? NextTraining, int MonthlyPresent, int MonthlyTotal, int RecentAnnouncementCount);

    private bool _isLoading = true;
    private bool _isParent;
    private string _firstName = "";
    private string _dateText = "";
    private List<ChildDto> _children = new();
    private List<ChildCard> _childCards = new();
    private List<UpcomingTrainingsMiniPanel.Item> _upcomingMerged = new();
    private List<AnnouncementListDto> _announcements = new();
    private TrainingEventDto? _athleteNextTraining;

    private int _kpiTrainingsThisWeek;
    private int _kpiPendingExcuses;
    private int _kpiRecentAnnouncements;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isParent = state.User.IsInRole("Parent");

        if (!_isParent && (state.User.IsInRole("Athlete") || state.User.IsInRole("Child")))
        {
            NavigationManager.NavigateTo("/dieta", replace: true);
            return;
        }

        _firstName = state.User.FindFirst(ClaimTypes.GivenName)?.Value ?? "";

        var sk = new CultureInfo("sk-SK");
        _dateText = char.ToUpper(DateTime.Now.ToString("dddd", sk)[0]) + DateTime.Now.ToString("dddd", sk).Substring(1) + ", " + DateTime.Now.ToString("d. MMMM yyyy", sk);

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            _children = await ChildrenApi.GetMyChildrenAsync();

            if (_isParent)
            {
                await LoadFamilyView();
            }
            else
            {
                await LoadAthleteView();
            }

            try
            {
                _kpiPendingExcuses = await ExcusesApi.GetPendingCountAsync();
            }
            catch { _kpiPendingExcuses = 0; }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("dashboard.family.errorLoading")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadFamilyView()
    {
        var now = DateTime.Now;
        var monthStart = new DateTime(now.Year, now.Month, 1);
        var horizonEnd = now.AddDays(14);
        var weekEnd = now.AddDays(7);

        var allAnnouncements = await AnnouncementsApi.GetAnnouncementsAsync(null, null);
        var childTeamNames = _children
            .Where(c => !string.IsNullOrWhiteSpace(c.TeamName))
            .Select(c => c.TeamName!)
            .ToHashSet();

        _announcements = allAnnouncements
            .Where(a => string.IsNullOrEmpty(a.TargetTeamName) || childTeamNames.Contains(a.TargetTeamName))
            .OrderByDescending(a => a.Priority)
            .ThenByDescending(a => a.PublishDate)
            .Take(8)
            .ToList();

        var recentThreshold = now.AddDays(-7);
        _kpiRecentAnnouncements = allAnnouncements.Count(a =>
            (string.IsNullOrEmpty(a.TargetTeamName) || childTeamNames.Contains(a.TargetTeamName))
            && a.PublishDate >= recentThreshold);

        // Each child needs a trainings call and a stats call. Previously these ran sequentially inside a
        // foreach, so a parent with three children waited on six round-trips end to end; now every child's
        // pair is issued together and the whole set is awaited once.
        var realChildren = _children.Where(c => !c.IsOwnProfile).ToList();

        var perChild = await Task.WhenAll(realChildren.Select(async child =>
        {
            var trainingsTask = child.TeamId.HasValue
                ? SafeAsync(() => TrainingsApi.GetTrainingsAsync(child.TeamId, now, horizonEnd), new List<TrainingEventDto>())
                : Task.FromResult(new List<TrainingEventDto>());

            var statsTask = SafeAsync<AttendanceStatsDto?>(
                async () => await AttendanceApi.GetMemberStatsAsync(child.Id, monthStart, now),
                null);

            await Task.WhenAll(trainingsTask, statsTask);

            var upcoming = (await trainingsTask).OrderBy(t => t.StartTime).ToList();
            var stats = await statsTask;

            var recentAnnouncementCount = allAnnouncements.Count(a =>
                (string.IsNullOrEmpty(a.TargetTeamName) || a.TargetTeamName == child.TeamName) &&
                a.PublishDate >= recentThreshold);

            return (
                Card: new ChildCard(
                    child,
                    CalculateAge(child),
                    upcoming.FirstOrDefault(),
                    stats?.Present ?? 0,
                    stats?.Total ?? 0,
                    recentAnnouncementCount),
                Upcoming: upcoming.Select(t => new UpcomingTrainingsMiniPanel.Item(t, child.FirstName)).ToList()
            );
        }));

        _childCards = perChild.Select(x => x.Card).ToList();

        var mergedUpcoming = perChild.SelectMany(x => x.Upcoming).ToList();
        _upcomingMerged = mergedUpcoming
            .OrderBy(u => u.Training.StartTime)
            .Take(10) // intentional cap — without a limit the list grows unreasonably long when a parent has many children
            .ToList();

        _kpiTrainingsThisWeek = mergedUpcoming.Count(u => u.Training.StartTime <= weekEnd);
    }

    /// <summary>
    /// Runs an API call, falling back to <paramref name="fallback"/> if it throws. Preserves the original
    /// per-child behaviour, where one child's failed lookup left the rest of the dashboard intact.
    /// </summary>
    private static async Task<T> SafeAsync<T>(Func<Task<T>> call, T fallback)
    {
        try { return await call(); }
        catch { return fallback; }
    }

    private async Task LoadAthleteView()
    {
        var now = DateTime.Now;
        var weekEnd = now.AddDays(7);
        var self = _children.FirstOrDefault();
        if (self?.TeamId is null)
        {
            _athleteNextTraining = null;
            _announcements = new();
            _kpiTrainingsThisWeek = 0;
            _kpiRecentAnnouncements = 0;
            return;
        }

        // Two independent API calls — run in parallel to avoid doubling the latency.
        var trainingsTask = TrainingsApi.GetTrainingsAsync(self.TeamId, now, now.AddMonths(1));
        var announcementsTask = AnnouncementsApi.GetAnnouncementsAsync(self.TeamId, null);
        await Task.WhenAll(trainingsTask, announcementsTask);

        var allTrainings = (await trainingsTask).OrderBy(t => t.StartTime).ToList();
        _athleteNextTraining = allTrainings.FirstOrDefault();
        _upcomingMerged = allTrainings.Take(10)
            .Select(t => new UpcomingTrainingsMiniPanel.Item(t, self.FirstName))
            .ToList();
        _kpiTrainingsThisWeek = allTrainings.Count(t => t.StartTime <= weekEnd);

        var allAnn = (await announcementsTask).OrderByDescending(a => a.PublishDate).ToList();
        _announcements = allAnn.Take(8).ToList();
        var threshold = now.AddDays(-7);
        _kpiRecentAnnouncements = allAnn.Count(a => a.PublishDate >= threshold);
    }

    private int? CalculateAge(ChildDto child)
    {
        if (!child.DateOfBirth.HasValue)
            return null;
        var dob = child.DateOfBirth.Value;
        var today = DateOnly.FromDateTime(DateTime.Today);
        var age = today.Year - dob.Year;
        if (dob > today.AddYears(-age)) // birthday has not occurred yet this year — subtract one to get the correct age
            age--;
        return age;
    }

    private async Task OpenAddChildDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddChildDialog>(T("dashboard.family.addChild"), options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
            await LoadData();
    }

    private async Task OpenJoinByCodeDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<JoinChildByCodeDialog>(T("dashboard.family.addChildByCode"), options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadData();
    }

    private async Task OpenAddExcuseDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>(T("dashboard.family.newExcuse"), options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await LoadData();
    }
}
