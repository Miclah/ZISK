@page "/domov"
@implements IDisposable
@using System.Security.Claims
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.Enums
@inject IAnnouncementsApi AnnouncementsApi
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject UserContextService UserContextService
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Parent,Athlete")]

<PageTitle>Nástenka</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Nástenka</MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudCard Elevation="2" Class="mb-4">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-2">Najbližšie udalosti</MudText>

                @if (_nextEvent?.Training is null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Default">Žiadna nadchádzajúca udalosť.</MudText>
                }
                else
                {
                    var training = _nextEvent.Training;
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body1" Style="font-weight:600;">@training.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">@training.StartTime.ToString("dd.MM.yyyy HH:mm") - @training.EndTime.ToString("HH:mm")</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default">Miesto: @(training.Location ?? "Neuvedené")</MudText>
                        <MudChip T="string" Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Info" Class="ml-auto">
                            Pre: @_nextEvent.ForName
                        </MudChip>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-2"
                                   OnClick='() => NavigationManager.NavigateTo("/rozvrh")'>
                            Zobraziť rozvrh
                        </MudButton>
                    </MudStack>
                }
            </MudCardContent>
        </MudCard>

        @if (_isParent)
        {
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">Moje deti</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddChildDialog">
                                Pridať dieťa
                            </MudButton>
                        </MudStack>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (!_myChildren.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Nemáte priradené žiadne dieťa.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="1">
                            @foreach (var child in _myChildren.Where(c => !c.IsOwnProfile))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Default"
                                           StartIcon="@Icons.Material.Filled.ChildCare"
                                           OnClick='() => NavigationManager.NavigateTo($"/dieta/{child.Id}")'>
                                    @child.FirstName @child.LastName
                                    @if (!string.IsNullOrWhiteSpace(child.TeamName))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">(@child.TeamName)</MudText>
                                    }
                                </MudButton>
                            }
                        </MudStack>
                    }
                </MudCardContent>
            </MudCard>
        }

        <MudText Typo="Typo.h6" Class="mb-3">Oznamy</MudText>

        @if (!_announcements.Any())
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Default">Žiadne nové oznamy.</MudText>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var announcement in _announcements)
                {
                    <MudPaper Class="pa-3" Elevation="1" Style="@GetAnnouncementStyle(announcement)">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">@announcement.Title</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Default">@announcement.ContentPreview</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@announcement.PublishDate.ToString("dd.MM.yyyy HH:mm")</MudText>
                            </MudStack>
                            <MudChip T="string" Size="Size.Small" Color="@GetPriorityColor(announcement.Priority)">@GetPriorityText(announcement.Priority)</MudChip>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    }
</MudContainer>

@code {
    private record ContextTraining(TrainingEventDto? Training, string ForName, Guid? TeamId);

    private bool _isLoading = true;
    private bool _disposed;
    private bool _isParent;
    private List<AnnouncementListDto> _announcements = new();
    private ContextTraining? _nextEvent;
    private List<ChildDto> _myChildren = new();

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isParent = state.User.IsInRole("Parent");
        UserContextService.Changed += OnContextChanged;
        await LoadData();
    }

    private async void OnContextChanged()
    {
        if (_disposed)
            return;

        try
        {
            await LoadData();
            if (!_disposed)
                await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            var people = await ChildrenApi.GetMyChildrenAsync();
            _myChildren = people;
            var selected = UserContextService.SelectedOption;

            var scopedPeople = selected is null || selected.Key == UserContextService.AllKey
                ? people
                : people.Where(p => selected.ChildId == p.Id).ToList();

            var trainingTasks = scopedPeople
                .Where(p => p.TeamId.HasValue)
                .Select(async p => new ContextTraining(
                    (await TrainingsApi.GetTrainingsAsync(p.TeamId, DateTime.Now, DateTime.Now.AddMonths(1))).OrderBy(t => t.StartTime).FirstOrDefault(),
                    p.IsOwnProfile ? "Seba" : $"{p.FirstName} {p.LastName}",
                    p.TeamId))
                .ToList();

            var trainingCandidates = new List<ContextTraining>();
            foreach (var task in trainingTasks)
            {
                var item = await task;
                if (item.Training is not null)
                    trainingCandidates.Add(item);
            }

            _nextEvent = trainingCandidates
                .Where(t => t.Training is not null)
                .OrderBy(t => t.Training!.StartTime)
                .FirstOrDefault();

            Guid? announcementTeamId = selected?.TeamId;
            if (selected?.Key == UserContextService.AllKey)
                announcementTeamId = null;

            _announcements = (await AnnouncementsApi.GetAnnouncementsAsync(announcementTeamId, null))
                .OrderByDescending(a => a.PublishDate)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní dát: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetAnnouncementStyle(AnnouncementListDto announcement)
    {
        var borderColor = announcement.Priority switch
        {
            AnnouncementPriority.High => "var(--mud-palette-error)",
            AnnouncementPriority.Medium => "var(--mud-palette-warning)",
            _ => "var(--mud-palette-info)"
        };
        return $"border-left: 3px solid {borderColor};";
    }

    private Color GetPriorityColor(AnnouncementPriority priority) => priority switch
    {
        AnnouncementPriority.High => Color.Error,
        AnnouncementPriority.Medium => Color.Warning,
        _ => Color.Info
    };

    private string GetPriorityText(AnnouncementPriority priority) => priority switch
    {
        AnnouncementPriority.High => "Dôležité",
        AnnouncementPriority.Medium => "Stredná",
        _ => "Info"
    };

    private async Task OpenAddChildDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddChildDialog>("Pridať dieťa", options);
        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadData();
    }

    public void Dispose()
    {
        _disposed = true;
        UserContextService.Changed -= OnContextChanged;
    }
}
