@page "/profil"
@using System.Security.Claims
@using System.Globalization
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Invitations
@inject IInvitationsApi InvitationsApi
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Môj profil - ZISK</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Elevation="1" Class="pa-4 mb-4 d-flex align-center">
        <MudAvatar Color="Color.Primary" Style="height:60px; width:60px;" Class="mr-4">
            @(_firstName?.Length > 0 ? _firstName[0].ToString().ToUpper() : "?")
        </MudAvatar>
        <MudStack Spacing="0">
            <MudText Typo="Typo.h5">@_firstName @_lastName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_email</MudText>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Osobné údaje</MudText>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Meno</MudText>
                        <MudText Typo="Typo.body2">@_firstName</MudText>
                        <MudDivider />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Priezvisko</MudText>
                        <MudText Typo="Typo.body2">@_lastName</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Kontakt</MudText>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Email</MudText>
                        <MudText Typo="Typo.body2">@_email</MudText>
                        <MudDivider />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Rola v systéme</MudText>
                        <MudText Typo="Typo.body2">@_role</MudText>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @if (_isParent)
    {
        <MudCard Elevation="1" Class="mt-4">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Pripojiť sa k dieťaťu</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Zadajte kód, ktorý vám poskytol iný rodič, a prepojte sa s dieťaťom.
                </MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudTextField @bind-Value="_redeemCode"
                                  Label="Kód pozvánky"
                                  Variant="Variant.Outlined"
                                  Placeholder="XXXX-XXXX"
                                  Style="max-width:180px;"
                                  Margin="Margin.Dense" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RedeemCode"
                               Disabled="@(_isRedeeming || string.IsNullOrWhiteSpace(_redeemCode))">
                        @if (_isRedeeming)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Pripojiť
                    </MudButton>
                </MudStack>
            </MudCardContent>
        </MudCard>
    }

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Rounded.Lock" Href="/Account/Manage/ChangePassword">
            Zmeniť heslo
        </MudButton>
    </MudStack>
</MudContainer>

@code {
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _role = string.Empty;
    private string _joinedDateLabel = DateTime.Now.ToString("dd.MM.yyyy", CultureInfo.GetCultureInfo("sk-SK"));
    private bool _isParent;
    private string _redeemCode = string.Empty;
    private bool _isRedeeming;

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState;
        var user = state.User;

        _firstName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? string.Empty;
        _lastName = user.FindFirst(ClaimTypes.Surname)?.Value ?? string.Empty;
        _email = user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? string.Empty;
        _role = user.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
        _isParent = user.IsInRole("Parent");

        var joinedDate = user.FindFirst("created_at")?.Value;
        if (!string.IsNullOrWhiteSpace(joinedDate) && DateTime.TryParse(joinedDate, out var parsed))
        {
            _joinedDateLabel = parsed.ToString("dd.MM.yyyy", CultureInfo.GetCultureInfo("sk-SK"));
        }
    }

    private async Task RedeemCode()
    {
        if (string.IsNullOrWhiteSpace(_redeemCode))
            return;

        _isRedeeming = true;
        try
        {
            await InvitationsApi.RedeemCodeAsync(new RedeemCodeRequest(_redeemCode));
            Snackbar.Add("Úspešne prepojené s dieťaťom!", Severity.Success);
            _redeemCode = string.Empty;
            NavigationManager.NavigateTo("/domov");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isRedeeming = false;
        }
    }
}
