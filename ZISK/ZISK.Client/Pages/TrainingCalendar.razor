@page "/kalendar"
@inherits LocalizedComponentBase
@using System.Globalization
@using ZISK.Client.Services
@using ZISK.Client.Components
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.Enums
@attribute [Authorize]
@inject ITrainingsApi TrainingsApi
@inject ITeamsApi TeamsApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<PageTitle>@T("calendar.pageTitle") - ZISK</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h5" HtmlTag="h1">@T("calendar.pageTitle")</MudText>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <AuthorizeView Roles="Parent">
            <Authorized>
                @if (_contextOptions.Count > 1)
                {
                    <MudSelect T="string" Value="@_selectedContext" ValueChanged="OnContextChanged"
                               Label="@T("calendar.viewAs")" Variant="Variant.Outlined" Dense="true" Style="min-width:180px">
                        @foreach (var opt in _contextOptions)
                        {
                            <MudSelectItem Value="@opt.Key">@opt.Label</MudSelectItem>
                        }
                    </MudSelect>
                }
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin,Coach">
            <Authorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Rounded.Add"
                           OnClick="OpenCreateDialog">
                    @T("calendar.addTraining")
                </MudButton>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudStack>

<MudGrid Spacing="3">
    <MudItem xs="12" lg="8" xl="9">
        <MudPaper Elevation="0" Class="card-standard pa-0">
            <MudCalendar T="TrainingCalendarItem"
                         @bind-View="_view"
                         Items="_items"
                         DateRangeChanged="OnDateRangeChangedAsync"
                         ItemClicked="OnItemClickedAsync"
                         ShowTodayButton="true"
                         MonthCellMinHeight="100"
                         Culture="@CultureInfo.GetCultureInfo("sk-SK")">
                <CellTemplate Context="item">
                    <div class="mud-cal-cell-template-chip" style="@GetItemStyle(item)">
                        @item.Text
                    </div>
                </CellTemplate>
            </MudCalendar>
        </MudPaper>

        @if (_isLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="500px" Class="mt-1" />
        }
    </MudItem>

    <MudItem xs="12" lg="4" xl="3">
        <MudHidden Breakpoint="Breakpoint.MdAndDown">
            <MudStack Spacing="3">
                <MudPaper Elevation="0" Class="card-standard pa-4">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-3">@T("calendar.legend")</MudText>
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <span class="training-chip training-chip--conditioning" style="display:inline-block;min-width:14px;height:14px;border-radius:50%;"></span>
                            <MudText Typo="Typo.body2">@T("calendar.legend.conditioning")</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <span class="training-chip training-chip--technical" style="display:inline-block;min-width:14px;height:14px;border-radius:50%;"></span>
                            <MudText Typo="Typo.body2">@T("calendar.legend.technical")</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <span class="training-chip training-chip--match" style="display:inline-block;min-width:14px;height:14px;border-radius:50%;"></span>
                            <MudText Typo="Typo.body2">@T("calendar.legend.match")</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <span class="training-chip training-chip--recovery" style="display:inline-block;min-width:14px;height:14px;border-radius:50%;"></span>
                            <MudText Typo="Typo.body2">@T("calendar.legend.recovery")</MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <span class="training-chip training-chip--other" style="display:inline-block;min-width:14px;height:14px;border-radius:50%;"></span>
                            <MudText Typo="Typo.body2">@T("calendar.legend.other")</MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="0" Class="card-standard pa-4">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-1">@T("dashboard.panel.upcomingTrainings")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @string.Format(T("calendar.countInPeriod"), _items.Count(i => !i.IsCancelled))
                    </MudText>

                    @{
                        var upcoming = _items
                            .Where(i => i.Start >= DateTime.Now && !i.IsCancelled)
                            .OrderBy(i => i.Start)
                            .Take(5)
                            .ToList();
                    }

                    @if (!upcoming.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@T("dashboard.panel.noUpcomingTrainings")</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var item in upcoming)
                            {
                                <div style="cursor:pointer;" @onclick="@(() => OnItemClickedAsync(item))">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2" Style="font-weight:500;">@item.Text</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @item.Start.ToString("dd.MM. HH:mm")
                                        </MudText>
                                    </MudStack>
                                    <MudDivider Class="mt-2" />
                                </div>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudStack>
        </MudHidden>
    </MudItem>
</MudGrid>
</MudContainer>

@code {
    private CalendarView _view = CalendarView.Month;
    private List<TrainingCalendarItem> _items = [];
    private bool _isLoading;
    private DateRange? _lastRange;

    private List<(string Key, string Label)> _contextOptions = [];
    private string _selectedContext = "all";

    private Guid? _editingTeamId;
    private List<TeamDto> _myTeams = [];

    private static readonly string _cConditioning = (string)AppTheme.SportClubTheme.PaletteLight.Secondary;
    private static readonly string _cTechnical    = (string)AppTheme.SportClubTheme.PaletteLight.Tertiary;
    private static readonly string _cMatch        = (string)AppTheme.SportClubTheme.PaletteLight.Error;
    private static readonly string _cRecovery     = (string)AppTheme.SportClubTheme.PaletteLight.Success;
    private static readonly string _cOther        = (string)AppTheme.SportClubTheme.PaletteLight.ActionDefault;

    private string GetItemStyle(TrainingCalendarItem item)
    {
        var bg = item.Type switch
        {
            TrainingType.Conditioning => _cConditioning,
            TrainingType.Technical    => _cTechnical,
            TrainingType.Match        => _cMatch,
            TrainingType.Recovery     => _cRecovery,
            _                         => _cOther
        };
        var extra = item.IsCancelled ? "opacity:0.55;text-decoration:line-through;" : "";
        return $"background-color:{bg};color:#fff;{extra}";
    }

    protected override async Task OnInitializedAsync()
    {
        _myTeams = await TeamsApi.GetTeamsAsync(true);
        _editingTeamId = _myTeams.FirstOrDefault()?.Id;
    }

    private async Task OnDateRangeChangedAsync(DateRange range)
    {
        _lastRange = range;
        await LoadItemsAsync(range);
    }

    private async Task LoadItemsAsync(DateRange range)
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var from = (range.Start ?? DateTime.Today.AddMonths(-1)).Date;
            var rawTo = (range.End ?? DateTime.Today.AddMonths(2)).Date;
            var to = rawTo == from ? from.AddDays(1).AddTicks(-1) : rawTo.AddDays(1).AddTicks(-1);
            var trainings = await TrainingsApi.GetTrainingsAsync(null, from, to);

            _items = trainings
                .Select(t => new TrainingCalendarItem
                {
                    Start = t.StartTime,
                    End = t.EndTime,
                    Text = t.Title,
                    TrainingId = t.Id,
                    TrainingDto = t,
                    Type = t.Type,
                    IsCancelled = t.IsCancelled
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("calendar.errorLoadingTrainings")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnItemClickedAsync(TrainingCalendarItem item)
    {
        var parameters = new DialogParameters<TrainingDetailDialog>
        {
            { x => x.Training, item.TrainingDto }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<TrainingDetailDialog>(T("calendar.trainingDetail"), parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && _lastRange != null)
            await LoadItemsAsync(_lastRange);
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<TrainingFormDialog>
        {
            { x => x.Teams, _myTeams },
            { x => x.DefaultTeamId, _editingTeamId },
            { x => x.DefaultStart, DateTime.Now.Date.AddHours(17) }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<TrainingFormDialog>(T("calendar.addTraining"), parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && _lastRange != null)
            await LoadItemsAsync(_lastRange);
    }

    private void OnContextChanged(string key)
    {
        _selectedContext = key;
        if (_lastRange != null) _ = LoadItemsAsync(_lastRange);
    }

    private static string TypeChipClass(TrainingType type) => type switch
    {
        TrainingType.Technical    => "training-chip--technical",
        TrainingType.Conditioning => "training-chip--conditioning",
        TrainingType.Match        => "training-chip--match",
        TrainingType.Recovery     => "training-chip--recovery",
        _                         => "training-chip--other"
    };

    public class TrainingCalendarItem : CalendarItem
    {
        public Guid TrainingId { get; init; }
        public TrainingType Type { get; init; }
        public bool IsCancelled { get; init; }
        public TrainingEventDto TrainingDto { get; init; } = null!;
    }
}
