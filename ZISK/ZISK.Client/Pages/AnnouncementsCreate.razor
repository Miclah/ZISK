@page "/oznamy/vytvorit"
@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.Enums
@attribute [Authorize(Roles = "Admin,Coach")]

<PageTitle>@T("announcementForm.createTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@T("announcementForm.createTitle")</MudText>

    <MudGrid>
    <MudItem xs="12" md="8">
        <EditForm Model="@_announcementModel" OnValidSubmit="Submit">
            <LocalizedDataAnnotationsValidator />
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_announcementModel.Title"
                                  For="@(() => _announcementModel.Title)"
                                  Label="@T("announcementForm.titleLabel")" Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="_announcementModel.Content"
                                  For="@(() => _announcementModel.Content)"
                                  Label="@T("announcementForm.contentLabel")" Variant="Variant.Outlined" Lines="6" />

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="Guid?" @bind-Value="_announcementModel.TargetTeamId" Label="@T("announcementForm.targetTeamLabel")" Variant="Variant.Outlined" Clearable="true" Placeholder="@T("admin.announcements.wholeClub")">
                                @foreach (var team in _teams)
                                {
                                    <MudSelectItem Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@T("announcementForm.targetTeamHint")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="TargetAudience" @bind-Value="_announcementModel.TargetAudience" Label="@T("announcementForm.targetAudienceLabel")" Variant="Variant.Outlined">
                                <MudSelectItem Value="TargetAudience.All">@T("announcementForm.audience.all")</MudSelectItem>
                                <MudSelectItem Value="TargetAudience.Parents">@T("announcementForm.audience.parents")</MudSelectItem>
                                <MudSelectItem Value="TargetAudience.Athletes">@T("announcementForm.audience.athletes")</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="AnnouncementPriority" @bind-Value="_announcementModel.Priority" Label="@T("announcements.priorityFilterLabel")" Variant="Variant.Outlined">
                                <MudSelectItem Value="AnnouncementPriority.Low">@T("announcementForm.priority.lowHint")</MudSelectItem>
                                <MudSelectItem Value="AnnouncementPriority.Medium">@T("announcementForm.priority.mediumHint")</MudSelectItem>
                                <MudSelectItem Value="AnnouncementPriority.High">@T("announcementForm.priority.highHint")</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker @bind-Date="_announcementModel.ValidUntil" Label="@T("announcementForm.validUntilOptional")" Variant="Variant.Outlined"
                                           MinDate="DateTime.Now" Clearable="true" />
                        </MudItem>
                    </MudGrid>

                    <MudCheckBox @bind-Value="_announcementModel.IsPinned" Label="@T("announcementForm.pinToTop")" Color="Color.Primary" />

                    @if (!_isDemo)
                    {
                        <MudDivider Class="my-2" />

                        <MudText Typo="Typo.subtitle1">@T("announcementForm.attachmentsOptional")</MudText>

                        <MudButton HtmlTag="label"
                                   for="announcement-files"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            @T("announcementForm.chooseFiles")
                        </MudButton>
                        <InputFile id="announcement-files"
                                   OnChange="OnFilesSelected"
                                   multiple
                                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif" />

                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @T("announcementForm.supportedFormats")
                        </MudText>

                        @if (_selectedFiles.Any())
                        {
                            <MudStack Spacing="1">
                                @foreach (var file in _selectedFiles)
                                {
                                    <MudPaper Class="pa-2" Elevation="0" Style="background-color: #f5f5f5;">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@GetFileIcon(file.Name)" Size="Size.Small" Color="Color.Primary" />
                                                <MudText Typo="Typo.body2">@file.Name</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">(@FormatFileSize(file.Size))</MudText>
                                            </MudStack>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                           OnClick="@(() => RemoveFile(file))" />
                                        </MudStack>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4 mt-4" Elevation="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudButton Variant="Variant.Text" OnClick="Cancel">@T("admin.users.cancel")</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        @T("announcementForm.publish")
                    </MudButton>
                </MudStack>
            </MudPaper>
        </EditForm>
    </MudItem>
    </MudGrid>
</MudContainer>
