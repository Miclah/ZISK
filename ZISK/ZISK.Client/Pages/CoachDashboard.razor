@page "/coach"
@inherits LocalizedComponentBase
@using System.Security.Claims
@using System.Globalization
@using ZISK.Client.Components.Dashboard
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.Enums
@inject ITeamsApi TeamsApi
@inject ITrainingsApi TrainingsApi
@inject IExcusesApi ExcusesApi
@inject IAnnouncementsApi AnnouncementsApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Coach")]

<PageTitle>@T("dashboard.coach.pageTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
@if (_isLoading)
{
    <MudStack Spacing="3">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" />
        <MudGrid Spacing="3">
            @for (int i = 0; i < 4; i++)
            {
                <MudItem xs="6" sm="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="92px" /></MudItem>
            }
        </MudGrid>
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="280px" /></MudItem>
            <MudItem xs="12" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="280px" /></MudItem>
        </MudGrid>
    </MudStack>
}
else
{
    <DashboardHero FirstName="@_firstName"
                   Subtitle="@($"{_dateText}{(_teamName is null ? "" : $" · {_teamName}")}")"
                   FallbackInitial="T">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Rounded.AddCircle"
                       OnClick='() => NavigationManager.NavigateTo("/kalendar")'>
                @T("dashboard.scheduleTraining")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                       Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                       StartIcon="@Icons.Material.Rounded.Campaign"
                       OnClick='() => NavigationManager.NavigateTo("/coach/oznamy")'>
                @T("dashboard.coach.newAnnouncement")
            </MudButton>
        </Actions>
    </DashboardHero>

    <MudGrid Class="mb-4" Spacing="3">
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.FitnessCenter" IconColor="Color.Primary"
                             Value="@_kpiTrainingsThisWeek.ToString()" Label="@T("dashboard.coach.kpi.trainingsThisWeek")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.EventBusy" IconColor="Color.Warning"
                             Value="@_kpiPendingExcuses.ToString()" Label="@T("dashboard.coach.kpi.newExcuses")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.Groups" IconColor="Color.Tertiary"
                             Value="@_memberCount.ToString()" Label="@T("dashboard.coach.kpi.teamMembers")" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <CompactStatCard Icon="@Icons.Material.Filled.Campaign" IconColor="Color.Info"
                             Value="@_kpiRecentAnnouncements.ToString()" Label="@T("dashboard.coach.kpi.newAnnouncements")" />
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="8">
            <MudStack Spacing="3">
                <CoachNextTrainingPanel Training="_nextTraining"
                                        RelativeTime="@(_nextTraining is null ? null : GetRelativeTime(_nextTraining.StartTime))"
                                        ExpectedCount="_nextExpectedCount"
                                        ExcusedCount="_nextExcusedCount"
                                        MemberCount="_memberCount"
                                        OnSchedule='() => NavigationManager.NavigateTo("/kalendar")'
                                        OnOpen='() => NavigationManager.NavigateTo($"/coach/treningy/{_nextTraining!.Id}")' />

                <CoachUpcomingTrainingsPanel Trainings="_upcomingTrainings"
                                             OnOpenTraining="@(id => NavigationManager.NavigateTo($"/coach/treningy/{id}"))"
                                             OnShowAll='() => NavigationManager.NavigateTo("/kalendar")' />
            </MudStack>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudStack Spacing="3">
                <RecentExcusesPanel Excuses="_recentExcuses" />

                <ActiveAnnouncementsPanel Announcements="_announcements"
                                          Title="@T("dashboard.coach.currentAnnouncements")"
                                          MaxItems="4"
                                          OnShowAll='() => NavigationManager.NavigateTo("/coach/oznamy")' />
            </MudStack>
        </MudItem>
    </MudGrid>
}
</MudContainer>

@code {

    private bool _isLoading = true;
    private string _firstName = "";
    private string _dateText = "";
    private string? _teamName;
    private Guid? _teamId;

    private TrainingEventDto? _nextTraining;
    private List<TrainingEventDto> _upcomingTrainings = new();
    private List<ExcuseListDto> _recentExcuses = new();
    private List<AnnouncementListDto> _announcements = new();

    private int _memberCount;
    private int _nextExcusedCount;
    private int _nextExpectedCount;
    private int _kpiTrainingsThisWeek;
    private int _kpiPendingExcuses;
    private int _kpiRecentAnnouncements;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _firstName = state.User.FindFirst(ClaimTypes.GivenName)?.Value ?? "";

        var sk = new CultureInfo("sk-SK");
        var day = DateTime.Now.ToString("dddd", sk);
        _dateText = char.ToUpper(day[0]) + day.Substring(1) + ", " + DateTime.Now.ToString("d. MMMM yyyy", sk);

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var teams = await TeamsApi.GetTeamsAsync(true);
            var team = teams.FirstOrDefault();
            if (team is null)
            {
                _isLoading = false;
                return;
            }

            _teamId = team.Id;
            _teamName = team.Name;

            var now = DateTime.Now;
            var weekEnd = now.AddDays(7);
            var horizonEnd = now.AddDays(14);
            var recentThreshold = now.AddDays(-7);

            var trainingsTask = TrainingsApi.GetTrainingsAsync(_teamId, now, horizonEnd);
            var excusesTask = ExcusesApi.GetExcusesAsync(null);
            var teamDetailTask = TeamsApi.GetTeamAsync(team.Id);
            var announcementsTask = AnnouncementsApi.GetAnnouncementsAsync(team.Id, null);

            await Task.WhenAll(trainingsTask, excusesTask, teamDetailTask, announcementsTask);

            var upcoming = (await trainingsTask).OrderBy(t => t.StartTime).ToList();
            _nextTraining = upcoming.FirstOrDefault(t => !t.IsCancelled);
            _upcomingTrainings = upcoming.Where(t => _nextTraining is null || t.Id != _nextTraining.Id).ToList();
            _kpiTrainingsThisWeek = upcoming.Count(t => !t.IsCancelled && t.StartTime <= weekEnd);

            var teamDetail = await teamDetailTask;
            _memberCount = teamDetail.Members.Count;

            var excuses = await excusesTask;
            var upcomingIds = upcoming.Select(t => t.Id).ToHashSet();
            // Show excuses that relate to upcoming trainings OR have no specific training attached.
            // Date relevance falls back: DateTo → DateFrom → CreatedAt, so any excuse still open today is included.
            _recentExcuses = excuses
                .Where(e => !e.TrainingEventId.HasValue || upcomingIds.Contains(e.TrainingEventId.Value))
                .Where(e => (e.DateTo ?? e.DateFrom ?? e.CreatedAt) >= now.Date)
                .OrderByDescending(e => e.CreatedAt)
                .Take(8)
                .ToList();

            try { _kpiPendingExcuses = await ExcusesApi.GetPendingCountAsync(); }
            catch { _kpiPendingExcuses = _recentExcuses.Count; }

            if (_nextTraining is not null)
            {
                var d = _nextTraining.StartTime.Date;
                // Three excuse patterns for a given date: exact training ID match, date range containing the date, or single-day DateFrom without DateTo.
                _nextExcusedCount = excuses.Count(e =>
                    e.TrainingEventId == _nextTraining.Id ||
                    (e.DateFrom.HasValue && e.DateTo.HasValue && e.DateFrom.Value.Date <= d && e.DateTo.Value.Date >= d) ||
                    (e.DateFrom.HasValue && !e.DateTo.HasValue && e.DateFrom.Value.Date == d));
                _nextExpectedCount = Math.Max(0, _memberCount - _nextExcusedCount);
            }

            var allAnn = (await announcementsTask).ToList();
            _announcements = allAnn
                .OrderByDescending(a => a.Priority)
                .ThenByDescending(a => a.PublishDate)
                .Take(8)
                .ToList();
            _kpiRecentAnnouncements = allAnn.Count(a => a.PublishDate >= recentThreshold);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("dashboard.coach.errorLoading")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetRelativeTime(DateTime dt)
    {
        var diff = dt - DateTime.Now;
        if (diff.TotalMinutes < 0) return T("dashboard.coach.relative.inProgress");
        if (diff.TotalHours < 1) return string.Format(T("dashboard.coach.relative.inMinutes"), (int)diff.TotalMinutes);
        if (diff.TotalHours < 24) return string.Format(T("dashboard.coach.relative.inHours"), (int)diff.TotalHours);
        var days = (int)Math.Round(diff.TotalDays);
        if (days == 1) return T("dashboard.coach.relative.tomorrow");
        return string.Format(T("dashboard.coach.relative.inDays"), days);
    }



}
