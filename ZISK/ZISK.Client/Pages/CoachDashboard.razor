@page "/coach"
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.DTOs.Excuses
@inject ITeamsApi TeamsApi
@inject ITrainingsApi TrainingsApi
@inject IExcusesApi ExcusesApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Coach")]

<PageTitle>Nástenka trénera</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Dnešok</MudText>

@if (_isLoading)
{
    <MudGrid Spacing="3" Class="mb-4">
        @for (int i = 0; i < 4; i++)
        {
            <MudItem xs="12" sm="6" lg="3">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
            </MudItem>
        }
    </MudGrid>
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" />
}
else
{
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent>
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Najbližší tréning</MudText>

                @if (_nextTraining is null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">Nemáte naplánovaný žiadny nadchádzajúci tréning.</MudAlert>
                }
                else
                {
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.body1">@_nextTraining.Title</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Primary" Class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" Class="mr-2" />
                            @_nextTraining.StartTime.ToString("dd.MM.yyyy HH:mm") - @_nextTraining.EndTime.ToString("HH:mm")
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default" Class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="mr-2" />
                            Miesto: @(_nextTraining.Location ?? "Neuvedené")
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Default" Class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" />
                            @_memberCount hráčov, @_excusedCount ospravedlnení
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-3"
                                   StartIcon="@Icons.Material.Rounded.ChevronRight"
                                   OnClick='() => NavigationManager.NavigateTo($"/coach/treningy/{_nextTraining!.Id}")'>
                            Prejsť na tréning
                        </MudButton>
                    </MudStack>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2">
        <MudCardContent>
            <MudText Typo="Typo.subtitle1" Style="font-weight:600;" Class="mb-2">Nové ospravedlnenky</MudText>

            @if (!_recentExcuses.Any())
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-6" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.body1" Color="Color.Default">Aktuálne nemáte žiadne nové ospravedlnenky.</MudText>
                </MudStack>
            }
            else
            {
                <MudList T="ExcuseListDto" Dense="true">
                    @foreach (var excuse in _recentExcuses)
                    {
                        <MudListItem T="ExcuseListDto">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body2">@excuse.ChildName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@((excuse.DateFrom ?? excuse.CreatedAt).ToString("dd.MM.yyyy")) • @excuse.Reason</MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    </MudCard>
}

@code {
    private bool _isLoading = true;
    private Guid? _teamId;
    private TrainingEventDto? _nextTraining;
    private int _memberCount;
    private int _excusedCount;
    private List<ExcuseListDto> _recentExcuses = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var teams = await TeamsApi.GetTeamsAsync(true);
            var team = teams.FirstOrDefault();
            if (team is null)
                return;

            _teamId = team.Id;

            var now = DateTime.Now;
            var trainingsTask = TrainingsApi.GetTrainingsAsync(_teamId, now, now.AddMonths(1));
            var excusesTask = ExcusesApi.GetExcusesAsync(null);
            var teamDetailTask = TeamsApi.GetTeamAsync(team.Id);

            await Task.WhenAll(trainingsTask, excusesTask, teamDetailTask);

            var trainings = (await trainingsTask).OrderBy(t => t.StartTime).ToList();
            _nextTraining = trainings.FirstOrDefault();
            _memberCount = (await teamDetailTask).Members.Count;

            var upcomingTrainingIds = trainings
                .Where(t => t.StartTime >= now)
                .Select(t => t.Id)
                .ToHashSet();

            var excuses = await excusesTask;
            _recentExcuses = excuses
                .Where(e => e.TrainingEventId.HasValue && upcomingTrainingIds.Contains(e.TrainingEventId.Value))
                .OrderByDescending(e => e.CreatedAt)
                .Take(5)
                .ToList();

            if (_nextTraining is not null)
            {
                var trainingDate = _nextTraining.StartTime.Date;
                _excusedCount = excuses
                    .Count(e => e.TrainingEventId == _nextTraining.Id ||
                                ((e.DateFrom.HasValue && e.DateTo.HasValue && e.DateFrom.Value.Date <= trainingDate && e.DateTo.Value.Date >= trainingDate) ||
                                 (e.DateFrom.HasValue && !e.DateTo.HasValue && e.DateFrom.Value.Date == trainingDate)));
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní nástenky trénera: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
