@page "/oznamy"
@inherits LocalizedComponentBase
@using ZISK.Client.Display
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.Enums
@inject IAnnouncementsApi AnnouncementsApi
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>@T("announcements.pageTitle") - ZISK</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">@T("announcements.pageTitle")</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudSelect T="AnnouncementPriority?" @bind-Value="_filterPriority" Label="@T("announcements.priorityFilterLabel")"
                   Variant="Variant.Outlined" Dense="true" Clearable="true" Style="min-width:200px;">
            <MudSelectItem T="AnnouncementPriority?" Value="@(AnnouncementPriority.High)">@DomainLabels.PriorityText(AnnouncementPriority.High)</MudSelectItem>
            <MudSelectItem T="AnnouncementPriority?" Value="@(AnnouncementPriority.Medium)">@DomainLabels.PriorityText(AnnouncementPriority.Medium)</MudSelectItem>
            <MudSelectItem T="AnnouncementPriority?" Value="@(AnnouncementPriority.Low)">@DomainLabels.PriorityText(AnnouncementPriority.Low)</MudSelectItem>
        </MudSelect>
        <AuthorizeView Roles="Admin,Coach">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Rounded.Add" Href="/oznamy/vytvorit">
                @T("announcements.newAnnouncement")
            </MudButton>
        </AuthorizeView>
    </MudStack>
</MudStack>

@if (_isLoading)
{
    <MudGrid Spacing="3">
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="12" lg="6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="160px" />
            </MudItem>
        }
    </MudGrid>
}
else if (!FilteredAnnouncements.Any())
{
    <MudPaper Class="card-standard empty-state" Elevation="0">
        <MudIcon Icon="@Icons.Material.Rounded.Announcement" Class="empty-state__icon" />
        <div class="empty-state__title">@T("announcements.noAnnouncementsTitle")</div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_filterPriority.HasValue ? T("announcements.noAnnouncementsFiltered") : T("dashboard.panel.noAnnouncementsPublished"))
        </MudText>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var announcement in FilteredAnnouncements)
        {
            <MudItem xs="12" lg="6" Class="d-flex">
                <MudPaper Class="card-standard pa-4 h-100" Elevation="0" Style="@($"width:100%;{GetAnnouncementStyle(announcement)}")">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="2">
                            <MudStack Spacing="0" Style="min-width:0;flex:1;">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (announcement.IsPinned)
                                    {
                                        <MudIcon Icon="@Icons.Material.Rounded.PushPin" Size="Size.Small" Color="Color.Primary" />
                                    }
                                    <MudText Typo="Typo.h6" Style="font-weight:600;">@announcement.Title</MudText>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @announcement.AuthorName • @announcement.PublishDate.ToString("dd.MM.yyyy HH:mm")
                                    @if (!string.IsNullOrEmpty(announcement.TargetTeamName))
                                    {
                                        <text> • @announcement.TargetTeamName</text>
                                    }
                                </MudText>
                            </MudStack>
                            <MudChip T="string" Size="Size.Small" Color="@DomainLabels.PriorityColor(announcement.Priority)">
                                @DomainLabels.PriorityText(announcement.Priority)
                            </MudChip>
                        </MudStack>

                        <MudText Typo="Typo.body2" Color="Color.Default">@announcement.ContentPreview</MudText>

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-1">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                @if (announcement.AttachmentCount > 0)
                                {
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Rounded.AttachFile" Size="Size.Small" Color="Color.Secondary" />
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@announcement.AttachmentCount</MudText>
                                    </MudStack>
                                }
                                @if (announcement.ValidUntil.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @T("announcements.validUntil") @announcement.ValidUntil.Value.ToString("dd.MM.yyyy")
                                    </MudText>
                                }
                            </MudStack>
                            <AuthorizeView Roles="Admin,Coach">
                                <MudStack Row="true" Spacing="0">
                                    <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small"
                                                   Href="@($"/oznamy/upravit/{announcement.Id}")" />
                                    <MudIconButton Icon="@Icons.Material.Rounded.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteAnnouncement(announcement.Id))" />
                                </MudStack>
                            </AuthorizeView>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
</MudContainer>

@code {
    private bool _isLoading = true;
    private List<AnnouncementListDto> _announcements = new();
    private AnnouncementPriority? _filterPriority;

    private IEnumerable<AnnouncementListDto> FilteredAnnouncements =>
        _filterPriority.HasValue
            ? _announcements.Where(a => a.Priority == _filterPriority.Value)
            : _announcements;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnouncements();
    }

    private async Task LoadAnnouncements()
    {
        try
        {
            _isLoading = true;
            _announcements = await AnnouncementsApi.GetAnnouncementsAsync(null, null);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetAnnouncementStyle(AnnouncementListDto announcement)
    {
        var borderColor = announcement.Priority switch
        {
            AnnouncementPriority.High => "var(--mud-palette-error)",
            AnnouncementPriority.Medium => "var(--mud-palette-warning)",
            _ => "var(--mud-palette-info)"
        };
        return $"border-left: 4px solid {borderColor};";
    }



    private async Task DeleteAnnouncement(Guid id)
    {
        try
        {
            await AnnouncementsApi.DeleteAnnouncementAsync(id);
            Snackbar.Add(T("announcements.deleted"), Severity.Success);
            await LoadAnnouncements();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }
}
