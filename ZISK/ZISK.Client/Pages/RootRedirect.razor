@page "/"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Presmerovanie</PageTitle>

<MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Role priority order is intentional: Admin > Coach > Child/Athlete > default (Parent → /domov).
        // If a user has multiple roles, the first match wins. Parent has no explicit branch and falls through to the default.
        if (user.IsInRole("Admin"))
        {
            NavigationManager.NavigateTo("/admin", replace: true);
            return;
        }

        if (user.IsInRole("Coach"))
        {
            NavigationManager.NavigateTo("/coach", replace: true);
            return;
        }

        if (user.IsInRole("Child") || user.IsInRole("Athlete"))
        {
            NavigationManager.NavigateTo("/dieta", replace: true);
            return;
        }

        NavigationManager.NavigateTo("/domov", replace: true);
    }
}
