@page "/ospravedlnenky"
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.Enums
@inject IExcusesApi ExcusesApi
@inject IChildrenApi ChildrenApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Ospravedlnenky</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h4">Ospravedlnenky</MudText>
        </MudStack>
        @if (_canCreateExcuse)
        {
            <MudHidden Breakpoint="Breakpoint.SmAndDown">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           Href="/ospravedlnenky/vytvorit">
                    Nová ospravedlnenka
                </MudButton>
            </MudHidden>
        }
    </MudStack>

    @if (_childFilterOptions.Count > 1)
    {
        <MudPaper Elevation="0" Class="pa-2 mb-3">
            <MudToggleGroup T="string" @bind-Value="_selectedChildId" Color="Color.Primary" SelectionMode="SelectionMode.SingleSelection" CheckMark="true">
                @foreach (var opt in _childFilterOptions)
                {
                    <MudToggleItem Value="@opt.Key" Text="@opt.Label" />
                }
            </MudToggleGroup>
        </MudPaper>
    }

    @if (_isLoading)
    {
        <MudStack Spacing="2">
            @for (int i = 0; i < 5; i++)
            {
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
            }
        </MudStack>
    }
    else if (_error != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }
    else if (!FilteredExcuses.Any())
    {
        <MudPaper Class="pa-6" Elevation="1">
            <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Zatiaľ nemáte žiadne ospravedlnenky.</MudText>
                @if (_canCreateExcuse)
                {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenCreateDialog">
                        Vytvoriť prvú ospravedlnenku
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudTable Items="@FilteredExcuses" Hover="true" Elevation="3" Striped="true">
                <HeaderContent>
                    <MudTh>Koho</MudTh>
                    <MudTh>Dátum</MudTh>
                    <MudTh>Dôvod</MudTh>
                    <MudTh>Stav</MudTh>
                    <MudTh>Akcie</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Koho">@context.ChildName</MudTd>
                    <MudTd DataLabel="Dátum">@FormatDateRange(context.DateFrom, context.DateTo)</MudTd>
                    <MudTd DataLabel="Dôvod">@(string.IsNullOrWhiteSpace(context.Reason) ? "-" : context.Reason)</MudTd>
                    <MudTd DataLabel="Stav">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                            @GetStatusText(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Akcie">
                        @if (_canCreateExcuse)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => OpenEditDialog(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => DeleteExcuse(context.Id))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudHidden>

        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudStack Spacing="2">
                @foreach (var excuse in FilteredExcuses)
                {
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2">@excuse.ChildName</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(excuse.Status)">
                                    @GetStatusText(excuse.Status)
                                </MudChip>
                            </MudStack>

                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @FormatDateRange(excuse.DateFrom, excuse.DateTo)
                            </MudText>

                            <MudText Typo="Typo.body2">
                                @(string.IsNullOrWhiteSpace(excuse.Reason) ? "Bez dôvodu" : excuse.Reason)
                            </MudText>

                            @if (_canCreateExcuse)
                            {
                                <MudStack Row="true" Justify="Justify.FlexEnd">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(excuse))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteExcuse(excuse.Id))" />
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        </MudHidden>
    }
</MudContainer>

@if (_canCreateExcuse)
{
    <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OpenCreateDialog" Class="parent-excuse-fab" />
}

<style>
    .parent-excuse-fab {
        position: fixed;
        right: 20px;
        bottom: 90px;
        z-index: 1201;
    }

    @@media (min-width: 960px) {
        .parent-excuse-fab {
            display: none;
        }
    }
</style>

@code {
    private record FilterOption(string Key, string Label);
    private const string AllChildrenKey = "all";

    private bool _isLoading = true;
    private string? _error;
    private List<ExcuseListDto> _excuses = new();
    private List<FilterOption> _childFilterOptions = new();
    private string _selectedChildId = AllChildrenKey;
    private bool _canCreateExcuse = true;
    private bool _openCreateOnLoad;

    private IEnumerable<ExcuseListDto> FilteredExcuses =>
        _selectedChildId == AllChildrenKey
            ? _excuses
            : _excuses.Where(e => e.ChildId == _selectedChildId);

protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _canCreateExcuse = !authState.User.IsInRole("Child");

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        _openCreateOnLoad = QueryHasCreateFlag(uri.Query);

        await LoadExcuses();
        await BuildFilterOptions();
    }

    private async Task BuildFilterOptions()
    {
        try
        {
            var children = (await ChildrenApi.GetMyChildrenAsync())
                .Where(c => !c.IsOwnProfile)
                .OrderBy(c => c.LastName).ThenBy(c => c.FirstName)
                .ToList();

            if (children.Count <= 1)
            {
                _childFilterOptions = new();
                return;
            }

            var options = new List<FilterOption> { new(AllChildrenKey, "Všetky deti") };
            options.AddRange(children.Select(c => new FilterOption(c.Id, c.FirstName)));
            _childFilterOptions = options;
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _openCreateOnLoad && _canCreateExcuse)
        {
            _openCreateOnLoad = false;
            await OpenCreateDialog();
            NavigationManager.NavigateTo("/ospravedlnenky", replace: true);
        }
    }

    private async Task LoadExcuses()
    {
        try
        {
            _isLoading = true;
            _excuses = await ExcusesApi.GetMyExcusesAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Color GetStatusColor(ExcuseStatus status) => status switch
    {
        ExcuseStatus.Received => Color.Info,
        _ => Color.Default
    };

    private string GetStatusText(ExcuseStatus status) => status switch
    {
        ExcuseStatus.Received => "Prijaté",
        _ => "Neznámy"
    };

    private async Task DeleteExcuse(Guid id)
    {
        try
        {
            await ExcusesApi.DeleteExcuseAsync(id);
            Snackbar.Add("Ospravedlnenka vymazaná", Severity.Success);
            await LoadExcuses();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>("Nová ospravedlnenka", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadExcuses();
        }
    }

    private async Task OpenEditDialog(ExcuseListDto excuse)
    {
        ExcuseDto detail;
        try
        {
            detail = await ExcusesApi.GetExcuseAsync(excuse.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní ospravedlnenky: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
            return;
        }

        var parameters = new DialogParameters { [nameof(EditExcuseDialog.Excuse)] = detail };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditExcuseDialog>("Upraviť ospravedlnenku", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            await LoadExcuses();
        }
    }

    private static bool QueryHasCreateFlag(string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return false;

        var trimmed = query.TrimStart('?');
        var parts = trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var part in parts)
        {
            var kvp = part.Split('=', 2);
            if (kvp.Length == 2 && kvp[0].Equals("create", StringComparison.OrdinalIgnoreCase))
            {
                return kvp[1].Equals("true", StringComparison.OrdinalIgnoreCase);
            }
        }

        return false;
    }

    private static string FormatDateRange(DateTime? from, DateTime? to)
    {
        if (from.HasValue && to.HasValue)
            return $"{from.Value:dd.MM.yyyy} - {to.Value:dd.MM.yyyy}";

        if (from.HasValue)
            return from.Value.ToString("dd.MM.yyyy");

        return "-";
    }
}