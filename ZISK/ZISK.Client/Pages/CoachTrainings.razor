@page "/coach/treningy"
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.Enums
@inject ITeamsApi TeamsApi
@inject ITrainingsApi TrainingsApi
@inject IAnnouncementsApi AnnouncementsApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Coach")]

<PageTitle>Tréningy</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
    <MudText Typo="Typo.h5">Tréningy</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenCreateDialog">
        Pridať tréning
    </MudButton>
</MudStack>

<MudToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" Color="Color.Primary" Class="mb-4" @bind-Value="_listMode">
    <MudToggleItem Value="@("Tyden")">Týždeň</MudToggleItem>
    <MudToggleItem Value="@("Mesiac")">Mesiac</MudToggleItem>
</MudToggleGroup>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_trainings.Any())
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudStack Spacing="2" AlignItems="AlignItems.Start">
            <MudAlert Severity="Severity.Info" Dense="true">Zatiaľ nemáte žiadne naplánované tréningy.</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenCreateDialog">
                Pridať prvý tréning
            </MudButton>
        </MudStack>
    </MudPaper>
}
else
{
    <MudStack Spacing="2">
        @foreach (var training in VisibleTrainings)
        {
            <MudCard Elevation="1" Class="mb-3">
                <MudCardContent>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0" Style="cursor:pointer" @onclick='() => NavigationManager.NavigateTo($"/coach/treningy/{training.Id}")'>
                            <MudText Typo="Typo.body1">@training.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">@training.StartTime.ToString("dd.MM.yyyy HH:mm") - @training.EndTime.ToString("HH:mm")</MudText>
                            @if (!string.IsNullOrWhiteSpace(training.Location))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@training.Location</MudText>
                            }
                        </MudStack>

                        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Edit" OnClick="() => OpenEditDialog(training)">
                                    Upraviť
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Rounded.Delete" OnClick="() => OpenDeleteDialog(training)">
                                    Zrušiť
                                </MudButton>
                            </MudStack>
                        </MudHidden>

                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudMenu Icon="@Icons.Material.Rounded.MoreVert">
                                <MudMenuItem Icon="@Icons.Material.Rounded.Edit" OnClick="() => OpenEditDialog(training)">Upraviť</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Rounded.Delete" IconColor="Color.Error" OnClick="() => OpenDeleteDialog(training)">Zrušiť tréning</MudMenuItem>
                            </MudMenu>
                        </MudHidden>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
}

<MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Fixed="true" Style="bottom: 24px; right: 24px; z-index: 100;" Class="coach-fab" OnClick="OpenCreateDialog" />

<MudDialog @bind-Visible="_editDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">@(_editingTraining is null ? "Pridať tréning" : "Upraviť tréning")</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudDatePicker @bind-Date="_date" Label="Dátum" Variant="Variant.Outlined" />
            <MudTimePicker @bind-Time="_from" Label="Čas od" Variant="Variant.Outlined" />
            <MudTimePicker @bind-Time="_to" Label="Čas do" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_location" Label="Miesto" Variant="Variant.Outlined" />
            <MudSelect T="TrainingType" @bind-Value="_type" Label="Typ tréningu" Variant="Variant.Outlined">
                <MudSelectItem Value="TrainingType.Conditioning">Bežný</MudSelectItem>
                <MudSelectItem Value="TrainingType.Match">Zápas</MudSelectItem>
                <MudSelectItem Value="TrainingType.Other">Sústredenie</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogVisible = false">Zrušiť</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveTraining">Uložiť</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_deleteDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">Zrušiť tréning</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">Naozaj chcete zrušiť tréning "@_deletingTraining?.Title"?</MudText>
        <MudCheckBox @bind-Value="_sendAutoAnnouncement" Label="Odoslať automatický oznam rodičom" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteDialogVisible = false">Nie</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="DeleteTraining">Zrušiť tréning</MudButton>
    </DialogActions>
</MudDialog>

<style>
    @@media (min-width: 960px) {
        .coach-fab {
            display: none;
        }
    }
</style>

@code {
    private bool _isLoading = true;
    private Guid? _teamId;
    private List<TrainingEventDto> _trainings = [];
    private string _listMode = "Tyden";

    private bool _editDialogVisible;
    private TrainingEventDto? _editingTraining;
    private DateTime? _date = DateTime.Today;
    private TimeSpan? _from = new TimeSpan(17, 0, 0);
    private TimeSpan? _to = new TimeSpan(18, 30, 0);
    private string _location = string.Empty;
    private TrainingType _type = TrainingType.Conditioning;

    private bool _deleteDialogVisible;
    private TrainingEventDto? _deletingTraining;
    private bool _sendAutoAnnouncement;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private IEnumerable<TrainingEventDto> VisibleTrainings
    {
        get
        {
            var now = DateTime.Now;
            var to = _listMode == "Tyden" ? now.AddDays(7) : now.AddMonths(1);
            return _trainings.Where(t => t.StartTime >= now && t.StartTime <= to);
        }
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;
            var team = (await TeamsApi.GetTeamsAsync(true)).FirstOrDefault();
            if (team is null)
                return;

            _teamId = team.Id;
            _trainings = (await TrainingsApi.GetTrainingsAsync(_teamId, DateTime.Today.AddMonths(-1), DateTime.Today.AddMonths(3)))
                .OrderBy(t => t.StartTime)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní tréningov: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _editingTraining = null;
        _date = DateTime.Today;
        _from = new TimeSpan(17, 0, 0);
        _to = new TimeSpan(18, 30, 0);
        _location = string.Empty;
        _type = TrainingType.Conditioning;
        _editDialogVisible = true;
    }

    private void OpenEditDialog(TrainingEventDto training)
    {
        _editingTraining = training;
        _date = training.StartTime.Date;
        _from = training.StartTime.TimeOfDay;
        _to = training.EndTime.TimeOfDay;
        _location = training.Location ?? string.Empty;
        _type = training.Type;
        _editDialogVisible = true;
    }

    private async Task SaveTraining()
    {
        if (_teamId is null || !_date.HasValue || !_from.HasValue || !_to.HasValue)
            return;

        var start = _date.Value.Date.Add(_from.Value);
        var end = _date.Value.Date.Add(_to.Value);
        var title = _type switch
        {
            TrainingType.Match => "Zápas",
            TrainingType.Other => "Sústredenie",
            _ => "Bežný tréning"
        };

        try
        {
            if (_editingTraining is null)
            {
                await TrainingsApi.CreateTrainingAsync(new CreateTrainingEventRequest(_teamId.Value, title, start, end, _location, _type, null));
            }
            else
            {
                await TrainingsApi.UpdateTrainingAsync(_editingTraining.Id, new UpdateTrainingEventRequest(title, start, end, _location, _type, _editingTraining.CoachNote, _editingTraining.IsLocked));
            }

            _editDialogVisible = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri ukladaní tréningu: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteDialog(TrainingEventDto training)
    {
        _deletingTraining = training;
        _sendAutoAnnouncement = true;
        _deleteDialogVisible = true;
    }

    private async Task DeleteTraining()
    {
        if (_deletingTraining is null || _teamId is null)
            return;

        try
        {
            if (_sendAutoAnnouncement)
            {
                await AnnouncementsApi.CreateAnnouncementAsync(new CreateAnnouncementRequest(
                    "Zrušený tréning",
                    $"Tréning {_deletingTraining.StartTime:dd.MM.yyyy HH:mm} bol zrušený.",
                    _teamId,
                    TargetAudience.All,
                    AnnouncementPriority.Medium,
                    false,
                    null));
            }

            await TrainingsApi.DeleteTrainingAsync(_deletingTraining.Id);
            _deleteDialogVisible = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri rušení tréningu: {ex.Message}", Severity.Error);
        }
    }
}
