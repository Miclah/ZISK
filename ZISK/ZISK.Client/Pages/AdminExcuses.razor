@page "/admin/ospravedlnenky"
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.Enums
@inject IExcusesApi ExcusesApi
@inject ISnackbar Snackbar
@attribute [Authorize(Roles = "Admin,Coach")]

<PageTitle>Správa ospravedlneniek</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Color="Color.Warning" />
    <MudText Typo="Typo.h4">Správa ospravedlneniek</MudText>
</MudStack>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 6; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        }
    </MudStack>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}
else if (!_excuses.Any())
{
    <MudPaper Class="pa-6" Elevation="1">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
            <MudText Typo="Typo.body1" Color="Color.Secondary">Žiadne ospravedlnenky na spracovanie</MudText>
        </MudStack>
    </MudPaper>
}
else
{
    <MudTable Items="@_excuses" Hover="true" Elevation="3" Striped="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Dieťa</MudTh>
            <MudTh>Tím</MudTh>
            <MudTh>Dátum</MudTh>
            <MudTh>Dôvod</MudTh>
            <MudTh>Stav</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Dieťa">@context.ChildName</MudTd>
            <MudTd DataLabel="Tím">@context.TeamName</MudTd>
            <MudTd DataLabel="Dátum">
                @if (context.DateFrom.HasValue)
                {
                    @context.DateFrom.Value.ToString("dd.MM.yyyy")
                }
            </MudTd>
            <MudTd DataLabel="Dôvod">@context.Reason</MudTd>
            <MudTd DataLabel="Stav">
                <MudChip T="string" Size="Size.Small" Color="Color.Info">
                    Prijaté
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>Žiadne ospravedlnenky</MudText>
        </NoRecordsContent>
    </MudTable>
}
</MudContainer>

@code {
    private bool _isLoading = true;
    private string? _error;
    private List<ExcuseListDto> _excuses = new();

protected override async Task OnInitializedAsync()
    {
        await LoadExcuses();
    }

    private async Task LoadExcuses()
    {
        try
        {
            _isLoading = true;
            _excuses = await ExcusesApi.GetExcusesAsync(null);
        }
        catch (Exception ex)
        {
            _error = ApiErrorFormatter.ToUserMessage(ex);
            Snackbar.Add(_error, Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }
}