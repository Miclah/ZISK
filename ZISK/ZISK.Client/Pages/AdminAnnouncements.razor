@page "/admin/systemove-oznamy"
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.DTOs.Teams
@using ZISK.Shared.Enums
@inject IAnnouncementsApi AnnouncementsApi
@inject ITeamsApi TeamsApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Systémové oznamy</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">Systémové oznamy</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        Vytvoriť oznam
    </MudButton>
</MudStack>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 5; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="72px" />
        }
    </MudStack>
}
else if (!_announcements.Any())
{
    <MudAlert Severity="Severity.Info">Zatiaľ neexistujú žiadne systémové oznamy.</MudAlert>
}
else
{
    <MudHidden Breakpoint="Breakpoint.MdAndDown">
        <MudTable Items="_announcements" Hover="true" Dense="true" Elevation="2">
            <HeaderContent>
                <MudTh>Názov</MudTh>
                <MudTh>Dátum</MudTh>
                <MudTh>Autor</MudTh>
                <MudTh>Cieľ</MudTh>
                <MudTh Style="text-align:right">Akcie</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.body1">@context.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.ContentPreview</MudText>
                    </MudStack>
                </MudTd>
                <MudTd>@context.PublishDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
                <MudTd>@context.AuthorName</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.TargetTeamName) ? "Celý klub" : context.TargetTeamName)</MudTd>
                <MudTd Style="text-align:right">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="() => ConfirmDelete(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.LgAndUp">
        <MudStack Spacing="2">
            @foreach (var announcement in _announcements)
            {
                <MudPaper Class="pa-3" Elevation="1">
                    <MudStack Spacing="1">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudText Typo="Typo.subtitle2" Style="flex: 1; margin-right: 8px;">@announcement.Title</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Class="pa-0"
                                           Style="flex-shrink: 0;"
                                           OnClick="() => ConfirmDelete(announcement)" />
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@announcement.ContentPreview</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @announcement.PublishDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Tertiary">•</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(string.IsNullOrWhiteSpace(announcement.TargetTeamName) ? "Celý klub" : announcement.TargetTeamName)
                            </MudText>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </MudHidden>
}
</MudContainer>

<MudDialog @bind-Visible="_createDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Nový systémový oznam</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_announcementModel" OnValidSubmit="CreateAnnouncement">
            <DataAnnotationsValidator />
            <MudStack Spacing="3" Class="py-2">
                <MudTextField @bind-Value="_announcementModel.Title"
                              For="@(() => _announcementModel.Title)"
                              Label="Názov" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_announcementModel.Content"
                              For="@(() => _announcementModel.Content)"
                              Label="Obsah" Variant="Variant.Outlined" Lines="5" />
                <MudSelect T="string" @bind-Value="_announcementModel.TargetMode" Label="Cieľ oznamu" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("All")">Celý klub</MudSelectItem>
                    <MudSelectItem Value="@("Team")">Konkrétny tím</MudSelectItem>
                </MudSelect>
                @if (_announcementModel.TargetMode == "Team")
                {
                    <MudSelect T="Guid?" @bind-Value="_announcementModel.TargetTeamId"
                               For="@(() => _announcementModel.TargetTeamId)"
                               Label="Vyberte tím" Variant="Variant.Outlined">
                        @foreach (var team in _teams)
                        {
                            <MudSelectItem Value="@((Guid?)team.Id)">@team.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                <LoadingButton ButtonType="ButtonType.Submit"
                              Color="Color.Primary"
                              Variant="Variant.Filled"
                              Loading="_isSaving"
                              FullWidth="true">
                    Uložiť
                </LoadingButton>
            </MudStack>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    private bool _isLoading = true;
    private bool _isSaving;

    private List<AnnouncementListDto> _announcements = new();
    private List<TeamDto> _teams = new();

    private bool _createDialogVisible;
    private AnnouncementFormModel _announcementModel = new();

protected override async Task OnInitializedAsync()
    {
        await LoadData();
        if (NavigationManager.Uri.Contains("action=create", StringComparison.OrdinalIgnoreCase))
            OpenCreateDialog();
    }

    private async Task LoadData()
    {
        try
        {
            _isLoading = true;

            var announcementsTask = AnnouncementsApi.GetAnnouncementsAsync(null, null);
            var teamsTask = TeamsApi.GetTeamsAsync(true);

            await Task.WhenAll(announcementsTask, teamsTask);

            _announcements = (await announcementsTask)
                .OrderByDescending(a => a.PublishDate)
                .ToList();

            _teams = await teamsTask;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Nepodarilo sa načítať oznamy: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _announcementModel = new AnnouncementFormModel();
        _createDialogVisible = true;
    }

    private void CloseCreateDialog()
    {
        _createDialogVisible = false;
    }

    private async Task CreateAnnouncement()
    {
        _isSaving = true;
        try
        {
            var request = new CreateAnnouncementRequest(
                _announcementModel.Title,
                _announcementModel.Content,
                _announcementModel.TargetMode == "Team" ? _announcementModel.TargetTeamId : null,
                TargetAudience.All,
                AnnouncementPriority.Medium,
                false,
                null);

            await AnnouncementsApi.CreateAnnouncementAsync(request);
            Snackbar.Add("Oznam bol vytvorený.", Severity.Success);
            _createDialogVisible = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri ukladaní oznamu: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ConfirmDelete(AnnouncementListDto announcement)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Potvrdenie zmazania",
            $"Naozaj chcete zmazať oznam '{announcement.Title}'?",
            yesText: "Zmazať",
            cancelText: "Zrušiť",
            options: new DialogOptions { MaxWidth = MaxWidth.Small });

        if (result != true)
            return;

        try
        {
            await AnnouncementsApi.DeleteAnnouncementAsync(announcement.Id);
            Snackbar.Add("Oznam bol zmazaný.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri mazaní oznamu: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    public class AnnouncementFormModel
    {
        [Required(ErrorMessage = "Názov je povinný.")]
        [StringLength(200, MinimumLength = 3, ErrorMessage = "Názov musí mať 3 – 200 znakov.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Obsah je povinný.")]
        [StringLength(5000, MinimumLength = 10, ErrorMessage = "Obsah musí mať 10 – 5000 znakov.")]
        public string Content { get; set; } = string.Empty;

        public string TargetMode { get; set; } = "All";
        public Guid? TargetTeamId { get; set; }
    }
}
