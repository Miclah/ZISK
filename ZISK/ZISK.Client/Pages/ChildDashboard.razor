@page "/dieta"
@inherits LocalizedComponentBase
@using ZISK.Client.Layout
@using ZISK.Client.Display
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.Enums
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject IAnnouncementsApi AnnouncementsApi
@inject IAttendanceApi AttendanceApi
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Child,Athlete")]
@using ZISK.Client.Components
@using ZISK.Client.Components.Dashboard

<PageTitle>@T("dashboard.child.pageTitle") - ZISK</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
    @if (_isLoading)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="88px" />
            <MudGrid Spacing="3">
                @for (int i = 0; i < 4; i++)
                {
                    <MudItem xs="6" md="3">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="76px" />
                    </MudItem>
                }
            </MudGrid>
            <MudGrid Spacing="3">
                <MudItem xs="12" lg="8"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" /></MudItem>
                <MudItem xs="12" lg="4"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="260px" /></MudItem>
            </MudGrid>
        </MudStack>
    }
    else
    {
        <DashboardHero FirstName="@(_profile?.FirstName ?? "")"
                       Greeting="@T("dashboard.child.greeting")"
                       Subtitle="@HeroSubtitle">
            <Actions>
                @* Athlete can submit excuses themselves; Child cannot — a Parent does it on their behalf. *@
                @if (_isAthlete)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                               Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                               StartIcon="@Icons.Material.Rounded.Description"
                               OnClick="OpenAddExcuseDialog">
                        @T("dashboard.family.newExcuse")
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                           Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                           StartIcon="@Icons.Material.Rounded.CalendarMonth"
                           OnClick="@(() => NavigationManager.NavigateTo("/kalendar"))">
                    @T("dashboard.panel.calendar")
                </MudButton>
            </Actions>
        </DashboardHero>

        <MudGrid Spacing="3" Class="mb-3">
            <MudItem xs="6" md="3">
                <CompactStatCard Icon="@Icons.Material.Rounded.TrendingUp"
                                 Value="@($"{_attendancePercent}%")"
                                 Label="@T("dashboard.child.attendance")"
                                 IconColor="Color.Primary" />
            </MudItem>
            <MudItem xs="6" md="3">
                <CompactStatCard Icon="@Icons.Material.Rounded.CheckCircle"
                                 Value="@((_stats?.Present ?? 0).ToString())"
                                 Label="@T("dashboard.child.presentShort")"
                                 IconColor="Color.Success" />
            </MudItem>
            <MudItem xs="6" md="3">
                <CompactStatCard Icon="@Icons.Material.Rounded.EventBusy"
                                 Value="@((_stats?.Excused ?? 0).ToString())"
                                 Label="@T("dashboard.child.excusedShort")"
                                 IconColor="Color.Warning" />
            </MudItem>
            <MudItem xs="6" md="3">
                <CompactStatCard Icon="@Icons.Material.Rounded.Cancel"
                                 Value="@((_stats?.Absent ?? 0).ToString())"
                                 Label="@T("dashboard.child.absentShort")"
                                 IconColor="Color.Error" />
            </MudItem>
        </MudGrid>

        @if (_stats is { Total: > 0 })
        {
            <MudPaper Class="card-standard pa-4 mb-3" Elevation="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @string.Format(T("dashboard.child.presentOfTotal"), _stats.Present, _stats.Total)
                    </MudText>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_attendancePercent%</MudText>
                </MudStack>
                <MudProgressLinear Color="Color.Success" Value="@_attendancePercent" Rounded="true" Size="Size.Medium" />
            </MudPaper>
        }

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <MudStack Spacing="3">
                    <MudPaper Class="card-standard pa-4" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Rounded.Event" Color="Color.Primary" />
                                <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@T("dashboard.child.nextTraining")</MudText>
                            </MudStack>
                            @if (NextTraining is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@CountdownLabel(NextTraining.StartTime)</MudChip>
                            }
                        </MudStack>

                        @if (NextTraining is null)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@T("dashboard.child.noUpcomingTraining")</MudText>
                        }
                        else
                        {
                            <MudPaper Elevation="0" Class="pa-4"
                                      Style="@($"background:{ThemeColors.Tint(ThemeColors.Primary)}; border-left:4px solid {ThemeColors.Primary}; border-radius:8px;")">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                                        <MudText Typo="Typo.h5" Style="font-weight:700;">@NextTraining.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@DomainLabels.TrainingTypeColor(NextTraining.Type)">
                                            @DomainLabels.TrainingTypeText(NextTraining.Type)
                                        </MudChip>
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Rounded.Schedule" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body1">
                                            @NextTraining.StartTime.ToString("dddd d. MMMM, HH:mm") @("–") @NextTraining.EndTime.ToString("HH:mm")
                                        </MudText>
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Rounded.Place" Size="Size.Small" Color="Color.Primary" />
                                        <MudText Typo="Typo.body1">@(NextTraining.Location ?? T("dashboard.locationNotSpecified"))</MudText>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudPaper>

                    <MudPaper Class="card-standard pa-4" Elevation="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                            <MudIcon Icon="@Icons.Material.Rounded.History" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle1" Style="font-weight:600;">@T("dashboard.child.recentAttendanceRecords")</MudText>
                        </MudStack>
                        @if (!_recentAttendance.Any())
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@T("dashboard.child.noRecordsYet")</MudText>
                        }
                        else
                        {
                            <MudTable Items="@_recentAttendance" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>@T("dashboard.child.date")</MudTh>
                                    <MudTh>@T("dashboard.child.training")</MudTh>
                                    <MudTh>@T("dashboard.child.status")</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@T("dashboard.child.date")">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                                    <MudTd DataLabel="@T("dashboard.child.training")">@context.TrainingName</MudTd>
                                    <MudTd DataLabel="@T("dashboard.child.status")">
                                        <MudChip T="string" Size="Size.Small" Class="@DomainLabels.AttendanceStatusChipClass(context.Status)">
                                            @DomainLabels.AttendanceStatusText(context.Status)
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudPaper>
                </MudStack>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudStack Spacing="3">
                    <UpcomingTrainingsMiniPanel Items="@OtherTrainings"
                                                Title="@T("dashboard.child.otherTrainingsPanel")"
                                                EmptyText="@T("dashboard.panel.noUpcomingTrainings")"
                                                MaxItems="4"
                                                OnShowAll="@(() => NavigationManager.NavigateTo("/kalendar"))" />

                    <RecentAnnouncementsPanel Announcements="@_announcements"
                                              EmptyText="@T("dashboard.child.noTeamAnnouncements")"
                                              OnShowAll="@(() => NavigationManager.NavigateTo("/oznamy"))" />
                </MudStack>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private bool _isAthlete;
    private ChildDto? _profile;
    private List<TrainingEventDto> _upcomingTrainings = new();
    private List<AnnouncementListDto> _announcements = new();
    private List<UserAttendanceDto> _recentAttendance = new();
    private AttendanceStatsDto? _stats;
    private int _attendancePercent;

    private TrainingEventDto? NextTraining => _upcomingTrainings.FirstOrDefault();

    /// <summary>Everything after the first entry, which is already shown as the highlighted card.</summary>
    private List<UpcomingTrainingsMiniPanel.Item> OtherTrainings => _upcomingTrainings
        .Skip(1)
        .Select(t => new UpcomingTrainingsMiniPanel.Item(t, string.Empty))
        .ToList();

    private string HeroSubtitle
    {
        get
        {
            var team = _profile?.TeamName ?? T("dashboard.child.noTeam");
            return _profile?.DateOfBirth is { } dob
                ? $"{team} · {T("dashboard.child.bornPrefix")} {dob:dd.MM.yyyy}"
                : team;
        }
    }

    /// <summary>
    /// "Dnes" / "Zajtra" / "o N dní". Slovak picks between three plural forms, which is why this is a
    /// switch rather than a single format string.
    /// </summary>
    private string CountdownLabel(DateTime start)
    {
        var days = (start.Date - DateTime.Now.Date).Days;

        return days switch
        {
            <= 0 => T("dashboard.child.today"),
            1 => T("dashboard.child.tomorrow"),
            <= 4 => string.Format(T("dashboard.child.inDaysFew"), days),
            _ => string.Format(T("dashboard.child.inDaysMany"), days)
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAthlete = auth.User.IsInRole("Athlete");

            var profiles = await ChildrenApi.GetMyChildrenAsync();
            _profile = profiles.FirstOrDefault();

            var seasonStart = new DateTime(DateTime.Now.Year, DateTime.Now.Month >= 8 ? 8 : 1, 1);

            if (_profile?.TeamId is not null)
            {
                var trainings = await TrainingsApi.GetTrainingsAsync(_profile.TeamId, DateTime.Now, DateTime.Now.AddMonths(1));
                _upcomingTrainings = trainings.OrderBy(t => t.StartTime).ToList();
                _announcements = (await AnnouncementsApi.GetAnnouncementsAsync(_profile.TeamId, null))
                    .OrderByDescending(a => a.PublishDate).Take(3).ToList();
            }

            try
            {
                _stats = await AttendanceApi.GetMemberStatsAsync(_profile?.Id ?? string.Empty, seasonStart, DateTime.Now);
                if (_stats is not null && _stats.Total > 0)
                    _attendancePercent = (int)Math.Round((_stats.Present + _stats.Excused) * 100.0 / _stats.Total);
            }
            catch { }

            try
            {
                _recentAttendance = (await AttendanceApi.GetMyAttendanceAsync(seasonStart, DateTime.Now))
                    .OrderByDescending(a => a.Date).Take(6).ToList();
            }
            catch { }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("dashboard.child.errorLoading")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenAddExcuseDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>(T("dashboard.family.newExcuse"), options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await OnInitializedAsync();
    }
}
