@page "/dieta"
@using ZISK.Client.Layout
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.DTOs.Trainings
@using ZISK.Shared.DTOs.Announcements
@using ZISK.Shared.Enums
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject IAnnouncementsApi AnnouncementsApi
@inject IAttendanceApi AttendanceApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize(Roles = "Child,Athlete")]
@using ZISK.Client.Components

<PageTitle>Môj prehľad</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-2">
    @if (_isLoading)
    {
        <MudStack Spacing="3">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="80px" />
            <MudGrid Spacing="3">
                @for (int i = 0; i < 3; i++)
                {
                    <MudItem xs="12" sm="4">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" />
                    </MudItem>
                }
            </MudGrid>
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="240px" />
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="0" Class="dashboard-hero mb-3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudAvatar Color="Color.Surface" Size="Size.Medium" Style="@($"color:{_cPrimary};")">
                        @((_profile?.FirstName ?? "?").Substring(0, 1).ToUpper())
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <h1 class="dashboard-hero__greeting">Ahoj, @(_profile?.FirstName ?? "")</h1>
                        <div class="dashboard-hero__subtitle">@(_profile?.TeamName ?? "Bez tímu")</div>
                    </MudStack>
                </MudStack>
                @if (_isAthlete)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit"
                               Style="border-color: rgba(255,255,255,0.4); color: #fff;"
                               StartIcon="@Icons.Material.Rounded.Description"
                               OnClick="OpenAddExcuseDialog">
                        Nová ospravedlnenka
                    </MudButton>
                }
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3" Class="mb-3">
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Môj profil</MudText>
                        @if (_profile is null)
                        {
                            <MudText Typo="Typo.body2">Profil nie je dostupný.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                <div>
                                    <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">Meno</MudText>
                                    <MudText Typo="Typo.body1" Style="font-weight:600;">@_profile.FirstName @_profile.LastName</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">Dátum narodenia</MudText>
                                    <MudText Typo="Typo.body1">@(_profile.DateOfBirth?.ToString("dd.MM.yyyy") ?? "-")</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">Tím</MudText>
                                    <MudText Typo="Typo.body1">@(_profile.TeamName ?? "Bez tímu")</MudText>
                                </div>
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Najbližšie tréningy</MudText>
                        @if (!_upcomingTrainings.Any())
                        {
                            <MudText Typo="Typo.body2">Žiadny najbližší tréning.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @{ var first = _upcomingTrainings.First(); }
                                <div>
                                    <MudText Typo="Typo.body1" Style="font-weight:600;">@first.Title</MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Rounded.Schedule" Size="Size.Small" Style="@($"color:{_cPrimary};")" />
                                        <MudText Typo="Typo.body2">@first.StartTime.ToString("dd.MM.yyyy HH:mm") – @first.EndTime.ToString("HH:mm")</MudText>
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Rounded.Place" Size="Size.Small" Style="@($"color:{_cPrimary};")" />
                                        <MudText Typo="Typo.body2">@(first.Location ?? "Neuvedené")</MudText>
                                    </MudStack>
                                </div>
                                @if (_upcomingTrainings.Count > 1)
                                {
                                    <MudDivider />
                                    <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">Ďalšie tréningy</MudText>
                                    @foreach (var t in _upcomingTrainings.Skip(1).Take(3))
                                    {
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudStack Spacing="0" Style="min-width:0;">
                                                <MudText Typo="Typo.body2" Style="font-weight:500;">@t.Title</MudText>
                                                <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">@(t.Location ?? "Neuvedené")</MudText>
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Style="font-weight:500;">@t.StartTime.ToString("dd.MM. HH:mm")</MudText>
                                        </MudStack>
                                    }
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Moja dochádzka</MudText>
                        @if (_stats is not null && _stats.Total > 0)
                        {
                            <MudStack Spacing="3">
                                <MudGrid Spacing="2">
                                    <MudItem xs="4">
                                        <MudPaper Elevation="0" Class="pa-2 text-center" Style="@($"background:{_cSuccess}14; border-radius:8px;")">
                                            <MudText Typo="Typo.h6" Style="@($"color:{_cSuccess}; font-weight:700;")">@_stats.Present</MudText>
                                            <MudText Typo="Typo.caption">Prítomný</MudText>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudPaper Elevation="0" Class="pa-2 text-center" Style="@($"background:{_cError}14; border-radius:8px;")">
                                            <MudText Typo="Typo.h6" Style="@($"color:{_cError}; font-weight:700;")">@_stats.Absent</MudText>
                                            <MudText Typo="Typo.caption">Neprítomný</MudText>
                                        </MudPaper>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudPaper Elevation="0" Class="pa-2 text-center" Style="@($"background:{_cWarning}14; border-radius:8px;")">
                                            <MudText Typo="Typo.h6" Style="@($"color:{_cWarning}; font-weight:700;")">@_stats.Excused</MudText>
                                            <MudText Typo="Typo.caption">Ospravedlnený</MudText>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                                <MudDivider />
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">Účasť</MudText>
                                        <MudText Typo="Typo.body1" Style="font-weight:600;">@_stats.Present z @_stats.Total tréningov</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.h5" Style="@($"color:{_cPrimary}; font-weight:700;")">@_attendancePercent%</MudText>
                                </MudStack>
                                <MudProgressLinear Color="Color.Success" Value="@_attendancePercent" Class="my-1" Rounded="true" Size="Size.Medium" />
                            </MudStack>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">Zatiaľ žiadne dáta.</MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <MudItem xs="12" lg="8">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Posledné záznamy dochádzky</MudText>
                        @if (!_recentAttendance.Any())
                        {
                            <MudText Typo="Typo.body2">Zatiaľ žiadne záznamy.</MudText>
                        }
                        else
                        {
                            <MudTable Items="@_recentAttendance" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                <HeaderContent>
                                    <MudTh>Dátum</MudTh>
                                    <MudTh>Tréning</MudTh>
                                    <MudTh>Stav</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Dátum">@context.Date.ToString("dd.MM.yyyy")</MudTd>
                                    <MudTd DataLabel="Tréning">@context.TrainingName</MudTd>
                                    <MudTd DataLabel="Stav">
                                        <MudChip T="string" Size="Size.Small" Class="@GetStatusChipClass(context.Status)">
                                            @GetStatusText(context.Status)
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">Najnovšie oznamy</MudText>
                        @if (!_announcements.Any())
                        {
                            <MudText Typo="Typo.body2">Zatiaľ žiadne oznamy tímu.</MudText>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var announcement in _announcements.Take(3))
                                {
                                    <MudPaper Elevation="0" Class="pa-3" Style="@($"background:{_cPrimary}0A; border-left:3px solid {_cPrimary}; border-radius:6px;")">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@announcement.Title</MudText>
                                        <MudText Typo="Typo.body2" Class="mt-1">@announcement.ContentPreview</MudText>
                                        <MudText Typo="Typo.caption" Style="@($"color:{_cTextSecondary};")">@announcement.PublishDate.ToString("dd.MM.yyyy HH:mm")</MudText>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _isLoading = true;
    private bool _isAthlete;
    private ChildDto? _profile;
    private List<TrainingEventDto> _upcomingTrainings = new();
    private List<AnnouncementListDto> _announcements = new();
    private List<UserAttendanceDto> _recentAttendance = new();
    private AttendanceStatsDto? _stats;
    private int _attendancePercent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAthlete = auth.User.IsInRole("Athlete");

            var profiles = await ChildrenApi.GetMyChildrenAsync();
            _profile = profiles.FirstOrDefault();

            var seasonStart = new DateTime(DateTime.Now.Year, DateTime.Now.Month >= 8 ? 8 : 1, 1);

            if (_profile?.TeamId is not null)
            {
                var trainings = await TrainingsApi.GetTrainingsAsync(_profile.TeamId, DateTime.Now, DateTime.Now.AddMonths(1));
                _upcomingTrainings = trainings.OrderBy(t => t.StartTime).ToList();
                _announcements = (await AnnouncementsApi.GetAnnouncementsAsync(_profile.TeamId, null))
                    .OrderByDescending(a => a.PublishDate).ToList();
            }

            try
            {
                _stats = await AttendanceApi.GetMemberStatsAsync(_profile?.Id ?? string.Empty, seasonStart, DateTime.Now);
                if (_stats is not null && _stats.Total > 0)
                    _attendancePercent = (int)Math.Round((_stats.Present + _stats.Excused) * 100.0 / _stats.Total);
            }
            catch { }

            try
            {
                _recentAttendance = (await AttendanceApi.GetMyAttendanceAsync(seasonStart, DateTime.Now))
                    .OrderByDescending(a => a.Date).Take(3).ToList();
            }
            catch { }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní prehľadu: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenAddExcuseDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<AddExcuseDialog>("Nová ospravedlnenka", options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
            await OnInitializedAsync();
    }

    private Color GetStatusColor(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => Color.Success,
        AttendanceStatus.Absent => Color.Error,
        AttendanceStatus.Excused => Color.Warning,
        _ => Color.Default
    };

    private string GetStatusChipClass(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "attendance-chip-present",
        AttendanceStatus.Absent => "attendance-chip-absent",
        AttendanceStatus.Excused => "attendance-chip-excused",
        _ => string.Empty
    };

    private string GetStatusText(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Present => "Prítomný",
        AttendanceStatus.Absent => "Neprítomný",
        AttendanceStatus.Excused => "Ospravedlnený",
        _ => "Neznámy"
    };

    private static readonly string _cPrimary = (string)AppTheme.SportClubTheme.PaletteLight.Primary;
    private static readonly string _cSuccess = (string)AppTheme.SportClubTheme.PaletteLight.Success;
    private static readonly string _cError = (string)AppTheme.SportClubTheme.PaletteLight.Error;
    private static readonly string _cWarning = (string)AppTheme.SportClubTheme.PaletteLight.Warning;
    private static readonly string _cTextSecondary = (string)AppTheme.SportClubTheme.PaletteLight.TextSecondary;
}
