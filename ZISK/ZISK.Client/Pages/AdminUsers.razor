@page "/admin/pouzivatelia"
@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Components
@using ZISK.Client.Display
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Users
@attribute [Authorize(Roles = "Admin")]

<PageTitle>@T("admin.users.pageTitle") - ZISK</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4">

<PageHeader Icon="@Icons.Material.Filled.People" Title="@T("admin.users.pageTitle")">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
            @T("dashboard.admin.addUser")
        </MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudTextField @bind-Value="SearchText"
                          Label="@T("admin.users.searchLabel")"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" md="5">
            <MudSelect T="string" @bind-Value="SelectedRole" Label="@T("admin.users.roleFilterLabel")" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@("Coach")">@T("role.coach")</MudSelectItem>
                <MudSelectItem Value="@("Parent")">@T("role.parent")</MudSelectItem>
                <MudSelectItem Value="@("Athlete")">@T("role.athlete")</MudSelectItem>
                <MudSelectItem Value="@("Child")">@T("role.child")</MudSelectItem>
                <MudSelectItem Value="@("Admin")">@T("role.admin")</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 8; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        }
    </MudStack>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudHidden Breakpoint="Breakpoint.MdAndDown">
        <MudTable Items="_filteredUsers" Hover="true" Striped="true" Elevation="2" Dense="true">
            <HeaderContent>
                <MudTh>@T("admin.users.table.firstName")</MudTh>
                <MudTh>@T("admin.users.table.lastName")</MudTh>
                <MudTh>@T("dashboard.latestUsers.role")</MudTh>
                <MudTh>@T("admin.users.table.phone")</MudTh>
                <MudTh>@T("dashboard.team")</MudTh>
                <MudTh Style="text-align:right">@T("attendance.excuses.actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FirstName</MudTd>
                <MudTd>@context.LastName</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@DomainLabels.RoleColor(context.Role)">@DomainLabels.Role(context.Role)</MudChip>
                </MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.PhoneNumber) ? "-" : context.PhoneNumber)</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.TeamName) ? T("admin.users.unassigned") : context.TeamName)</MudTd>
                <MudTd Style="text-align:right">
                    @if (context.Role == "Child")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       Title="@T("admin.users.upgradeToAthlete")"
                                       OnClick="() => ConfirmUpgradeToAthlete(context)" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="() => OpenEditDialog(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="() => ConfirmDeleteUser(context)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@T("admin.users.noUsers")</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.LgAndUp">
        @if (_filteredUsers.Count > 0)
        {
            <MudStack Spacing="2">
                @foreach (var user in _filteredUsers)
                {
                    <MudPaper @key="user.Id" Class="pa-3" Elevation="1" Style="@($"border-left: 3px solid {DomainLabels.RoleBorderColor(user.Role)};")">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex: 1; min-width: 0;">
                                <MudAvatar Size="Size.Small" Color="@DomainLabels.RoleColor(user.Role)" Style="flex-shrink: 0;">
                                    @GetUserInitials(user)
                                </MudAvatar>
                                <MudStack Spacing="0" Style="min-width: 0;">
                                    <MudText Typo="Typo.subtitle2" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@user.FirstName @user.LastName</MudText>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudChip T="string" Size="Size.Small" Color="@DomainLabels.RoleColor(user.Role)" Class="ma-0" Style="height: 18px; font-size: 11px;">@DomainLabels.Role(user.Role)</MudChip>
                                        @if (!string.IsNullOrWhiteSpace(user.TeamName))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@user.TeamName</MudText>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Style="flex-shrink: 0;">
                                @if (user.Role == "Child")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   Title="@T("admin.users.upgradeToAthlete")"
                                                   OnClick="() => ConfirmUpgradeToAthlete(user)" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="() => OpenEditDialog(user)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="() => ConfirmDeleteUser(user)" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
        else
        {
            <MudText>@T("admin.users.noUsers")</MudText>
        }
    </MudHidden>
}
</MudContainer>

<MudDialog @bind-Visible="_editDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@T("admin.users.editUser")</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_editModel" OnValidSubmit="SaveUser">
            <LocalizedDataAnnotationsValidator />
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">@T("admin.users.personalData")</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.FirstName"
                                  For="@(() => _editModel.FirstName)"
                                  Label="@T("admin.users.table.firstName")" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.LastName"
                                  For="@(() => _editModel.LastName)"
                                  Label="@T("admin.users.table.lastName")" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.Phone"
                                  For="@(() => _editModel.Phone)"
                                  Label="@T("admin.users.table.phone")" Variant="Variant.Outlined"
                                  Placeholder="+421 905 123 456" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.RodneCislo"
                                  For="@(() => _editModel.RodneCislo)"
                                  Label="@T("admin.users.birthNumber")" Variant="Variant.Outlined"
                                  Placeholder="991231/1234" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_editModel.DateOfBirth"
                                   Label="@T("dashboard.child.dateOfBirth")" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_editModel.Role"
                               For="@(() => _editModel.Role)"
                               Label="@T("dashboard.latestUsers.role")" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Admin")">@T("role.admin")</MudSelectItem>
                        <MudSelectItem Value="@("Coach")">@T("role.coach")</MudSelectItem>
                        <MudSelectItem Value="@("Parent")">@T("role.parent")</MudSelectItem>
                        <MudSelectItem Value="@("Athlete")">@T("role.athlete")</MudSelectItem>
                        <MudSelectItem Value="@("Child")">@T("role.child")</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editModel.Bydlisko"
                                  For="@(() => _editModel.Bydlisko)"
                                  Label="@T("admin.users.address")" Variant="Variant.Outlined" Lines="2"
                                  Placeholder="Hlavná 1, 010 01 Žilina" />
                </MudItem>

                @if (_editModel.Role == "Child")
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            @T("admin.users.childNeedsParents")
                        </MudAlert>
                        <MudTextField @bind-Value="ParentSearch" Label="@T("admin.users.searchParent")" Variant="Variant.Outlined"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
                        <MudSelect T="string"
                                   SelectedValues="_selectedParentIds"
                                   SelectedValuesChanged="OnSelectedParentsChanged"
                                   Label="@T("admin.users.linkedParents")"
                                   Variant="Variant.Outlined"
                                   MultiSelection="true"
                                   SelectAll="true"
                                   SelectAllText="@T("admin.users.selectAll")"
                                   MultiSelectionTextFunc="@(ids => string.Join(", ", ids.Select(id => _parents.FirstOrDefault(p => p.Id == id)?.FullName ?? id)))">
                            @foreach (var parent in _filteredParents)
                            {
                                <MudSelectItem @key="parent.Id" Value="@parent.Id">@parent.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    <LoadingButton ButtonType="ButtonType.Submit"
                                  Color="Color.Primary"
                                  Variant="Variant.Filled"
                                  Loading="_isSaving"
                                  FullWidth="true">
                        @T("admin.users.save")
                    </LoadingButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>
