@page "/admin/pouzivatelia"
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Components
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Users
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Správa používateľov</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
<MudBreadcrumbs Items="_breadcrumbs" Class="mb-2 px-0" />

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
        <MudText Typo="Typo.h4">Správa používateľov</MudText>
    </MudStack>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        Pridať používateľa
    </MudButton>
</MudStack>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudTextField @bind-Value="_searchText"
                          Label="Hľadať podľa mena alebo telefónu"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" md="5">
            <MudSelect T="string" @bind-Value="_selectedRole" Label="Filter roly" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem Value="@("Coach")">Tréner</MudSelectItem>
                <MudSelectItem Value="@("Parent")">Rodič</MudSelectItem>
                <MudSelectItem Value="@("Athlete")">Športovec</MudSelectItem>
                <MudSelectItem Value="@("Child")">Dieťa</MudSelectItem>
                <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_isLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 8; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" />
        }
    </MudStack>
}
else if (_error != null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else
{
    <MudHidden Breakpoint="Breakpoint.MdAndDown">
        <MudTable Items="FilteredUsers" Hover="true" Striped="true" Elevation="2" Dense="true">
            <HeaderContent>
                <MudTh>Meno</MudTh>
                <MudTh>Priezvisko</MudTh>
                <MudTh>Rola</MudTh>
                <MudTh>Telefón</MudTh>
                <MudTh>Tím</MudTh>
                <MudTh Style="text-align:right">Akcie</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FirstName</MudTd>
                <MudTd>@context.LastName</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(context.Role)">@GetRoleText(context.Role)</MudChip>
                </MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.PhoneNumber) ? "-" : context.PhoneNumber)</MudTd>
                <MudTd>@(string.IsNullOrWhiteSpace(context.TeamName) ? "Nepriradený" : context.TeamName)</MudTd>
                <MudTd Style="text-align:right">
                    @if (context.Role == "Child")
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       Title="Povýšiť na športovca"
                                       OnClick="() => ConfirmUpgradeToAthlete(context)" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="() => OpenEditDialog(context)" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="() => ConfirmDeleteUser(context)" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Žiadni používatelia</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.LgAndUp">
        @if (FilteredUsers.Any())
        {
            <MudStack Spacing="2">
                @foreach (var user in FilteredUsers)
                {
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Size="Size.Medium" Color="@GetRoleColor(user.Role)">
                                    @GetUserInitials(user)
                                </MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@user.FirstName @user.LastName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(string.IsNullOrWhiteSpace(user.TeamName) ? "Nepriradený" : user.TeamName)
                                    </MudText>
                                </MudStack>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(user.Role)">@GetRoleText(user.Role)</MudChip>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Telefón: @(string.IsNullOrWhiteSpace(user.PhoneNumber) ? "-" : user.PhoneNumber)
                                </MudText>
                            </MudStack>
                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                @if (user.Role == "Child")
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                                   Color="Color.Warning"
                                                   Size="Size.Small"
                                                   Title="Povýšiť na športovca"
                                                   OnClick="() => ConfirmUpgradeToAthlete(user)" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="() => OpenEditDialog(user)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="() => ConfirmDeleteUser(user)" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
        else
        {
            <MudText>Žiadni používatelia</MudText>
        }
    </MudHidden>
}
</MudContainer>

<MudDialog @bind-Visible="_editDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Upraviť používateľa</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_editModel" OnValidSubmit="SaveUser">
            <DataAnnotationsValidator />
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">Osobné údaje</MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.FirstName"
                                  For="@(() => _editModel.FirstName)"
                                  Label="Meno" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.LastName"
                                  For="@(() => _editModel.LastName)"
                                  Label="Priezvisko" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.Phone"
                                  For="@(() => _editModel.Phone)"
                                  Label="Telefón" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_editModel.RodneCislo"
                                  For="@(() => _editModel.RodneCislo)"
                                  Label="Rodné číslo" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="_editModel.DateOfBirth"
                                   Label="Dátum narodenia" Variant="Variant.Outlined" Clearable="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_editModel.Role"
                               For="@(() => _editModel.Role)"
                               Label="Rola" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Admin")">Admin</MudSelectItem>
                        <MudSelectItem Value="@("Coach")">Tréner</MudSelectItem>
                        <MudSelectItem Value="@("Parent")">Rodič</MudSelectItem>
                        <MudSelectItem Value="@("Athlete")">Športovec</MudSelectItem>
                        <MudSelectItem Value="@("Child")">Dieťa</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editModel.Bydlisko"
                                  For="@(() => _editModel.Bydlisko)"
                                  Label="Bydlisko" Variant="Variant.Outlined" Lines="2" />
                </MudItem>

                @if (_editModel.Role == "Child")
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            Pri role Dieťa prepojte profil s minimálne jedným rodičom.
                        </MudAlert>
                        <MudTextField @bind-Value="_parentSearch" Label="Hľadať rodiča" Variant="Variant.Outlined"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />
                        <MudSelect T="string"
                                   SelectedValues="_selectedParentIds"
                                   SelectedValuesChanged="OnSelectedParentsChanged"
                                   Label="Prepojení rodičia"
                                   Variant="Variant.Outlined"
                                   MultiSelection="true"
                                   SelectAll="true"
                                   SelectAllText="Vybrať všetkých">
                            @foreach (var parent in FilteredParents)
                            {
                                <MudSelectItem Value="@parent.Id">@parent.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="12">
                    <LoadingButton ButtonType="ButtonType.Submit"
                                  Color="Color.Primary"
                                  Variant="Variant.Filled"
                                  Loading="_isSaving"
                                  FullWidth="true">
                        Uložiť
                    </LoadingButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseEditDialog">Zrušiť</MudButton>
    </DialogActions>
</MudDialog>
