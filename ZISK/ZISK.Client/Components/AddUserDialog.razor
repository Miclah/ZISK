@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@using ZISK.Shared.DTOs.Users
@using MudBlazor

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" OnValidSubmit="Submit">
            <LocalizedDataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.FirstName"
                                  Label="@T("admin.users.table.firstName")"
                                  Placeholder="Ján"
                                  For="@(() => Model.FirstName)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.LastName"
                                  Label="@T("admin.users.table.lastName")"
                                  Placeholder="Novák"
                                  For="@(() => Model.LastName)"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.PhoneNumber"
                                  Label="@T("admin.users.table.phone")"
                                  Placeholder="+421 905 123 456"
                                  For="@(() => Model.PhoneNumber)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Email"
                                  Label="@T("profile.nav.email")"
                                  Placeholder="jan.novak@email.com"
                                  For="@(() => Model.Email)"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="@T("dashboard.child.dateOfBirth")"
                                   @bind-Date="Model.DateOfBirth"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string"
                               Label="@T("dashboard.latestUsers.role")"
                               @bind-Value="Model.Role"
                               For="@(() => Model.Role)"
                               Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Admin")">@T("role.admin")</MudSelectItem>
                        <MudSelectItem Value="@("Coach")">@T("role.coach")</MudSelectItem>
                        <MudSelectItem Value="@("Parent")">@T("role.parent")</MudSelectItem>
                        <MudSelectItem Value="@("Athlete")">@T("role.athlete")</MudSelectItem>
                        <MudSelectItem Value="@("Child")">@T("role.child")</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.RodneCislo"
                                  Label="@T("admin.users.birthNumber")"
                                  Placeholder="991231/1234"
                                  For="@(() => Model.RodneCislo)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Bydlisko"
                                  Label="@T("admin.users.address")"
                                  Placeholder="Hlavná 1, 010 01 Žilina"
                                  For="@(() => Model.Bydlisko)"
                                  Variant="Variant.Outlined" />
                </MudItem>

                @* Zatial pre testovanie vypnute *@
                @*
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="Model.GeneratePassword"
                                 Label="Vygenerovať náhodné heslo a poslať do SMS/Emailu"
                                 Color="Color.Primary" />
                </MudItem>
                *@

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Password"
                                  Label="@T("profile.nav.password")"
                                  For="@(() => Model.Password)"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showPassword = !_showPassword)" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @T("addUserDialog.passwordHelper")
                    </MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.ConfirmPassword"
                                  Label="@T("addUserDialog.confirmPassword")"
                                  For="@(() => Model.ConfirmPassword)"
                                  Variant="Variant.Outlined"
                                  InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showConfirm = !_showConfirm)" />
                </MudItem>

                <MudItem xs="12">
                    <MudProgressLinear Color="@PasswordStrengthColor"
                                       Value="@PasswordStrengthValue"
                                       Class="my-1"
                                       Rounded="true" />
                    <MudText Typo="Typo.caption" Color="@PasswordStrengthColor">@PasswordStrengthLabel</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudButton ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               FullWidth="true">@T("addUserDialog.createAccount")</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>

</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AddUserDialogModel Model { get; set; } = new();

    private bool _showPassword;
    private bool _showConfirm;

    private int PasswordStrengthValue
    {
        get
        {
            var pwd = Model.Password ?? string.Empty;
            int score = 0;
            if (pwd.Length >= 8) score++;
            if (pwd.Any(char.IsLower)) score++;
            if (pwd.Any(char.IsUpper)) score++;
            if (pwd.Any(char.IsDigit)) score++;
            return score * 25;
        }
    }

    private Color PasswordStrengthColor => PasswordStrengthValue switch
    {
        0 => Color.Default,
        <= 50 => Color.Error,
        <= 75 => Color.Warning,
        _ => Color.Success
    };

    private string PasswordStrengthLabel => PasswordStrengthValue switch
    {
        0 => T("addUserDialog.passwordStrength.empty"),
        <= 50 => T("addUserDialog.passwordStrength.weak"),
        <= 75 => T("addUserDialog.passwordStrength.medium"),
        _ => T("addUserDialog.passwordStrength.strong")
    };

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        MudDialog.Close(DialogResult.Ok(Model));
    }

    public class AddUserDialogModel
    {
        [Required(ErrorMessage = "Meno je povinné.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Meno musí mať 2 – 100 znakov.")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Priezvisko je povinné.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Priezvisko musí mať 2 – 100 znakov.")]
        public string LastName { get; set; } = string.Empty;

        [EmailAddress(ErrorMessage = "Neplatný formát emailu.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Telefón je povinný.")]
        public string PhoneNumber { get; set; } = string.Empty;

        public DateTime? DateOfBirth { get; set; }

        [Required(ErrorMessage = "Rola je povinná.")]
        public string Role { get; set; } = "Parent";

        [Required(ErrorMessage = "Rodné číslo je povinné.")]
        [RegularExpression(@"^\d{6}[/]?\d{3,4}$", ErrorMessage = "Formát: 991231/1234")]
        public string? RodneCislo { get; set; }

        [StringLength(300, ErrorMessage = "Bydlisko môže mať max 300 znakov.")]
        public string? Bydlisko { get; set; }

        // Zatial pre testovanie vypnute
        public bool GeneratePassword { get; set; }

        [Required(ErrorMessage = "Heslo je povinné.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Heslo musí mať aspoň 8 znakov.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Heslo musí obsahovať veľké aj malé písmeno a číslicu.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Potvrdenie hesla je povinné.")]
        [Compare(nameof(Password), ErrorMessage = "Heslá sa nezhodujú.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        public CreateUserRequest ToRequest(string resolvedEmail)
        {
            var dateOfBirth = DateOfBirth.HasValue ? DateOnly.FromDateTime(DateOfBirth.Value) : (DateOnly?)null;
            return new CreateUserRequest(
                FirstName,
                LastName,
                resolvedEmail,
                Password,
                Role,
                string.IsNullOrWhiteSpace(PhoneNumber) ? null : PhoneNumber,
                string.IsNullOrWhiteSpace(RodneCislo) ? null : RodneCislo,
                string.IsNullOrWhiteSpace(Bydlisko) ? null : Bydlisko,
                dateOfBirth,
                null);
        }
    }
}
