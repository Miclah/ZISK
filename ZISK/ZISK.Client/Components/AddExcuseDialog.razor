@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Excuses
@using ZISK.Shared.DTOs.Trainings
@inject IExcusesApi ExcusesApi
@inject IChildrenApi ChildrenApi
@inject ITrainingsApi TrainingsApi
@inject UserContextService UserContextService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_isChild)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Ako rola <strong>Dieťa</strong> máte len náhľad ospravedlneniek. Vytvorenie ospravedlnenky vykoná rodič alebo športovec.
            </MudAlert>
        }
        else if (!_children.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                @(_isAthlete
                    ? "Momentálne nemáte prepojený športovec profil. Kontaktujte administrátora alebo trénera, aby vás prepojil na tím."
                    : "Nemáte priradené žiadne dieťa. Kontaktujte administrátora alebo trénera.")
            </MudAlert>
        }
        else
        {
            <EditForm Model="@_model" OnValidSubmit="Submit">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudSelect T="Guid?"
                               @bind-Value="_model.SelectedPersonId"
                               @bind-Value:after="OnSelectedPersonChanged"
                               For="@(() => _model.SelectedPersonId)"
                               Label="Koho ospravedlňujem?"
                               Variant="Variant.Outlined">
                        @foreach (var child in _children.OrderBy(c => c.LastName).ThenBy(c => c.FirstName))
                        {
                            <MudSelectItem Value="@((Guid?)child.Id)">
                                @(child.IsOwnProfile ? $"Seba ({child.FirstName} {child.LastName})" : $"{child.FirstName} {child.LastName}")
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="Guid?"
                               @bind-Value="_model.SelectedTrainingId"
                               For="@(() => _model.SelectedTrainingId)"
                               Label="Na ktorý tréning?"
                               Variant="Variant.Outlined"
                               Disabled="@(!_model.SelectedPersonId.HasValue || !_availableTrainings.Any())">
                        @foreach (var training in _availableTrainings)
                        {
                            <MudSelectItem Value="@((Guid?)training.Id)">
                                @training.StartTime.ToString("dd.MM.yyyy HH:mm") | @training.Title @(string.IsNullOrWhiteSpace(training.Location) ? string.Empty : $"| {training.Location}")
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (_model.SelectedPersonId.HasValue && !_availableTrainings.Any())
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">Pre vybranú osobu nie sú dostupné žiadne nadchádzajúce tréningy.</MudAlert>
                    }

                    <MudTextField @bind-Value="_model.Reason"
                                  For="@(() => _model.Reason)"
                                  Label="Dôvod"
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Counter="200"
                                  MaxLength="200" />
                </MudStack>
            </EditForm>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Zrušiť</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="@(_isSubmitting || _isChild || !_children.Any())">
            @if (_isSubmitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Odoslať
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private ExcuseFormModel _model = new();
    private EditContext? _editContext;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool _isAthlete;
    private bool _isChild;
    private List<ChildDto> _children = new();
    private List<TrainingEventDto> _availableTrainings = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _isAthlete = authState.User.IsInRole("Athlete");
            _isChild = authState.User.IsInRole("Child");

            _children = await ChildrenApi.GetMyChildrenAsync();

            if (_children.Count == 1)
            {
                _model.SelectedPersonId = _children[0].Id;
                await OnSelectedPersonChanged();
            }
            else
            {
                var selected = UserContextService.SelectedOption;
                if (selected?.ChildId is not null && _children.Any(c => c.Id == selected.ChildId.Value))
                {
                    _model.SelectedPersonId = selected.ChildId.Value;
                    await OnSelectedPersonChanged();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSelectedPersonChanged()
    {
        _model.SelectedTrainingId = null;
        _availableTrainings = [];

        if (!_model.SelectedPersonId.HasValue)
            return;

        var selected = _children.FirstOrDefault(c => c.Id == _model.SelectedPersonId.Value);
        if (selected?.TeamId is null)
            return;

        try
        {
            _availableTrainings = (await TrainingsApi.GetTrainingsAsync(selected.TeamId, DateTime.Now, DateTime.Now.AddMonths(2)))
                .OrderBy(t => t.StartTime)
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba pri načítaní tréningov: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void SubmitForm()
    {
        _editContext ??= new EditContext(_model);
        _editContext.Validate();
    }


    private async Task Submit()
    {
        if (!_children.Any() || _isChild)
            return;

        _isSubmitting = true;

        try
        {
            var request = new CreateExcuseRequest(
                ChildId: _model.SelectedPersonId!.Value,
                TrainingEventId: _model.SelectedTrainingId,
                DateFrom: null,
                DateTo: null,
                Reason: string.IsNullOrWhiteSpace(_model.Reason) ? null : _model.Reason.Trim(),
                Note: null
            );

            await ExcusesApi.CreateExcuseAsync(request);
            Snackbar.Add("Ospravedlnenka odoslaná", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class ExcuseFormModel
    {
        [Required(ErrorMessage = "Vyberte osobu.")]
        public Guid? SelectedPersonId { get; set; }

        [Required(ErrorMessage = "Vyberte tréning.")]
        public Guid? SelectedTrainingId { get; set; }

        [StringLength(200, ErrorMessage = "Dôvod môže mať max 200 znakov.")]
        public string? Reason { get; set; }
    }
}
