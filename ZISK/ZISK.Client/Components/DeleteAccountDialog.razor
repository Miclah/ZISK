@using ZISK.Shared.DTOs.Users
@inject IMeApi MeApi
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Rounded.Warning" Color="Color.Error" />
            <MudText Typo="Typo.h6">Odstránenie účtu</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <MudStack Spacing="3" Style="min-width:340px;">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                    <strong>Pozor!</strong> Po potvrdení bude váš účet trvalo odstránený.
                    Túto akciu <strong>nie je možné vrátiť späť</strong>.
                </MudAlert>
                <MudTextField @bind-Value="_model.CurrentPassword"
                              For="@(() => _model.CurrentPassword)"
                              Label="Pre potvrdenie zadajte heslo"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined" />
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Zrušiť</MudButton>
        <LoadingButton Color="Color.Error" Variant="Variant.Filled"
                       OnClick="SubmitForm" Loading="_isSubmitting"
                       LoadingText="Odstraňujem...">
            Trvalo odstrániť účet
        </LoadingButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private FormModel _model = new();
    private EditContext? _editContext;
    private bool _isSubmitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitForm()
    {
        _editContext ??= new EditContext(_model);
        if (!_editContext.Validate())
            return;
        await Submit();
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        try
        {
            await MeApi.DeleteMyAccountAsync(new DeleteMyAccountRequest(_model.CurrentPassword));
            Snackbar.Add("Účet bol odstránený.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
            Navigation.NavigateTo("/logout", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class FormModel
    {
        [Required(ErrorMessage = "Heslo je povinné.")]
        public string CurrentPassword { get; set; } = string.Empty;
    }
}
