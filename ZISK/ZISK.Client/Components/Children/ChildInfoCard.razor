@inherits ZISK.Client.Components.LocalizedComponentBase
@using ZISK.Shared.DTOs.Children
@*
    "Základné informácie": the child's static details, with an edit affordance.
*@

<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.subtitle1">@T("childDetail.basicInfo")</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="OnEdit">
                    @T("childDetail.editChild")
                </MudButton>
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T("dashboard.child.dateOfBirth")</MudText>
                <MudText Typo="Typo.body2">@(Detail.DateOfBirth?.ToString("dd.MM.yyyy") ?? "-")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T("childDetail.age")</MudText>
                <MudText Typo="Typo.body2">@(Age?.ToString() ?? "-") @(Age.HasValue ? T("dashboard.childSummary.yearsOld") : "")</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T("admin.users.address")</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Detail.Bydlisko) ? "-" : Detail.Bydlisko)</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@T("dashboard.team")</MudText>
                <MudText Typo="Typo.body2">@(Detail.TeamName ?? T("dashboard.child.noTeam"))</MudText>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public ChildDetailDto Detail { get; set; } = default!;
    [Parameter] public int? Age { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
}
