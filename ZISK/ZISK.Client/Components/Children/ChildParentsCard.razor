@inherits ZISK.Client.Components.LocalizedComponentBase
@using ZISK.Shared.DTOs.Children
@*
    "Rodičia": the parents linked to this child. A link can be removed by the parent who owns it or by an
    admin; inviting a further parent is gated separately.
*@

<MudCard Elevation="1" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.subtitle1">@T("childDetail.parentsTitle")</MudText>
                @if (CanInvite)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PersonAdd"
                               OnClick="OnInvite">
                        @T("childDetail.inviteAnotherParent")
                    </MudButton>
                }
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (Parents.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Default">@T("childDetail.noParentsAssigned")</MudText>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var parent in Parents)
                {
                    <MudPaper @key="parent.UserId" Elevation="0" Outlined="true" Class="pa-3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Spacing="0">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.body1">@parent.FirstName @parent.LastName</MudText>
                                    @if (parent.IsPrimary)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">@T("childDetail.primary")</MudChip>
                                    }
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@parent.Email</MudText>
                            </MudStack>
                            @if (CanRemove(parent))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => OnRemove.InvokeAsync(parent))"
                                               Title="@T("childDetail.removeLinkTitle")" />
                            }
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ParentDto> Parents { get; set; } = [];

    [Parameter] public bool CanInvite { get; set; }

    /// <summary>The signed-in user, who may unlink themselves.</summary>
    [Parameter] public string? CallerId { get; set; }

    /// <summary>An admin may unlink any parent.</summary>
    [Parameter] public bool IsAdmin { get; set; }

    [Parameter] public EventCallback OnInvite { get; set; }
    [Parameter] public EventCallback<ParentDto> OnRemove { get; set; }

    private bool CanRemove(ParentDto parent) => IsAdmin || CallerId == parent.UserId;
}
