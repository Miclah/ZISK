@inherits ZISK.Client.Components.LocalizedComponentBase
@using ZISK.Client.Components
@using ZISK.Shared.DTOs.Users
@*
    "Prehľad": read-only identity fields, plus the parent-only invitation-code redemption box.
    Name, surname, birth number and date of birth are admin-managed, hence read-only here.
*@

<ProfileSectionHeading Icon="@Icons.Material.Rounded.Person" Title="@T("profile.basicData")" />

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6">
        <ReadOnlyField Label="@T("admin.users.table.firstName")" Value="@Profile.FirstName" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <ReadOnlyField Label="@T("admin.users.table.lastName")" Value="@Profile.LastName" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <ReadOnlyField Label="@T("dashboard.child.dateOfBirth")" Value="@BirthDateText" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <ReadOnlyField Label="@T("admin.users.birthNumber")" Value="@(Profile.RodneCislo ?? "—")" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <ReadOnlyField Label="@T("profile.systemRole")" Value="@RoleText" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <ReadOnlyField Label="@T("profile.accountCreated")" Value="@CreatedAtText" />
    </MudItem>
</MudGrid>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4" Dense="true">
    @T("profile.adminManagedNote")
</MudAlert>

@if (IsParent)
{
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1" Class="mb-2">@T("profile.connectToChild")</MudText>
    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-3">
        @T("profile.connectToChildHint")
    </MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudTextField Value="RedeemCode" ValueChanged="@((string v) => RedeemCodeChanged.InvokeAsync(v))"
                      Immediate="true"
                      Label="@T("profile.invitationCode")"
                      Variant="Variant.Outlined"
                      Placeholder="XXXX-XXXX"
                      Style="max-width:200px;"
                      Margin="Margin.Dense" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnRedeem"
                   Disabled="@(IsRedeeming || string.IsNullOrWhiteSpace(RedeemCode))">
            @if (IsRedeeming)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @T("profile.connect")
        </MudButton>
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public MyProfileDto Profile { get; set; } = default!;
    [Parameter] public bool IsParent { get; set; }

    [Parameter, EditorRequired] public string BirthDateText { get; set; } = "—";
    [Parameter, EditorRequired] public string RoleText { get; set; } = "";
    [Parameter, EditorRequired] public string CreatedAtText { get; set; } = "";

    [Parameter] public string RedeemCode { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> RedeemCodeChanged { get; set; }
    [Parameter] public bool IsRedeeming { get; set; }
    [Parameter] public EventCallback OnRedeem { get; set; }
}
