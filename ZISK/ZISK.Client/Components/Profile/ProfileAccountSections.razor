@inherits ZISK.Client.Components.LocalizedComponentBase
@using ZISK.Client.Components
@using ZISK.Shared.DTOs.Users
@*
    The three account-management sections — email, password and account deletion. Each is a short block of
    explanatory text plus one button that opens the corresponding dialog, so they live together rather than
    as three near-empty files.
*@

@if (Section == "email")
{
    <ProfileSectionHeading Icon="@Icons.Material.Rounded.Email" Title="@T("profile.emailAddress")" />
    <MudStack Spacing="3" Style="max-width:520px;">
        <ReadOnlyField Label="@T("profile.currentEmail")" Value="@Email" />
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
            @T("profile.emailChangeHint")
        </MudText>
        @if (IsDemo)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@T("profile.demoLocked")</MudAlert>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Rounded.Edit"
                   OnClick="OnChangeEmail"
                   Disabled="@IsDemo"
                   Style="align-self:flex-start;">
            @T("profile.changeEmail")
        </MudButton>
    </MudStack>
}
else if (Section == "password")
{
    <ProfileSectionHeading Icon="@Icons.Material.Rounded.Lock" Title="@T("profile.nav.password")" />
    <MudStack Spacing="3" Style="max-width:520px;">
        <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
            @T("profile.passwordChangeHint")
        </MudText>
        @if (IsDemo)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@T("profile.demoLocked")</MudAlert>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Rounded.Lock"
                   OnClick="OnChangePassword"
                   Disabled="@IsDemo"
                   Style="align-self:flex-start;">
            @T("profile.changePassword")
        </MudButton>
    </MudStack>
}
else if (Section == "personal")
{
    <ProfileSectionHeading Icon="@Icons.Material.Rounded.DataUsage" Title="@T("profile.personalDataAndAccount")" />
    <MudStack Spacing="3" Style="max-width:520px;">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            @T("profile.deleteAccountWarning")
            <strong>@T("profile.deleteAccountIrreversible")</strong>
        </MudAlert>
        @if (IsDemo)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@T("profile.demoLocked")</MudAlert>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Rounded.DeleteForever"
                   OnClick="OnDeleteAccount"
                   Disabled="@IsDemo"
                   Style="align-self:flex-start;">
            @T("profile.deleteAccount")
        </MudButton>
    </MudStack>
}

@code {
    /// <summary>One of "email", "password" or "personal".</summary>
    [Parameter, EditorRequired] public string Section { get; set; } = default!;

    [Parameter] public string Email { get; set; } = "";

    /// <summary>
    /// Greys these actions out for a demo visitor. The sections stay visible on purpose - the
    /// point of the demo is to show the app has them - but the buttons do nothing, because a
    /// visitor signed in through "Try as [Role]" has no password to change, no reachable inbox,
    /// and deleting the account would strand them (see MeController's IsDemoVisitor). The server
    /// refuses these calls regardless of what this flag says.
    /// </summary>
    [Parameter] public bool IsDemo { get; set; }

    [Parameter] public EventCallback OnChangeEmail { get; set; }
    [Parameter] public EventCallback OnChangePassword { get; set; }
    [Parameter] public EventCallback OnDeleteAccount { get; set; }
}
