@inherits LocalizedComponentBase
@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Invitations
@inject IInvitationsApi InvitationsApi
@inject IChildrenApi ChildrenApi
@inject UserContextService UserContextService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@T("dashboard.family.addChildByCode")</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @T("joinChildByCodeDialog.hint")
            </MudText>
            <MudTextField @bind-Value="_code"
                          Label="@T("inviteParentDialog.codeLabel")"
                          Variant="Variant.Outlined"
                          Placeholder="XXXX-XXXX"
                          Style="font-family: monospace; letter-spacing: 4px;" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T("admin.users.cancel")</MudButton>
        <LoadingButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                       Loading="_isSubmitting" LoadingText="@T("joinChildByCodeDialog.verifying")">
            @T("dashboard.family.addChild")
        </LoadingButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _code = string.Empty;
    private bool _isSubmitting;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_code))
        {
            Snackbar.Add(T("joinChildByCodeDialog.enterCode"), Severity.Warning);
            return;
        }

        _isSubmitting = true;
        try
        {
            await InvitationsApi.RedeemCodeAsync(new RedeemCodeRequest(_code.Trim().ToUpperInvariant()));
            Snackbar.Add(T("joinChildByCodeDialog.added"), Severity.Success);

            try
            {
                var children = await ChildrenApi.GetMyChildrenAsync();
                UserContextService.SetOptions(children.Select(c => new UserContextOption(
                    c.Id, $"{c.FirstName} {c.LastName}", c.Id, c.TeamId, c.IsOwnProfile)));
            }
            catch { }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}