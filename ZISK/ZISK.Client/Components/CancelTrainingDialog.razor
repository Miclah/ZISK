@inherits LocalizedComponentBase
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Trainings
@inject ITrainingsApi TrainingsApi
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">
                @T("cancelTrainingDialog.confirmPrefix") <strong>@TrainingTitle</strong>?
            </MudText>
            <MudTextField @bind-Value="_reason"
                          Label="@T("cancelTrainingDialog.reasonLabel")"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Required="true"
                          RequiredError="@T("cancelTrainingDialog.reasonRequired")"
                          MaxLength="500" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@T("childDetail.back")</MudButton>
        <LoadingButton Color="Color.Error" Variant="Variant.Filled"
                       Loading="_isSubmitting"
                       Disabled="string.IsNullOrWhiteSpace(_reason)"
                       OnClick="Confirm" LoadingText="@T("cancelTrainingDialog.cancelling")">
            @T("trainingDetailDialog.cancelTraining")
        </LoadingButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid TrainingId { get; set; }
    [Parameter] public string TrainingTitle { get; set; } = "";

    private string _reason = "";
    private bool _isSubmitting;

    private async Task Confirm()
    {
        if (string.IsNullOrWhiteSpace(_reason)) return;
        _isSubmitting = true;
        try
        {
            await TrainingsApi.CancelTrainingAsync(TrainingId, new CancelTrainingRequest(_reason));
            Snackbar.Add(T("cancelTrainingDialog.cancelled"), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
