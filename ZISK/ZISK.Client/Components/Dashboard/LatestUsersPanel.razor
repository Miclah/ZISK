@using ZISK.Client.Display
@using ZISK.Shared.DTOs.Users
@*
    "Posledná aktivita v systéme": most recently registered users.
    Follows the app's adaptive-view convention — a table on desktop, stacked cards on small screens.
*@

<MudPaper Class="pa-5" Elevation="2" Style="height: 100%;">
    <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTable Items="Users" Dense="true" Hover="true" Elevation="0">
            <HeaderContent>
                <MudTh>Používateľ</MudTh>
                <MudTh>Rola</MudTh>
                <MudTh>Dátum registrácie</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FirstName @context.LastName</MudTd>
                <MudTd>@DomainLabels.Role(context.Role)</MudTd>
                <MudTd>@context.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        @if (Users.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
        }
        else
        {
            <MudStack Spacing="2">
                @foreach (var user in Users)
                {
                    <MudPaper @key="user.Id" Class="pa-3" Elevation="1">
                        <MudText Typo="Typo.subtitle2">@user.FirstName @user.LastName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@DomainLabels.Role(user.Role)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</MudText>
                    </MudPaper>
                }
            </MudStack>
        }
    </MudHidden>
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<UserListDto> Users { get; set; } = [];

    [Parameter] public string Title { get; set; } = "Posledná aktivita v systéme";

    [Parameter] public string EmptyText { get; set; } = "Zatiaľ nie je dostupná žiadna aktivita.";
}
