@using ZISK.Client.Layout
@using ZISK.Shared.DTOs.Trainings
@*
    The coach's next session: time, place, a countdown chip, and a three-up breakdown of who is expected,
    who is excused and the team size.
*@

<MudPaper Class="card-standard pa-4" Elevation="0">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Najbližší tréning</MudText>
        @if (Training is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Rounded.Schedule">
                @RelativeTime
            </MudChip>
        }
    </MudStack>

    @if (Training is null)
    {
        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-6" Spacing="1">
            <MudIcon Icon="@Icons.Material.Rounded.EventAvailable" Size="Size.Large" Color="Color.Default" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nemáte naplánovaný žiadny nadchádzajúci tréning.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2"
                       StartIcon="@Icons.Material.Rounded.AddCircle"
                       OnClick="OnSchedule">
                Naplánovať tréning
            </MudButton>
        </MudStack>
    }
    else
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6" Style="font-weight:600;">@Training.Title</MudText>
            <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Rounded.CalendarMonth" Size="Size.Small" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">
                        @Training.StartTime.ToString("dd.MM.yyyy HH:mm") – @Training.EndTime.ToString("HH:mm")
                    </MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Rounded.Place" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2">@(Training.Location ?? "Neuvedené")</MudText>
                </MudStack>
            </MudStack>

            <MudGrid Spacing="2" Class="mt-1">
                <MudItem xs="4">
                    <CountTile Value="@ExpectedCount" Label="Očakávaní" Hex="@ThemeColors.Success" />
                </MudItem>
                <MudItem xs="4">
                    <CountTile Value="@ExcusedCount" Label="Ospravedlnení" Hex="@ThemeColors.Warning" />
                </MudItem>
                <MudItem xs="4">
                    <CountTile Value="@MemberCount" Label="Tím" Hex="@ThemeColors.Tertiary" />
                </MudItem>
            </MudGrid>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-2"
                       EndIcon="@Icons.Material.Rounded.ChevronRight"
                       OnClick="OnOpen">
                Otvoriť tréning
            </MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter] public TrainingEventDto? Training { get; set; }
    [Parameter] public string? RelativeTime { get; set; }
    [Parameter] public int ExpectedCount { get; set; }
    [Parameter] public int ExcusedCount { get; set; }
    [Parameter] public int MemberCount { get; set; }

    [Parameter] public EventCallback OnSchedule { get; set; }
    [Parameter] public EventCallback OnOpen { get; set; }
}
