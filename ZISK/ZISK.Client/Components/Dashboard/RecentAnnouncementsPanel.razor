@using ZISK.Client.Display
@using ZISK.Shared.DTOs.Announcements
@*
    "Najnovšie oznamy" card: recent announcements with a priority-coloured left border and chip.
*@

<MudPaper Class="pa-5" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Secondary" />
            <MudText Typo="Typo.h6">@Title</MudText>
        </MudStack>
        @if (OnShowAll.HasDelegate)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="OnShowAll">
                @ShowAllText
            </MudButton>
        }
    </MudStack>

    @if (Announcements.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var a in Announcements)
            {
                <MudPaper @key="a.Id" Class="pa-3" Elevation="0" Outlined="true"
                          Style="@($"border-left: 4px solid {DomainLabels.PriorityBorderColor(a.Priority)};")">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0" Style="min-width: 0; flex: 1;">
                            <MudText Typo="Typo.subtitle2"><strong>@a.Title</strong></MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @a.AuthorName · @a.PublishDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                @if (a.TargetTeamName is not null)
                                {
                                    <span> · @a.TargetTeamName</span>
                                }
                            </MudText>
                        </MudStack>
                        <MudChip T="string" Size="Size.Small" Color="@DomainLabels.PriorityColor(a.Priority)">
                            @DomainLabels.PriorityText(a.Priority)
                        </MudChip>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AnnouncementListDto> Announcements { get; set; } = [];

    [Parameter] public string Title { get; set; } = "Najnovšie oznamy";

    [Parameter] public string EmptyText { get; set; } = "Zatiaľ neboli zverejnené žiadne oznamy.";

    [Parameter] public string ShowAllText { get; set; } = "Všetky oznamy";

    [Parameter] public EventCallback OnShowAll { get; set; }
}
