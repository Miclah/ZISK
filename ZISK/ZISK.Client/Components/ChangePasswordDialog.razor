@inherits LocalizedComponentBase
@using ZISK.Shared.DTOs.Users
@inject IMeApi MeApi
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Rounded.Lock" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@T("profile.changePasswordDialogTitle")</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <LocalizedDataAnnotationsValidator />
            <MudStack Spacing="3" Style="min-width:320px;">
                <MudTextField @bind-Value="_model.CurrentPassword"
                              For="@(() => _model.CurrentPassword)"
                              Label="@T("changePasswordDialog.currentPassword")"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_model.NewPassword"
                              For="@(() => _model.NewPassword)"
                              Label="@T("changePasswordDialog.newPassword")"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              HelperText="@T("changePasswordDialog.newPasswordHelper")" />
                <MudTextField @bind-Value="_confirmPassword"
                              Label="@T("changePasswordDialog.confirmNewPassword")"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Error="@(_confirmShown && !PasswordsMatch)"
                              ErrorText="@T("changePasswordDialog.passwordsDontMatch")" />
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">@T("admin.users.cancel")</MudButton>
        <LoadingButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="SubmitForm" Loading="_isSubmitting"
                       LoadingText="@T("common.saving")">
            @T("profile.changePassword")
        </LoadingButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private FormModel _model = new();
    private EditContext? _editContext;
    private string _confirmPassword = string.Empty;
    private bool _confirmShown;
    private bool _isSubmitting;

    private bool PasswordsMatch => string.Equals(_model.NewPassword, _confirmPassword, StringComparison.Ordinal);

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitForm()
    {
        _confirmShown = true;
        _editContext ??= new EditContext(_model);
        if (!_editContext.Validate() || !PasswordsMatch)
            return;

        await Submit();
    }

    private async Task Submit()
    {
        _isSubmitting = true;
        try
        {
            await MeApi.ChangeMyPasswordAsync(new ChangeMyPasswordRequest(_model.CurrentPassword, _model.NewPassword));
            Snackbar.Add(T("changePasswordDialog.changed"), Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{T("attendance.errorGeneric")} {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class FormModel
    {
        [Required(ErrorMessage = "Súčasné heslo je povinné.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Nové heslo je povinné.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Heslo musí mať aspoň 8 znakov.")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).+$",
            ErrorMessage = "Heslo musí obsahovať aspoň jedno malé písmeno, veľké písmeno a číslicu.")]
        public string NewPassword { get; set; } = string.Empty;
    }
}
