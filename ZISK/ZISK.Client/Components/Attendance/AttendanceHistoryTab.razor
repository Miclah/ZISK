@using System.Globalization
@using ZISK.Client.Display
@using ZISK.Shared.DTOs.Attendance
@using ZISK.Shared.Enums
@*
    "História" tab: date-range filter over past attendance records.
    Adaptive view — table on desktop, cards on mobile.
*@

<MudPaper Class="card-standard pa-4 mb-4" Elevation="0">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudDatePicker Date="DateFrom" DateChanged="DateFromChanged" Label="Od dátumu" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Date="DateTo" DateChanged="DateToChanged" Label="Do dátumu" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnFilter">
                Filtrovať
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (IsLoading)
{
    <MudStack Spacing="2">
        @for (int i = 0; i < 4; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="64px" />
        }
    </MudStack>
}
else if (Records.Count == 0)
{
    <MudPaper Class="card-standard empty-state" Elevation="0">
        <MudIcon Icon="@Icons.Material.Rounded.EventBusy" Class="empty-state__icon" />
        <div class="empty-state__title">Žiadne záznamy o dochádzke</div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Vo vybranom období nie sú evidované žiadne tréningy.</MudText>
    </MudPaper>
}
else
{
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudPaper Class="card-standard pa-2" Elevation="0">
            <MudTable Items="@Records" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Dátum</MudTh>
                    <MudTh>Dieťa</MudTh>
                    <MudTh>Tréning</MudTh>
                    <MudTh>Stav</MudTh>
                    <MudTh>Poznámka trénera</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.Date.ToString("dd.MM.yyyy")</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @context.Date.ToString("dddd", SlovakCulture)
                        </MudText>
                    </MudTd>
                    <MudTd>@context.ChildName</MudTd>
                    <MudTd>@context.TrainingName</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Class="@DomainLabels.AttendanceStatusChipClass(context.Status)">
                            @DomainLabels.AttendanceStatusText(context.Status)
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.Note))
                        {
                            <MudText Typo="Typo.body2">@context.Note</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudStack Spacing="2">
            @foreach (var item in Records)
            {
                <MudPaper @key="@($"{item.ChildId}-{item.Date:s}-{item.TrainingName}")" Class="card-standard pa-3" Elevation="0">
                    <MudStack Spacing="1">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">@item.TrainingName</MudText>
                            <MudChip T="string" Size="Size.Small" Class="@DomainLabels.AttendanceStatusChipClass(item.Status)">
                                @DomainLabels.AttendanceStatusText(item.Status)
                            </MudChip>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @item.ChildName · @item.Date.ToString("dd.MM.yyyy") · @item.Date.ToString("dddd", SlovakCulture)
                        </MudText>
                        <MudText Typo="Typo.body2">
                            @(string.IsNullOrWhiteSpace(item.Note) ? "Bez poznámky trénera" : item.Note)
                        </MudText>
                        @if (item.Status == AttendanceStatus.Absent && CanCreateExcuse)
                        {
                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           OnClick="OnCreateExcuse">
                                    Podať ospravedlnenku
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    </MudHidden>
}

@code {
    // The app runs under sk-SK globally; this is here so the weekday name is explicit at the call site.
    private static readonly CultureInfo SlovakCulture = new("sk-SK");

    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool CanCreateExcuse { get; set; }

    [Parameter, EditorRequired] public IReadOnlyList<UserAttendanceDto> Records { get; set; } = [];

    [Parameter] public DateTime? DateFrom { get; set; }
    [Parameter] public EventCallback<DateTime?> DateFromChanged { get; set; }

    [Parameter] public DateTime? DateTo { get; set; }
    [Parameter] public EventCallback<DateTime?> DateToChanged { get; set; }

    [Parameter] public EventCallback OnFilter { get; set; }
    [Parameter] public EventCallback OnCreateExcuse { get; set; }
}
