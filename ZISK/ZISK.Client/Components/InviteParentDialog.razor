@using System.ComponentModel.DataAnnotations
@using ZISK.Client.Services
@using ZISK.Shared.DTOs.Invitations
@inject IInvitationsApi InvitationsApi
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Pozvať ďalšieho rodiča</MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="E-mailom" Icon="@Icons.Material.Filled.Email">
                <MudStack Spacing="3" Class="pt-3">
                    <EditForm Model="@_emailModel" OnValidSubmit="SendEmail">
                        <DataAnnotationsValidator />
                        <MudTextField @bind-Value="_emailModel.TargetEmail"
                                      For="@(() => _emailModel.TargetEmail)"
                                      Label="E-mail rodiča"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Placeholder="rodic@email.sk" />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit"
                                   Disabled="@_isSendingEmail" Class="mt-2">
                            @if (_isSendingEmail)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Odoslať pozvánku
                        </MudButton>
                    </EditForm>
                    @if (_emailSent)
                    {
                        <MudAlert Severity="Severity.Success">Pozvánka bola odoslaná na @_emailModel.TargetEmail.</MudAlert>
                    }
                </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="Kódom" Icon="@Icons.Material.Filled.Numbers">
                <MudStack Spacing="3" Class="pt-3">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Vygenerujte jednorazový kód a zdieľajte ho priamo druhému rodičovi. Kód je platný 24 hodín.
                    </MudText>
                    <MudButton Color="Color.Secondary" Variant="Variant.Filled" OnClick="GenerateCode" Disabled="@_isGeneratingCode">
                        @if (_isGeneratingCode)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        Vygenerovať kód
                    </MudButton>
                    @if (_generatedCode is not null)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudTextField Value="@_generatedCode.Code"
                                          Label="Kód"
                                          Variant="Variant.Outlined"
                                          ReadOnly="true"
                                          Style="font-family: monospace; font-size: 1.2rem; letter-spacing: 4px; max-width: 180px;" />
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" OnClick="CopyCode" Title="Skopírovať" />
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Platný do: @_generatedCode.ExpiresAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </MudText>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Zatvoriť</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string ChildId { get; set; } = string.Empty;

    private EmailInviteModel _emailModel = new();
    private bool _isSendingEmail;
    private bool _emailSent;

    private bool _isGeneratingCode;
    private InvitationCodeResponse? _generatedCode;

    private async Task SendEmail()
    {
        _isSendingEmail = true;
        _emailSent = false;
        try
        {
            await InvitationsApi.SendEmailInvitationAsync(ChildId, new SendEmailInvitationRequest(_emailModel.TargetEmail));
            _emailSent = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isSendingEmail = false;
        }
    }

    private async Task GenerateCode()
    {
        _isGeneratingCode = true;
        try
        {
            _generatedCode = await InvitationsApi.GenerateCodeAsync(ChildId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Chyba: {ApiErrorFormatter.ToUserMessage(ex)}", Severity.Error);
        }
        finally
        {
            _isGeneratingCode = false;
        }
    }

    private async Task CopyCode()
    {
        if (_generatedCode is not null)
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _generatedCode.Code);
            Snackbar.Add("Kód skopírovaný", Severity.Info);
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    public class EmailInviteModel
    {
        [Required(ErrorMessage = "Email je povinný.")]
        [EmailAddress(ErrorMessage = "Neplatný formát emailu.")]
        public string TargetEmail { get; set; } = string.Empty;
    }
}
