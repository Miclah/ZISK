@*
    Standard page heading: leading icon, title, optional subtitle, and a right-aligned action area.

    Every top-level page repeated this MudStack/MudIcon/MudText/MudSpacer block by hand, which is why the
    icon sizing and spacing had drifted slightly between them. Pages now supply only what differs.
*@

<MudStack Row="true" AlignItems="AlignItems.Center" Class="@($"mb-4 {Class}")" Spacing="2">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="@IconColor" />

    @if (string.IsNullOrWhiteSpace(Subtitle))
    {
        <MudText Typo="Typo.h4" HtmlTag="h1">@Title</MudText>
    }
    else
    {
        <MudStack Spacing="0" Style="min-width:0;">
            <MudText Typo="Typo.h4" HtmlTag="h1" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@Title</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Subtitle</MudText>
        </MudStack>
    }

    @Adornment

    <MudSpacer />

    @Actions
</MudStack>

@code {
    /// <summary>Leading icon, e.g. <c>Icons.Material.Filled.Dashboard</c>.</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = default!;

    [Parameter, EditorRequired] public string Title { get; set; } = default!;

    /// <summary>Optional caption rendered under the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public Color IconColor { get; set; } = Color.Primary;

    /// <summary>Rendered immediately after the title, before the spacer — e.g. a count chip.</summary>
    [Parameter] public RenderFragment? Adornment { get; set; }

    /// <summary>Right-aligned actions, typically buttons.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string? Class { get; set; }
}
