@inherits ZISK.Client.Components.LocalizedComponentBase
@*
    Period toggle for the stats page (7 / 30 / 90 days, 1 year).
*@

<MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Secondary" />
        <MudText Typo="Typo.body2">@T("admin.stats.period.label")</MudText>
        <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
            @foreach (var days in Periods)
            {
                var localDays = days;
                <MudButton Variant="@(SelectedDays == localDays ? Variant.Filled : Variant.Outlined)"
                           OnClick="@(() => SelectedDaysChanged.InvokeAsync(localDays))">
                    @Label(localDays)
                </MudButton>
            }
        </MudButtonGroup>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public int[] Periods { get; set; } = [7, 30, 90, 365];

    [Parameter] public int SelectedDays { get; set; }
    [Parameter] public EventCallback<int> SelectedDaysChanged { get; set; }

    private string Label(int days) => days switch
    {
        7 => T("admin.stats.period.7"),
        30 => T("admin.stats.period.30"),
        90 => T("admin.stats.period.90"),
        365 => T("admin.stats.period.365"),
        _ => string.Format(T("admin.stats.period.nDays"), days)
    };
}
