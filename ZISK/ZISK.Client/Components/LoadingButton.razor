@*
    Wrapper around MudButton that shows a spinner and disables the button while an async operation runs.
    Usage:
        <LoadingButton Loading="_saving" OnClick="SaveAsync" Color="Color.Primary" Variant="Variant.Filled">
            Uložiť
        </LoadingButton>
*@
@inherits LocalizedComponentBase
<MudButton Disabled="@(Loading || Disabled)"
           Variant="@Variant"
           Color="@Color"
           Size="@Size"
           OnClick="OnClick"
           ButtonType="@ButtonType"
           StartIcon="@(Loading ? null : StartIcon)"
           EndIcon="@(Loading ? null : EndIcon)"
           FullWidth="@FullWidth"
           Class="@Class"
           Style="@Style">
    @if (Loading)
    {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        @(string.IsNullOrEmpty(LoadingText) ? T("common.saving") : LoadingText)
    }
    else
    {
        @ChildContent
    }
</MudButton>

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public ButtonType ButtonType { get; set; } = ButtonType.Button;
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public string? EndIcon { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public string? LoadingText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
